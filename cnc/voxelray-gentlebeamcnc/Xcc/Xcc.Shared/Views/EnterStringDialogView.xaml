<ContentControl 
    x:Class="Xcc.Shared.Views.EnterStringDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    prism:ViewModelLocator.AutoWireViewModel="True" 
                
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    mc:Ignorable="d" 
    d:Width="480"
    d:DataContext="{d:DesignInstance {x:Type viewModels:EnterStringDialogViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/TabControlMainIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/TabControlMainStyle.xaml" />
                
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="560"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderColor1}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldLargeMarginGridLength}"/>
                <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Close button-->
            <Button
                Grid.ColumnSpan="2"
                VerticalAlignment="Center" 
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource ButtonCloseStyle}"/>

            <!--Header-->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Orientation="Horizontal">
                <ContentControl
                    FontWeight="SemiBold"
                    FontSize="{StaticResource HugeFontSize}" 
                    Style="{StaticResource ContentTextWithShadowStyle}"
                    Content="Please, enter "/>

                <ContentControl
                    FontWeight="SemiBold"
                    FontSize="{StaticResource HugeFontSize}" 
                    Style="{StaticResource ContentTextWithShadowStyle}"
                    Content="{Binding Title, FallbackValue=Value}"/>
            </StackPanel>

            <TextBlock 
                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource TextBlockLegendStylePale}"
                Margin="8"
                Text="{Binding Message}"
                TextWrapping="Wrap"/>

            <TextBlock 
                Grid.Row="3" Grid.Column="0"
                Style="{StaticResource TextBlockLegendStyle}"
                Margin="8,0,8,0">

                <Run Text="{Binding Title, FallbackValue=Value}"/><Run Text=":"/>
            </TextBlock>
            
            <!--Value field-->
            <controls:XccTextBox 
                Grid.Row="3"  Grid.Column="1"
                Margin="0,0,8,0"
                
                Text="{Binding Value}"/>

            <TextBlock 
                Grid.Row="4" Grid.ColumnSpan="2"
                Text="{Binding ErrorMessage}" 
                Foreground="Crimson" 
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                TextAlignment="Center" 
                Margin="8" 
                FontSize="15"/>
            
            <!--Buttons-->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <!--'OK' button-->
                <Button
                    Command="{Binding AcceptCommand}"
                    Width="{StaticResource ButtonWidth}"
                    Height="48"
                    IsDefault="True">

                    <Label Content="ОК" Style="{StaticResource ButtonLabelStyle}" FontSize="{StaticResource LargeFontSize}" Padding="0" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</ContentControl>