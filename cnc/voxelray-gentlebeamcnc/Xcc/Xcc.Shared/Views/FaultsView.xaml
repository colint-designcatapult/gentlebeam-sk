<ContentControl 
    x:Class="Xcc.Shared.Views.FaultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application" 
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"

    FontSize="{StaticResource BaseFontSize}"
    
    mc:Ignorable="d" 
    d:Width="720"
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    d:DataContext="{d:DesignInstance {x:Type viewModels:FaultsViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/TabControlMainIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="1000"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderColor1}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <!--Header-->
            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl Content="{StaticResource DialogErrorIcon}"/>

                <!--Header-->
                <ContentControl 
                    Grid.Column="2" 
                    FontWeight="SemiBold"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource ContentTextWithShadowStyle}" 
                    Content="System Faults"/>
            </Grid>
        
            <!--Fault List-->
            <ListView 
                Grid.Row="2"
                x:Name="FaultListView"
                Style="{StaticResource TableListView}"
                ItemsSource="{Binding Faults}"
                Tag="{StaticResource SystemFaultListHeaderTemplate}"
                ItemTemplate="{StaticResource SystemFaultListItemTemplate}"/>

            <controls:XccTextBox 
                Grid.Row="4"
                Height="Auto"
                VerticalContentAlignment="Top"
                HorizontalScrollBarVisibility="Visible"
                IsReadOnly="True"
                FontFamily="Consolas"
                
                Text="{Binding SelectedItem, ElementName=FaultListView}"
                Visibility="{Binding SelectedItem, ElementName=FaultListView, Converter={convx:ObjectToVisibilityConverter}}">
            </controls:XccTextBox>
            
            <!--Buttons-->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <!--'Clear Errors' button-->
                <Button 
                    x:Name="ButtonClearErrors"
                    Command="{Binding ClearErrorsCommand}"
                    Height="{StaticResource ButtonHeight}">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Path 
                                Data="{StaticResource RefreshIcon3}" 
                                Style="{StaticResource XRayButtonsIconStyle}"
                                Height="24" Width="24"/>
                            <Path 
                                Data="{StaticResource CancelIconPath}"
                                Style="{StaticResource XRayButtonsIconStyle}"
                                Height="8"
                                Stroke="Red"
                                StrokeEndLineCap="Square"
                                StrokeStartLineCap="Square"/>
                        </Grid>
                        <TextBlock Text="Clear Errors" Style="{StaticResource TextBlockButtonStyle}"/>
                    </StackPanel>
                </Button>
                
                <!--'Close' button-->
                <Button 
                    Command="{Binding CloseDialogCommand}"
                    Width="{Binding ActualWidth, ElementName=ButtonClearErrors}"
                    Height="{StaticResource ButtonHeight}"
                    Margin="{StaticResource BlockContentMarginLeft}">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path 
                            Data="{StaticResource ExitIcon}" 
                            Style="{StaticResource XRayButtonsIconStyle}"
                            Height="26" Width="26"/>

                        <TextBlock Text="Close" Style="{StaticResource TextBlockButtonStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>    
</ContentControl>