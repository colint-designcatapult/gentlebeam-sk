<ContentControl 
    x:Class="Xcc.Shared.Views.CreateFilterDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    prism:ViewModelLocator.AutoWireViewModel="True" 
                
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels"
    
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    FontSize="{StaticResource BaseFontSize}"

    mc:Ignorable="d" 
    d:Width="400"
    d:DataContext="{d:DesignInstance {x:Type viewModels:CreateFilterDialogViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockLegendStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Border/BorderBlockStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/ComboBox/ComboBoxDefaultStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonDefaultStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonCloseStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <system:String x:Key="Header">Create filter</system:String>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderBrush}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="{StaticResource BlockContentMarginGridLength}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}"/>
                <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Close button-->
            <Button
                Grid.ColumnSpan="4"
                VerticalAlignment="Center" 
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource ButtonCloseStyle}"/>

            <!--Header-->
            <ContentControl
                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                FontSize="{StaticResource HugeFontSize}" 
                Style="{StaticResource ContentTextWithShadowStyle}" 
                Content="{StaticResource Header}"/>

            <TextBlock 
                Grid.Row="2" Grid.Column="0"
                Style="{StaticResource TextBlockLegendStyle}"
                Text="Field:">
            </TextBlock>
            
            <!--Value field-->
            <ComboBox
                Grid.Row="4" Grid.Column="0"
                ItemsSource="{Binding Fields}"
                DisplayMemberPath="Item2"
                SelectedItem="{Binding SelectedField}"/>

            <TextBlock 
                Grid.Row="2" Grid.Column="2"
                Style="{StaticResource TextBlockLegendStyle}"
                Text="Value:">
            </TextBlock>

            <ComboBox
                Grid.Row="4" Grid.Column="2"
                IsEnabled="{Binding SelectedField, Converter={convx:ObjectIsNotNullConverter}}"
                ItemsSource="{Binding SelectedField.Item1, Converter={convx:EnumToItemsSourceConverter SkipCount=1}}"
                SelectedItem="{Binding SelectedValue}"/>

            <!--Buttons-->
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <!--'OK' button-->
                <Button
                    Command="{Binding CreateCommand}"
                    Width="{StaticResource ButtonWidth}"
                    Height="48"
                    IsDefault="True">

                    <TextBlock Style="{StaticResource TextBlockButtonStyle}" Text="Create"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</ContentControl>