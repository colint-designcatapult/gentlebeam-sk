<ContentControl 
    x:Class="Xcc.Shared.Views.TelemetryDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:uc="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels" 
    
    xmlns:prism="http://prismlibrary.com/"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    mc:Ignorable="d"
    d:DesignWidth="480" d:DesignHeight="640" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:TelemetryDialogViewModel}, IsDesignTimeCreatable=True}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                
                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="860"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderBrush="{StaticResource BlockBorderColor1}" BorderThickness="1" Style="{StaticResource BorderBlockStyle}" Background="{StaticResource BlockBackgroundColor}">
        <DockPanel Margin="10">
            <Button 
                DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Command="{Binding CloseDialogCommand}"
                Style="{StaticResource ButtonCloseStyle}"/>

            <Grid Margin="{StaticResource BlockContentMargin}">
                <controls:XccTextBox
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    FontFamily="Consolas"
                    FontSize="{StaticResource BaseFontSize}"
                    Text="{Binding SystemTelemetry, Mode=OneWay}"/>
            </Grid>
        </DockPanel>
    </Border>
</ContentControl>
