<ContentControl 
    x:Class="Xcc.Shared.Views.DialogBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
             
    UseLayoutRounding="True"
    IsTabStop="False"
    FontSize="{StaticResource BaseFontSize}"
    
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:DialogBoxViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml" />
                

                <ResourceDictionary>
                    <system:Double x:Key="ButtonHorizontalMarginValue2">10</system:Double>
                    <system:Double x:Key="ButtonTopMarginValue">40</system:Double>

                    <Thickness 
                        x:Key="ButtonMargin" 
                        Left="{StaticResource ButtonHorizontalMarginValue2}" Right="{StaticResource ButtonHorizontalMarginValue2}" 
                        Top="{StaticResource ButtonTopMarginValue}"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Width="640"
        Background="{StaticResource BlockBackgroundColor}"
        BorderBrush="{StaticResource AppBorderActiveColor}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource BlockContentSmallMarginLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid KeyboardNavigation.TabNavigation="None">
                    <ContentControl
                        Content="{Binding DialogIcon}"
                        Visibility="{Binding DialogIcon, Converter={convx:ObjectToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </Grid>

                <ContentControl
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    FontSize="{StaticResource HugeFontSize}" 
                    Style="{StaticResource ContentTextWithShadowStyle}" 
                    Content="{Binding DialogTitle}"/>
            </Grid>

            <ContentControl
                Grid.Row="2"
                Margin="{StaticResource BlockContentMargin}"
                Style="{StaticResource ContentTextWithShadowStyle}" 
                Content="{Binding DialogMessage}"/>
            
            <StackPanel 
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    x:Name="LeftButton"
                    Margin="{StaticResource ButtonMargin}"
                    Width="100" Height="40"
                    FontSize="16"
                    Content="{Binding LeftButton.Text}"
                    Command="{Binding LeftButtonCommand}"
                    IsDefault="{Binding LeftButton.IsDefault, FallbackValue=False}"
                    IsCancel="{Binding LeftButton.IsCancel, FallbackValue=False}"
                    Visibility="{Binding LeftButton, Converter={convx:ObjectToVisibilityConverter}}"/>

                <Button
                    x:Name="CentralButton"
                    Margin="{StaticResource ButtonMargin}"
                    Width="100" Height="40"
                    FontSize="16"
                    Content="{Binding CentralButton.Text}"
                    Command="{Binding CentralButtonCommand}"
                    IsDefault="{Binding CentralButton.IsDefault, FallbackValue=False}"
                    IsCancel="{Binding CentralButton.IsCancel, FallbackValue=False}"
                    Visibility="{Binding CentralButton, Converter={convx:ObjectToVisibilityConverter}}"/>

                <Button
                    x:Name="RightButton"
                    Margin="{StaticResource ButtonMargin}"
                    Width="100" Height="40"
                    FontSize="16"
                    Content="{Binding RightButton.Text}"
                    Command="{Binding RightButtonCommand}"
                    IsDefault="{Binding RightButton.IsDefault, FallbackValue=False}"
                    IsCancel="{Binding RightButton.IsCancel, FallbackValue=False}"
                    Visibility="{Binding RightButton, Converter={convx:ObjectToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</ContentControl>
