<ContentControl 
    x:Class="Xcc.Shared.Views.DatePickerDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    xmlns:viewModels="clr-namespace:Xcc.Shared.ViewModels"
    xmlns:behaviors="clr-namespace:Xcc.Application.UI.Behaviors;assembly=Xcc.Application"
    
    IsTabStop="False"
    FontSize="{StaticResource BaseFontSize}"

    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:DatePickerDialogViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Background="{StaticResource BlockBackgroundColor}"
        BorderBrush="{StaticResource AppBorderActiveColor}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Close button-->
            <Button 
                Grid.Row="0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Style="{StaticResource ButtonCloseStyle}"/>

            <!--Date picker-->
            <Border 
                Grid.Row="2"
                Background="White" 
                CornerRadius="5">
                
                <Grid Margin="{StaticResource BlockContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="From:" FontWeight="Bold" FontSize="{StaticResource HugeFontSize}" Style="{StaticResource TextBlockLegendStyle}" Grid.Column="0" Grid.Row="0"/>
                    <TextBlock Text="To:" FontWeight="Bold" FontSize="{StaticResource HugeFontSize}" Style="{StaticResource TextBlockLegendStyle}" Grid.Column="1" Grid.Row="0"/>

                    <Calendar 
                        Grid.Row="1" Grid.Column="0" Margin="0,0,5,0" 
                        Style="{StaticResource CalendarDefaultStyle}"
                        SelectedDate="{Binding FromDate}" 
                        behaviors:CalendarBehaviors.ReleaseMouseAfterSelection="True"/> 
                    
                    <Calendar 
                        Grid.Row="1" Grid.Column="1" 
                        Style="{StaticResource CalendarDefaultStyle}"
                        SelectedDate="{Binding ToDate}" 
                        behaviors:CalendarBehaviors.ReleaseMouseAfterSelection="True"/>
                </Grid>
            </Border>

            <!--Date picker-->
            <Button 
                Grid.Row="4"
                Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}"
                Content="Apply"
                Command="{Binding ApplyCommand}"
                IsDefault="True"/>
        </Grid>
    </Border>
</ContentControl>
