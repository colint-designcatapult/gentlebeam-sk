<ContentControl 
    x:Class="Heracles.Indoor.Views.PlanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 
    xmlns:views ="clr-namespace:Heracles.Indoor.Views"
    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
    
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
 
    xmlns:conv="clr-namespace:Heracles.Application.UI.Converters;assembly=Heracles.Application"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    xmlns:userControls="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:emr="clr-namespace:Heracles.Application.Models.RDBMS.EMR;assembly=Heracles.Application"
    xmlns:emr1="clr-namespace:Heracles.Core.Models.EMR;assembly=Heracles.Core"

    UseLayoutRounding="True"
    IsTabStop="False"

    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:PlanViewModel}, IsDesignTimeCreatable=True}"
    d:DesignWidth="1920" d:DesignHeight="1080">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/TabControlMainIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonToolbarStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonToolbarAccentStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid Margin="{StaticResource LabeledBlockContentMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:FieldDetailsView Grid.Row="0" Grid.ColumnSpan="3"/>

        <views:SitesView Grid.Column="0" Grid.Row="2" Grid.RowSpan="3"/>

        <GridSplitter 
            Margin="10"
            Grid.Column="1" Grid.Row="0" Grid.RowSpan="5" 
            Width="2" Height="{StaticResource ButtonWidth}"
            Background="{StaticResource BlockBorderColor}" 
            HorizontalAlignment="Center"
            FocusVisualStyle="{x:Null}"
            IsTabStop="False"/>

        <Grid Grid.Row="2" Grid.Column="2" IsEnabled="{Binding TreatmentInfoStore.Diagnosis.Archived, Converter={convx:InverseBooleanConverter}, FallbackValue=true}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                <ColumnDefinition Width="2.4*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!--Simulation and Prescription-->
                <RowDefinition Height="Auto"/>
                <!--Gallery-->
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Simulation-->
            <views:SimulationView Grid.Column="0" Grid.Row="0"/>

            <!--Prescription-->
            <views:PrescriptionView Grid.Column="2" Grid.Row="0"/>

            <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--Photos-->
                <Border Grid.Column="0" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource LabeledBlockContentMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock 
                            Grid.Row="0"
                            Text="Photos"  
                            FontSize="{StaticResource LargeFontSize}" 
                            Style="{StaticResource TextBlockLegendStyle}"
                            Foreground="{StaticResource ForegroundPaleBrush}"
                            HorizontalAlignment="Left"/> 

                        <controls:XccGallery 
                            Grid.Row="2"
                            SelectedItem="{Binding SelectedPhoto}"
                            ItemsSource="{Binding Photos}"
                            ButtonStyle="{StaticResource ButtonDefaultStyle}"
                            IsTabStop="False">

                            <controls:XccGallery.ItemTemplate>
                                <DataTemplate  DataType="{x:Type emr:Photo}">
                                    <Border x:Name="Border" Margin="4" BorderThickness="2" CornerRadius="{StaticResource FieldCornerRadius}">
                                        <Image Source="{Binding Data}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{convx:ItemsIsEqualConverter}">
                                                    <Binding RelativeSource="{RelativeSource AncestorType=controls:XccGallery}" Path="SelectedItem"/>
                                                    <Binding />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SelectedForegroundBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </controls:XccGallery.ItemTemplate>
                        </controls:XccGallery>
                    </Grid>
                </Border>

                <!--Images-->
                <Border Grid.Column="2" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource LabeledBlockContentMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock 
                            Grid.Row="0"
                            Text="Images"  
                            FontSize="{StaticResource LargeFontSize}" 
                            Style="{StaticResource TextBlockLegendStyle}"
                            Foreground="{StaticResource ForegroundPaleBrush}"
                            HorizontalAlignment="Left"/> 

                        <controls:XccGallery 
                            Grid.Row="2"
                            SelectedItem="{Binding SelectedImage}"
                            ItemsSource="{Binding AcquisitionModel.Items}"
                            ButtonStyle="{StaticResource ButtonDefaultStyle}"
                            IsTabStop="False">

                            <controls:XccGallery.ItemTemplate>
                                <DataTemplate DataType="{x:Type emr1:ISeries}">
                                    <Border x:Name="Border" Margin="4" BorderThickness="2" CornerRadius="{StaticResource FieldCornerRadius}">
                                        <Grid>
                                            <Image Source="{Binding Location}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>

                                            <Button 
                                                Style="{StaticResource PlayButtonStyle}"
                                                Command="{Binding DataContext.OpenAcquisitionCommand, RelativeSource={RelativeSource AncestorType=views:PlanView}}" 
                                                CommandParameter="{Binding}"
                                                Width="40" Height="40" 
                                                VerticalAlignment="Top" HorizontalAlignment="Right" 
                                                Margin="8"/>
                                        </Grid>
                                    </Border>

                                    <!--<DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{convx:ItemsIsEqualConverter}">
                                                    <Binding RelativeSource="{RelativeSource AncestorType=controls:XccGallery}" Path="SelectedItem"/>
                                                    <Binding />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SelectedForegroundBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>-->
                                </DataTemplate>
                            </controls:XccGallery.ItemTemplate>
                        </controls:XccGallery>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--Buttons block-->
        <Border Grid.Column="2" Grid.Row="4" Style="{StaticResource BorderBlockStyle}">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource ButtonDoubleMarginGridLength}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource ButtonMarginGridLength}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource ButtonMarginGridLength}" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="{StaticResource ButtonMarginGridLength}" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Grid.Column="0"
                    Width="{StaticResource ButtonWidth}" 
                    Height="{StaticResource ButtonHeight}"
                    Command="{Binding ExitCommand}">

                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource GoBackIcon}" Stretch="None"/>
                        <TextBlock Text="Back" Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}"/>
                    </Grid>
                </Button>

                <!--Capture photo button-->
                <Button 
                    Grid.Column="4"
                    Height="{StaticResource ButtonHeight}"
                    Width="{StaticResource ButtonWidthLarge}"
                    Command="{Binding CapturePhotoCommand}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Path 
                            Data="{StaticResource AcquisitionCameraIcon}" 
                            Style="{StaticResource ButtonPathStyle}" 
                            Width="32" Height="32"/>

                        <TextBlock Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}" Text="Camera"/>
                    </Grid>
                </Button>

                <!--Scan button-->
                <Button 
                    Grid.Column="2"
                    Height="{StaticResource ButtonHeight}"
                    Width="{StaticResource ButtonWidth}"
                    Command="{Binding ScanVolumeCommand}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Path 
                            Data="{StaticResource UltrasoundIcon}" 
                            Style="{StaticResource ButtonPathStyle}" 
                            Width="38" Height="38"/>

                        <TextBlock Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}" Text="Scan"/>
                    </Grid>
                </Button>

                <userControls:XccWarningLabel
                    Grid.Column="6" 
                    FontSize="{StaticResource SmallFontSize}"
                    Text="{Binding ApplicatorCompatibilityStatus.CompatibilityMessage}"
                    Visibility="{Binding ApplicatorCompatibilityStatus.IsCompatible, Converter={convx:BooleanToInvisibilityConverter Invisibility=Hidden}}"/>

                <!--Verify button-->
                <Button 
                    Grid.Column="8"
                    Height="{StaticResource ButtonHeight}"
                    DockPanel.Dock="Right"
                    Command="{Binding VerifyCommand}">

                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Path
                            Data="{StaticResource ApproveIcon}" 
                            Style="{StaticResource ButtonPathStyleThickness2}">

                            <Path.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </Path.RenderTransform>
                        </Path>

                        <TextBlock 
                            Grid.Column="2"
                            Text="Verify"
                            Style="{StaticResource ButtonTextBlockStyle}"/>

                        <!--<TextBlock 
                            Grid.Column="2"
                            Visibility="{Binding TreatmentInfoStore.Plan.Status, Converter={convx:ObjectToVisibilityConverter}, ConverterParameter={x:Static enums:PlanStatus.APPROVED}, FallbackValue=Collapsed}"
                            Style="{StaticResource ButtonTextBlockStyle}"
                            Text="Unverify"/>-->
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentControl>
