<ContentControl 
    x:Class="Heracles.Indoor.Views.Physics.MagnetometerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels.Physics"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
             
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    UseLayoutRounding="True"
    
    mc:Ignorable="d" 
    d:DesignWidth="800" d:DesignHeight="800"
    d:DataContext="{d:DesignInstance {x:Type viewModels:MagnetometerViewModel}, IsDesignTimeCreatable=True}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <!--Correction values-->
    <Border 
        Style="{StaticResource BorderBlockStyle}"
        IsEnabled="{Binding Store.Corrections, Converter={convx:ObjectIsNotNullConverter}}">

        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Text="Magnetometer Corrections" 
                FontSize="{StaticResource HugeFontSize}" 
                Style="{StaticResource TextBlockLegendStyle}"
                HorizontalAlignment="Left"/>

            <!--Correction Matrix-->
            <GroupBox 
                Grid.Row="2" 
                Header="Correction Matrix">

                <UniformGrid Columns="2" Rows="1">
                    <!--Back-->
                    <DockPanel Margin="{StaticResource ViewMargin}">
                        <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource LargeFontSize}" Style="{StaticResource TextBlockLegendStylePale}">
                            <Run Text="Back"/>
                            <Run Text="[mA/μT]" Foreground="{StaticResource ForegroundPaleBrush}"/>
                        </TextBlock>

                        <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMarginTop}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource FieldMarginGridLength}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource FieldMarginGridLength}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            </Grid.RowDefinitions>
                            
                            <controls:XccTextBox 
                                Tag="CMB 1,1" 
                                Grid.Column="0" Grid.Row="0" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm11}"/>


                            <controls:XccTextBox 
                                Tag="CMB 1,2" 
                                Grid.Column="2" Grid.Row="0" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm12}"/>


                            <controls:XccTextBox 
                                Tag="CMB 1,3" 
                                Grid.Column="4" Grid.Row="0" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm13}"/>

                            <controls:XccTextBox 
                                Tag="CMB 2,1" 
                                Grid.Column="0" Grid.Row="2" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm21}"/>


                            <controls:XccTextBox 
                                Tag="CMB 2,2" 
                                Grid.Column="2" Grid.Row="2" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm22}"/>


                            <controls:XccTextBox 
                                Tag="CMB 2,3" 
                                Grid.Column="4" Grid.Row="2" 
                                Text="{Binding Store.Corrections.BackMatrix.Cm23}"/>
                        </Grid>
                    </DockPanel>

                    <!--Front-->
                    <DockPanel  Margin="{StaticResource ViewMargin}">
                        <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource LargeFontSize}"  Style="{StaticResource TextBlockLegendStylePale}">
                            <Run Text="Front"/>
                            <Run Text="[mA/μT]" Foreground="{StaticResource ForegroundPaleBrush}"/>
                        </TextBlock>

                        <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMarginTop}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource FieldMarginGridLength}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource FieldMarginGridLength}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            </Grid.RowDefinitions>

                            <controls:XccTextBox 
                                Tag="CMF 1,1" 
                                Grid.Column="0" Grid.Row="0" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm11}"/>


                            <controls:XccTextBox 
                                Tag="CMF 1,2" 
                                Grid.Column="2" Grid.Row="0" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm12}"/>


                            <controls:XccTextBox 
                                Tag="CMF 1,3" 
                                Grid.Column="4" Grid.Row="0" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm13}"/>

                            <controls:XccTextBox 
                                Tag="CMF 2,1" 
                                Grid.Column="0" Grid.Row="2" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm21}"/>


                            <controls:XccTextBox 
                                Tag="CMF 2,2" 
                                Grid.Column="2" Grid.Row="2" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm22}"/>


                            <controls:XccTextBox 
                                Tag="CMF 2,3" 
                                Grid.Column="4" Grid.Row="2" 
                                Text="{Binding Store.Corrections.FrontMatrix.Cm23}"/>
                        </Grid>
                    </DockPanel>
                </UniformGrid>
            </GroupBox>

            <!--Reference Field-->
            <GroupBox 
                Grid.Row="4" 
                Margin="0"
                Header="Reference Field">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <!--Back-->
                    <DockPanel Grid.Column="0" Margin="{StaticResource ViewMargin}">
                        <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource LargeFontSize}" Style="{StaticResource TextBlockLegendStylePale}">
                            <Run Text="Back"/>
                            <Run Text="[mA/μT]" Foreground="{StaticResource ForegroundPaleBrush}"/>
                        </TextBlock>

                        <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMarginTop}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            </Grid.RowDefinitions>

                            <controls:XccTextBox 
                                Tag="RFB 1,1" 
                                Grid.Column="0" Grid.Row="0" 
                                Text="{Binding Store.Corrections.BackReferenceField.Rf11}"/>

                            <controls:XccTextBox 
                                Tag="RFB 2,1" 
                                Grid.Row="2" 
                                Text="{Binding Store.Corrections.BackReferenceField.Rf21}"/>

                            <controls:XccTextBox 
                                Tag="RFB 3,1"
                                Grid.Row="4" 
                                Text="{Binding Store.Corrections.BackReferenceField.Rf31}"/>
                        </Grid>
                    </DockPanel>

                    <!--Front-->
                    <DockPanel Grid.Column="2" Margin="{StaticResource ViewMargin}">
                        <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource LargeFontSize}" Style="{StaticResource TextBlockLegendStylePale}">
                            <Run Text="Front"/>
                            <Run Text="[mA/μT]" Foreground="{StaticResource ForegroundPaleBrush}"/>
                        </TextBlock>

                        <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMarginTop}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                                <RowDefinition Height="{StaticResource TaggedFieldGridLength}"/>
                                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            </Grid.RowDefinitions>

                            <controls:XccTextBox 
                                Tag="RFF 1,1" 
                                Grid.Column="0" Grid.Row="0" 
                                Text="{Binding Store.Corrections.FrontReferenceField.Rf11}"/>

                            <controls:XccTextBox 
                                Tag="RFF 2,1" 
                                Grid.Column="0" Grid.Row="2" 
                                Text="{Binding Store.Corrections.FrontReferenceField.Rf21}"/>

                            <controls:XccTextBox 
                                Tag="RFF 3,1" 
                                Grid.Column="0" Grid.Row="4" 
                                Text="{Binding Store.Corrections.FrontReferenceField.Rf31}"/>
                        </Grid>
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Border>

        <!--<ucx:TaskOverlay 
            Margin="{StaticResource ViewMarginNegative}"
            Grid.Row="0" Grid.RowSpan="3"
            Visibility="{Binding CurrentMagnetometerTask.IsSuccessfullyCompleted, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
            ObservedTask="{Binding CurrentMagnetometerTask}"
            RetryCommand="{Binding RetryMagnetometerCommand}"
            CancelCommand="{Binding CancelMagnetometerCommand}"
            Description="{Binding CurrentMagnetometerTask.ErrorMessage}"
            CornerRadius="0,7,7,7"/>-->
</ContentControl>
