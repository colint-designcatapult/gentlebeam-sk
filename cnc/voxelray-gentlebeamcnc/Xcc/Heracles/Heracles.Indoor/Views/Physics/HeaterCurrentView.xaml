<ContentControl 
    x:Class="Heracles.Indoor.Views.Physics.HeaterCurrentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels.Physics"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    mc:Ignorable="d" 
    d:DesignWidth="1280" d:DesignHeight="800"
    d:DataContext="{d:DesignInstance {x:Type viewModels:HeaterCurrentViewModel}, IsDesignTimeCreatable=True}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <!--Correction values-->
    <Border Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}" IsEnabled="{Binding Store.HeaterCurrent, Converter={convx:ObjectIsNotNullConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" SharedSizeGroup="Header"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto" SharedSizeGroup="Header"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" Grid.ColumnSpan="3"
                Text="Heater current"  
                FontSize="{StaticResource HugeFontSize}" 
                Style="{StaticResource TextBlockLegendStyle}"
                HorizontalAlignment="Left"/> 

            <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="Legend" Style="{StaticResource TextBlockLegendStyle}" HorizontalAlignment="Right">
                    <Run Text="Heater Current"/>
                    <Run Text="[mA]" Foreground="{StaticResource ForegroundPaleBrush}"/>
                </TextBlock>

                <controls:XccTextBox 
                    Grid.Row="2" 
                    Width="{Binding ElementName=Legend, Path=ActualWidth}"
                    IsReadOnly="{Binding Store.HeaterCurrent, Converter={convx:ObjectIsNullConverter}}"
                    Text="{Binding Store.HeaterCurrent.HeaterCurrent, Converter={convx:DoubleToPersistantStringConverter}}">
                </controls:XccTextBox>
            </Grid>
        </Grid>
    </Border>

</ContentControl>
