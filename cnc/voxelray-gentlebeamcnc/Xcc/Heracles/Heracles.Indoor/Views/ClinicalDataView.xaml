<ContentControl x:Class="Heracles.Indoor.Views.ClinicalDataView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
                xmlns:views ="clr-namespace:Heracles.Indoor.Views"
                xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
                xmlns:system="clr-namespace:System;assembly=netstandard"
                
                xmlns:prism="http://prismlibrary.com/"
                prism:ViewModelLocator.AutoWireViewModel="True"
                
                xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
                xmlns:enums="clr-namespace:Heracles.Core.Enums;assembly=Heracles.Core"
                xmlns:appx="clr-namespace:Xcc.Application.UI;assembly=Xcc.Application"

                IsTabStop="False"
                    
                mc:Ignorable="d" 
                d:DesignWidth="1600" d:DesignHeight="980"
                d:DataContext="{d:DesignInstance {x:Type viewModels:ClinicalDataViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>
    
    <Border Margin="{StaticResource BlockContentMargin}" Style="{StaticResource BorderOutlineStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:PatientProfileView d:DataContext="{d:DesignInstance viewModels:PatientProfileViewModel, IsDesignTimeCreatable=True}"/>

            <ContentControl Grid.Row="2" IsTabStop="False" prism:RegionManager.RegionName="{x:Static appx:Regions+Main.ClinicalDataRegion}"/>

            <!--The overlay is Collapsed if the TreatmentLoadingState == TreatmentLoadingState.Unloaded, otherwise it Visible-->
            <Grid 
                Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource DisabledControlBrush}"
                Visibility="{Binding 
                Path=PlanModel.Plan.TreatmentLoadingState, 
                Converter={convx:ObjectToInvisibilityConverter}, 
                ConverterParameter={x:Static enums:TreatmentLoadingState.Unloaded}, 
                FallbackValue={x:Static Visibility.Collapsed}}">
                
                <Grid.Resources>
                    <ResourceDictionary>
                        <system:String x:Key="PendingLoadText">Treatment Plan was sent to the Treatment Console for radiation delivery</system:String>
                        <system:String x:Key="LoadedText">Treatment Plan loaded to the Treatment Console for radiation delivery</system:String>
                        <system:Double x:Key="FontSize">28</system:Double>
                    </ResourceDictionary>
                </Grid.Resources>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!--TreatmentLoadingState.PendingLoad-->
                    <StackPanel 
                        Visibility="{Binding 
                        Path=PlanModel.Plan.TreatmentLoadingState, 
                        Converter={convx:ObjectToInvisibilityConverter}, 
                        ConverterParameter={x:Static enums:TreatmentLoadingState.Loaded}, 
                        FallbackValue={x:Static Visibility.Visible}}">

                        <ContentControl FontSize="{StaticResource FontSize}" Style="{StaticResource ContentTextWithShadowStyle}" Content="{StaticResource PendingLoadText}"/>
                        
                        <!--Cancel button-->
                        <Button 
                            Margin="0,16" 
                            Width="168"
                            Height="{StaticResource ButtonHeight}" 
                            HorizontalContentAlignment="Center"
                            Command="{Binding CancelLoadPlanCommand}">

                            <StackPanel Orientation="Horizontal">
                                <Path 
                                    Data="{StaticResource RefreshIcon3}"
                                    Style="{StaticResource ButtonPathStyle}" 
                                    Height="25" Width="25" Margin="0,0,10,0" />

                                <Label Content="Cancel" Style="{StaticResource ButtonLabelStyle}" Padding="0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--TreatmentLoadingState.Loaded-->
                    <ContentControl 
                        FontSize="{StaticResource FontSize}"
                        Style="{StaticResource ContentTextWithShadowStyle}" 
                        Visibility="{Binding 
                        Path=PlanModel.Plan.TreatmentLoadingState, 
                        Converter={convx:ObjectToVisibilityConverter}, 
                        ConverterParameter={x:Static enums:TreatmentLoadingState.Loaded}, 
                        FallbackValue={x:Static Visibility.Collapsed}}"
                        Content="{StaticResource LoadedText}"/>
                </StackPanel>
            </Grid> 
        </Grid>
    </Border>
</ContentControl>
