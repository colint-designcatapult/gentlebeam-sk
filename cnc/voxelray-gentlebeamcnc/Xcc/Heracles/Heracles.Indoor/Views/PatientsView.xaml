<ContentControl x:Class="Heracles.Indoor.Views.PatientsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                mc:Ignorable="d" 
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                xmlns:sys="clr-namespace:System;assembly=netstandard"
                
                xmlns:prism="http://prismlibrary.com/"
                prism:ViewModelLocator.AutoWireViewModel="True"
                
                xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
                xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
                xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
                xmlns:enumsx ="clr-namespace:Xcc.Core.Enums;assembly=Xcc.Core"
                xmlns:behaviors="clr-namespace:Xcc.Application.UI.Behaviors;assembly=Xcc.Application"
                xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

                KeyboardNavigation.IsTabStop="False"
                
                d:DataContext="{d:DesignInstance viewModels:PatientsViewModel, IsDesignTimeCreatable=True}"
                d:DesignWidth="1920" d:DesignHeight="1080">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid>
        <Border Style="{StaticResource BorderOutlineStyle}">
            <Grid>
                <Grid Margin="{StaticResource ViewMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                        <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Search field-->
                    <Grid 
                        Width="320" 
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding PatientProfileForm.FormData, Converter={convx:ObjectIsNullConverter}}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:XccTextBox 
                            Grid.ColumnSpan="2"
                            Watermark="Search"
                            x:Name="SearchPhraseTextBox" 
                            HorizontalAlignment="Stretch"
                            Text="{Binding SearchPhrase}"
                            behaviors:FocusBehaviors.FocusOnLoad="True"/>

                        <Button 
                            Grid.Column="1"
                            Width="24"
                            Margin="6,0"
                            Style="{StaticResource ButtonCrossStyle}"
                            Command="{Binding RemoveSearchPhraseCommand}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8.5*" />
                            <RowDefinition Height="{StaticResource BlockMarginGridLength}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13*" />
                            <ColumnDefinition Width="23*"/>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView 
                            ItemsSource="{Binding PatientsViewSource.View}"
                            SelectedItem="{Binding SelectedPatient}"
                            Style="{StaticResource TableListView}"
                            Tag="{StaticResource PatientListHeaderTemplate}"
                            ItemTemplate="{StaticResource PatientListItemTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            IsHitTestVisible="{Binding PatientProfileForm.FormData, Converter={convx:ObjectIsNullConverter}}" Grid.ColumnSpan="2"/>

                        <CheckBox VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,6,0" IsChecked="{Binding IsOpen, ElementName=ColumnsSelector}" Grid.Column="1">
                        <Popup x:Name="ColumnsSelector" Placement="Mouse" AllowsTransparency="True">
                            <Border Background="{StaticResource PopupBackgroundBrush}" BorderBrush="Black" CornerRadius="6" BorderThickness="0,0,0,1">
                                <StackPanel  Margin="10">
                                    <CheckBox x:Name="MRN" Content="MRN" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="FirstName" Content="First name" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="MiddleName" Content="Middle name" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="LastName" Content="Last name" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="Gender" Content="Sex" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="DOB" Content="Date of Birth" IsChecked="True"/>
                                    <Separator Width="20" Background="Transparent"/>
                                    <CheckBox x:Name="LastVisit" Content="Last Visit" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </CheckBox>

                        <Grid
                            Grid.Row="0" Grid.Column="2" 
                            Width="400"
                            Visibility="{Binding PatientProfileForm.FormData, Converter={convx:ObjectToVisibilityConverter}}"
                            Margin="30,0,0,0">

                            <DockPanel>
                                <Border 
                                    Style="{StaticResource BorderToolbarStyle}">

                                    <Button 
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ButtonToolbarAccentStyle}" 
                                        Command="{Binding SavePatientCommand}">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Path Data="{StaticResource SaveToDiskIcon}" Style="{StaticResource PathButtonAccentStyle}"/>
                                            <TextBlock Grid.Column="2" Text="Save Patient" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>

                                <Border 
                                    Style="{StaticResource BorderBlockStyle}"
                                    CornerRadius="8,8,0,0">

                                    <Border.Resources>
                                        <ObjectDataProvider x:Key="SexDataSource" ObjectType="{x:Type sys:Enum}"  MethodName="GetValues">
                                            <ObjectDataProvider.MethodParameters>
                                                <x:Type TypeName="enumsx:Sex"/>
                                            </ObjectDataProvider.MethodParameters>
                                        </ObjectDataProvider>

                                        <ObjectDataProvider x:Key="PatientIdTypeDataSource" ObjectType="{x:Type sys:Enum}"  MethodName="GetValues">
                                            <ObjectDataProvider.MethodParameters>
                                                <x:Type TypeName="enumsx:PatientIdType"/>
                                            </ObjectDataProvider.MethodParameters>
                                        </ObjectDataProvider>
                                    </Border.Resources>

                                    <Grid Margin="10" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>

                                        <ScrollViewer 
                                            Grid.Row="0" 
                                            Margin="10,30,10,10" 
                                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" 
                                            PanningMode="VerticalOnly">

                                            <DockPanel Margin="1">

                                                <!--First Name & Middle Name block-->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}">
                                                        <Run Text="First Name"/>
                                                        <Run Text="*" Foreground="{StaticResource ForegroundAccentBrush}"/>
                                                    </TextBlock>
                                                    
                                                    <controls:XccTextBox 
                                                        x:Name="FirstNameTextBox" 
                                                        Grid.Row="1" Grid.Column="0"  
                                                        Text="{Binding PatientProfileForm.FormData.FirstName}"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}" Text="Middle Name"/>
                                                    <controls:XccTextBox 
                                                        Grid.Row="1" Grid.Column="2" 
                                                        Text="{Binding PatientProfileForm.FormData.MiddleName}"/>
                                                </Grid>

                                                <!--Last Name & Sex block-->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}">
                                                        <Run Text="Last Name"/>
                                                        <Run Text="*" Foreground="{StaticResource ForegroundAccentBrush}"/>
                                                    </TextBlock>

                                                    <controls:XccTextBox 
                                                        x:Name="LastNameTextBox"
                                                        Grid.Row="1" Grid.Column="0" 
                                                        Text="{Binding PatientProfileForm.FormData.LastName}"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}">
                                                        <Run Text="Sex"/>
                                                        <Run Text="*" Foreground="{StaticResource ForegroundAccentBrush}"/>
                                                    </TextBlock>

                                                    <ComboBox 
                                                        Grid.Row="1" Grid.Column="2" 
                                                        IsReadOnly="True"
                                                        IsEditable="False"                                         
                                                        ItemsSource="{Binding Source={StaticResource SexDataSource}}" 
                                                        SelectedItem="{Binding PatientProfileForm.FormData.Sex}"
                                                        Foreground="{StaticResource FieldForegroundColor}" BorderThickness="0" Margin="0">

                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={convx:EnumValueToDisplayNameConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>

                                                <!--Date of Birth block-->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}">
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}">
                                                            <Run Text="Date of Birth"/>
                                                            <Run Text="*" Foreground="{StaticResource ForegroundAccentBrush}"/>
                                                        </TextBlock>
                                                    </TextBlock>

                                                    <controls:XccDateInputTextBox 
                                                        x:Name="DateOfBirthTextBox" 
                                                        Grid.Row="1" Grid.Column="0" 
                                                        Style="{StaticResource XccTextBoxDefaultStyle}"
                                                        Date="{Binding PatientProfileForm.FormData.DOB}"/>

                                                    <ToggleButton
                                                        HorizontalAlignment="Left"
                                                        Grid.Row="1" Grid.Column="2"
                                                        ToolTip="Pick date" 
                                                        IsChecked="{Binding PatientProfileForm.IsCalendarVisible}"
                                                        x:Name="CalendarToggleButton" 
                                                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">

                                                        <Path 
                                                            Margin="-1"
                                                            Height="20" 
                                                            StrokeThickness="1" 
                                                            Fill="Transparent" 
                                                            Style="{StaticResource ButtonPathStyle}" 
                                                            Data="{StaticResource CalendarIcon}" Stretch="Uniform" />
                                                    </ToggleButton>
                                                </Grid>

                                                <!-- MRN/ID block -->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}">
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}">
                                                            <Run Text="MRN/ID"/>
                                                            <Run Text="*" Foreground="{StaticResource ForegroundAccentBrush}"/>
                                                        </TextBlock>
                                                    </TextBlock>

                                                    <controls:XccTextBox 
                                                        x:Name="MrnIdTextBox"
                                                        Grid.Row="1" Grid.ColumnSpan="3" 
                                                        Text="{Binding PatientProfileForm.FormData.MRN}"/>
                                                </Grid>

                                                <!-- ZIP code-->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource TextBlockLegendStyle}" Text="ZIP Code"/>
                                                    <controls:XccTextBox 
                                                        x:Name="ZipCodeTextBox" 
                                                        Grid.Row="1"
                                                        Text="{Binding PatientProfileForm.FormData.Zip}"/>
                                                </Grid>

                                                <!-- Email block -->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                                                        <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource TextBlockLegendStyle}" Text="Email"/>
                                                    <controls:XccTextBox 
                                                        x:Name="EmailTextBox" 
                                                        Grid.Row="1" Grid.ColumnSpan="3" 
                                                        Text="{Binding PatientProfileForm.FormData.Email}"/>
                                                </Grid>

                                                <!--Patient's Demographic Notes block-->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}" Text="Additional Notes"/>

                                                    <controls:XccTextBox 
                                                        Padding="4,2,2,2"
                                                        Grid.Row="1"
                                                        
                                                        TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Text="{Binding PatientProfileForm.FormData.Notes}"/>
                                                </Grid>
                                            </DockPanel>
                                        </ScrollViewer>

                                        <Button 
                                            Grid.Row="0" 
                                            VerticalAlignment="Top" 
                                            HorizontalAlignment="Right"
                                            Command="{Binding CancelEditPatientCommand}"
                                            Style="{StaticResource ButtonCloseStyle}">
                                        </Button>

                                    </Grid>
                                </Border>
                            </DockPanel>

                            <ucx:TaskOverlay 
                                Grid.Row="0"
                                Visibility="{Binding SavePatientTask.IsSuccessfullyCompleted, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
                                ObservedTask="{Binding SavePatientTask}"
                                RetryCommand="{Binding RetrySavePatientCommand}"                                
                                Description="{Binding SavePatientTask.ErrorMessage}"
                                CornerRadius="7,7,7,7"/>
                        </Grid>

                        <Border 
                            Grid.Row="2" 
                            Grid.ColumnSpan="3"
                            Style="{StaticResource BorderBlockStyle}">

                            <Grid Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel 
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <Button
                                        Width="180"
                                        Height="{StaticResource ButtonHeight}" 
                                        Command="{Binding NewPatientCommand}">

                                        <StackPanel Orientation="Horizontal">
                                            <Path 
                                                Data="{StaticResource NewPatientIcon}" 
                                                Style="{StaticResource ButtonPathStyle}"
                                                Height="26" Width="26" Margin="0,0,10,0" />

                                            <TextBlock Text="New Patient" Style="{StaticResource ButtonTextBlockStyle}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button 
                                        Width="180" 
                                        Height="{StaticResource ButtonHeight}" 
                                        Command="{Binding EditPatientCommand}"
                                        Margin="20,0">

                                        <StackPanel Orientation="Horizontal">
                                            <Path 
                                                Data="{StaticResource EditPatientIcon}" 
                                                Style="{StaticResource ButtonPathStyle}"
                                                Height="26" Width="26" Margin="0,0,10,0" />

                                            <TextBlock Text="Edit Patient" Style="{StaticResource ButtonTextBlockStyle}"/>
                                        </StackPanel>
                                    </Button>

                                    <!--<Button 
                                        Margin="20, 0" 
                                        Width="{StaticResource ButtonWidth}"
                                        Height="{StaticResource ButtonHeight}" 
                                        Command="{Binding ImportPatientsListCommand}"
                                        HorizontalContentAlignment="Center">

                                        <StackPanel Orientation="Horizontal">
                                            <Path 
                                                Data="{StaticResource ImportIcon}"
                                                Style="{StaticResource ButtonPathStyle}" 
                                                Height="25" Width="25" Margin="0,0,10,0" />

                                            <TextBlock Text="Import" Style="{StaticResource ButtonTextBlockStyle}"/>
                                        </StackPanel>
                                    </Button>-->
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ucx:TaskOverlay 
                    Grid.Row="0"
                    Visibility="{Binding FetchPatientListTask.IsSuccessfullyCompleted, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
                    ObservedTask="{Binding FetchPatientListTask}"
                    RetryCommand="{Binding RetryFetchPatientListCommand}"
                    CancelCommand="{Binding CancelFetchPatientListCommand}"
                    Description="{Binding FetchPatientListTask.ErrorMessage}"
                    CornerRadius="7,7,7,7"/>
            </Grid>
        </Border>

        <!--Date picker-->
        <Grid Visibility="{Binding PatientProfileForm.IsCalendarVisible, Converter={convx:BooleanToVisibilityConverter Invisibility=Collapsed}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border 
                Grid.Row="1" Grid.Column="1"
                Background="White" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="5">

                <StackPanel Margin="{StaticResource BlockContentMargin}">
                    <TextBlock Text="Date of Birth:" Style="{StaticResource TextBlockLegendStyle}"/>

                    <Calendar 
                        Style="{StaticResource CalendarDefaultStyle}"
                        behaviors:CalendarBehaviors.ReleaseMouseAfterSelection="True"
                        DisplayDateEnd="{Binding DisplayDateEnd, Mode=OneWay}"
                        DisplayDateStart="{Binding DisplayDateStart, Mode=OneWay}"
                        DisplayDate="{Binding PatientProfileForm.FormData.DOB, Mode=OneWay, Converter={convx:DateOnlyToDateTimeConverter}, FallbackValue={x:Static sys:DateTime.Now}}"
                        SelectedDate="{Binding PatientProfileForm.FormData.DOB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={convx:DateOnlyToDateTimeConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentControl>

    