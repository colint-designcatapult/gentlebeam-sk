<ContentControl 
    x:Class="Heracles.Indoor.Views.PhotoViewerModalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:conv="clr-namespace:Heracles.Application.UI.Converters;assembly=Heracles.Application"
    xmlns:convIndoor="clr-namespace:Heracles.Indoor.Converters"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1e1e1e">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <convIndoor:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="900"/>
            <Setter Property="Height" Value="600"/>
            <Setter Property="ResizeMode" Value="CanResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <DockPanel LastChildFill="True">
        <!-- Bottom Close Button -->
        <Border DockPanel.Dock="Bottom" CornerRadius="8,8,8,8" Background="{StaticResource BlockBackgroundColor}">
            <DockPanel LastChildFill="False" Margin="12">
                <Button 
                    Width="{StaticResource ButtonWidth}" 
                    Height="{StaticResource ButtonHeight}"
                    DockPanel.Dock="Left"
                    Command="{Binding CloseCommand}">

                    <TextBlock Text="Close" Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Full-size Image display area -->
        <Border Background="#1e1e1e" Padding="16">
            <Image 
                Source="{Binding CurrentPhoto.Path, Converter={StaticResource FilePathToImageSourceConverter}}"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Stretch="Uniform" />
        </Border>
    </DockPanel>
</ContentControl>
