<Window x:Class="Heracles.Indoor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:local="clr-namespace:Heracles.Indoor"
        xmlns:appx="clr-namespace:Xcc.Application.UI;assembly=Xcc.Application"
        
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:uc="clr-namespace:Heracles.Application.UI.UserControls;assembly=Heracles.Application"   
        xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
        xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
        mc:Ignorable="d"
       
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="ClearType"
        FontWeight="Normal"
        
        FontSize="{StaticResource BaseFontSize}"
        FontFamily="{StaticResource BaseFont}"

        UseLayoutRounding="True"
        
        Height="1080" Width="1920"
        Title="{Binding Title}"
        Background="{StaticResource ApplicationBackgroundColor}"
        WindowStyle="{Binding WinStyle}"
        WindowState="{Binding WinState}"
        ResizeMode="{Binding WinResizeMode}"
        WindowStartupLocation="CenterScreen"
        
        d:DataContext="{d:DesignInstance {x:Type viewModels:MainWindowViewModel}}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/FontSizeDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/KeyboardToggleButtonStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <ContentControl prism:RegionManager.RegionName="{x:Static appx:Regions.MainRegion}" IsTabStop="False"/>

        <Grid>
            <ucx:XccKeyboard 
                Visibility="{Binding KeyboardAppearance.KeyboardVisibility}"
                CornerRadius="{Binding KeyboardAppearance.KeyboardCornerRadius}"
                HorizontalAlignment="{Binding KeyboardAppearance.KeyboardHorizontalAlignment}"
                VerticalAlignment="{Binding KeyboardAppearance.KeyboardVerticalAlignment}"
                Background="{StaticResource DisabledControlBrush}"/>
        </Grid>

        <ToggleButton Style="{StaticResource KeyboardToggleButtonStyle}" IsChecked="{Binding ShowVirtualKeyboard}"/>
        
        <Grid Background="{StaticResource ApplicationBackgroundColor}" Visibility="{Binding AuthorizedUserStore.AuthorizedUser, Converter={convx:ObjectToInvisibilityConverter}, FallbackValue=Visible}">
            <!--Login button, visible only when AuthorizedUser is null (no tab selected)-->
            <Button 
                Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                
                Style="{StaticResource ButtonDefaultStyle}"
                Command="{Binding LoginCommand}">

                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Image Source="{StaticResource LoginIcon}" Stretch="None"/>
                    <TextBlock Text="Login" Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}"/>
                </Grid>
            </Button>
        </Grid>
        <!--The session lock solid overlay to hide everything from the view-->
        <Grid 
            Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource ApplicationBackgroundColor}"
            Visibility="{Binding ShowSessionLock, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Collapsed}}">
        </Grid>
    </Grid>
</Window>
