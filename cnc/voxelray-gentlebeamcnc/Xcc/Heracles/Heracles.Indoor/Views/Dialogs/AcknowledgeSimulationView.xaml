<ContentControl 
    x:Class="Heracles.Indoor.Views.Dialogs.AcknowledgeSimulationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    prism:ViewModelLocator.AutoWireViewModel="True" 
                
    xmlns:vm="clr-namespace:Heracles.Indoor.ViewModels.Dialogs"

    FontSize="{StaticResource BaseFontSize}"

    mc:Ignorable="d" 
    d:Width="400"
    d:DataContext="{d:DesignInstance {x:Type vm:AcknowledgeSimulationViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderBrush}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}" ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="2" Content="Lesion location" IsChecked="{Binding LesionLocation}" />
            <CheckBox Grid.Row="4" Content="Lesion skin condition" IsChecked="{Binding LesionSkinCondition}" />
            <CheckBox Grid.Row="6" Content="No imaging orders" IsChecked="{Binding NoImagingOrders}" />
            <CheckBox Grid.Row="8" Content="Technical issue" IsChecked="{Binding TechnicalIssue}" />

            <!--Header-->
            <ContentControl 
                Grid.Row="0" 
                FontWeight="SemiBold"
                FontSize="{StaticResource HugeFontSize}"
                Style="{StaticResource ContentTextWithShadowStyle}" 
                Content="{Binding Title}"/>

            <!--Buttons-->
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
                <!--'OK' button-->
                <Button
                    Command="{Binding AcceptCommand}"
                    Width="{StaticResource ButtonWidth}"
                    Height="48"
                    IsDefault="True">

                    <TextBlock Text="Accept"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</ContentControl>