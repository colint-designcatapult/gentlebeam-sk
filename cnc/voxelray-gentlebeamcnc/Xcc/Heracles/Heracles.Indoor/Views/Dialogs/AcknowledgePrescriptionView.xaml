<ContentControl 
    x:Class="Heracles.Indoor.Views.Dialogs.AcknowledgePrescriptionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    prism:ViewModelLocator.AutoWireViewModel="True" 

    xmlns:vm="clr-namespace:Heracles.Indoor.ViewModels.Dialogs"
    xmlns:userControls="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    FontSize="{StaticResource BaseFontSize}"

    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance {x:Type vm:AcknowledgePrescriptionViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderBrush}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Header-->
            <ContentControl 
                Grid.Row="0" 
                FontWeight="SemiBold"
                FontSize="{StaticResource HugeFontSize}"
                Style="{StaticResource ContentTextWithShadowStyle}" 
                Content="{Binding Title}"/>

            <Grid Grid.Row="1" Margin="{StaticResource BlockContentMargin}" ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" IsChecked="{Binding DepthChanged}" Content="Depth changed" />
                <CheckBox Grid.Row="2" IsChecked="{Binding Boost}" Content="Boost" />
                <CheckBox Grid.Row="4" IsChecked="{Binding DoseDecay}" Content="Dose Decay" />
                <CheckBox Grid.Row="6" IsChecked="{Binding ProviderRequest}" Content="Provider Request" />
                <CheckBox Grid.Row="8" IsChecked="{Binding TrogProtocol}" Content="TROG, Protocol" />
                <CheckBox Grid.Row="10" IsChecked="{Binding Other}" Content="Other:" />

                <controls:XccTextBox 
                    Grid.Row="12" 
                    Text="{Binding Comment}"
                    TextWrapping="Wrap" VerticalContentAlignment="Top"
                    IsEnabled="{Binding Other}"/>

                <!--Buttons-->
                <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!--'OK' button-->
                    <Button
                        Command="{Binding AcceptCommand}"
                        Width="{StaticResource ButtonWidth}"
                        Height="48"
                        IsDefault="True">

                        <TextBlock Text="Accept"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ContentControl>