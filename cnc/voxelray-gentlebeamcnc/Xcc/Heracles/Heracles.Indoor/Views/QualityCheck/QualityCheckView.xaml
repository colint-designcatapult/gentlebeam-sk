<ContentControl 
    x:Class="Heracles.Indoor.Views.QualityCheck.QualityCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    xmlns:system="clr-namespace:System;assembly=netstandard"

    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels.QualityCheck"
    xmlns:conv="clr-namespace:Heracles.Application.UI.Converters;assembly=Heracles.Application"
    xmlns:views="clr-namespace:Heracles.Application.UI.Views;assembly=Heracles.Application"

    mc:Ignorable="d" 
    d:DesignWidth="1600" d:DesignHeight="1000"
    d:DataContext="{d:DesignInstance {x:Type viewModels:QualityCheckViewModel}}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/DataGridStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Border Style="{StaticResource BorderOutlineStyle}" Background="{StaticResource ApplicationBackgroundColor}">
        <Grid d:ShowGridLines="True" Margin="{StaticResource ViewMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <views:BeamQaReportsView/>

            <!--Buttons-->
            <Border 
                Grid.Row="2" Grid.ColumnSpan="3"
                Style="{StaticResource BorderBlockStyle}">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ButtonMarginGridLength}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource ButtonMarginGridLength}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!--Approve button-->
                    <Button 
                        Grid.Column="2"
                        Width="{StaticResource ButtonWidth}" 
                        Height="{StaticResource ButtonHeight}"
                        Command="{Binding ApproveCommand}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path
                                Data="{StaticResource ApproveIcon}" 
                                Style="{StaticResource ButtonPathStyleThickness2}">

                                <Path.RenderTransform>
                                    <TranslateTransform Y="2"/>
                                </Path.RenderTransform>
                            </Path>

                            <TextBlock Grid.Column="2" Text="Approve" Style="{StaticResource ButtonTextBlockStyle}"/>
                        </Grid>
                    </Button>

                    <!--'Select Reference' button-->
                    <Button 
                        Grid.Column="4"
                        Height="{StaticResource ButtonHeight}"
                        Command="{Binding SetAsReferenceCommand}">

                        <StackPanel Orientation="Horizontal" UseLayoutRounding="True" >
                            <Viewbox Width="28" Height="32" Margin="0,0,5,0">
                                <Canvas UseLayoutRounding="False" Width="60" Height="68.5">
                                    <Path Style="{StaticResource ButtonPathStyleFilled}">
                                        <Path.Data>
                                            <PathGeometry Figures="M 30 0 L 0 17.1 V 51.4 L 30 68.5 L 60 51.4 V 17.1 Z M 30 4.6 L 56 19.5 V 49.2 L 30 64.1 L 4 49.2 V 19.4 Z" FillRule="Nonzero"/>
                                        </Path.Data>
                                    </Path>
                                    <Path Style="{StaticResource ButtonPathStyleFilled}">
                                        <Path.Data>
                                            <PathGeometry Figures="m 23 31 q 0 0.9 -0.3 1.8 q -0.3 0.8 -0.8 1.5 q -0.5 0.7 -1.2 1.2 q -0.7 0.5 -1.5 0.8 l 3.5 6 q 0.2 0.3 0.2 0.6 q 0 0.3 -0.1 0.6 q -0.1 0.3 -0.3 0.5 q -0.2 0.2 -0.4 0.4 q -0.3 0.1 -0.6 0.2 q -0.3 0 -0.6 0 q -0.3 -0.1 -0.5 -0.3 q -0.2 -0.2 -0.4 -0.4 l -3.9 -7.3 h -2.3 v 6.4 q 0 0.6 -0.4 1 q -0.4 0.4 -1.1 0.4 q -0.6 0 -1.1 -0.4 q -0.4 -0.4 -0.4 -1 v -16.2 q 0 -0.6 0.4 -1 q 0.4 -0.4 1.1 -0.4 h 5 q 1.2 0 2.2 0.4 q 1.1 0.4 1.8 1.2 q 0.8 0.8 1.2 1.8 q 0.4 1 0.4 2.2 z m -9.2 -2.7 v 5.4 h 3.5 q 0.6 0 1.1 -0.2 q 0.5 -0.2 0.9 -0.6 q 0.4 -0.4 0.6 -0.9 q 0.2 -0.5 0.2 -1 q 0 -0.6 -0.2 -1 q -0.2 -0.5 -0.6 -0.9 q -0.4 -0.4 -0.9 -0.6 q -0.5 -0.2 -1.1 -0.2 z m 13.8 16.2 q -0.6 0 -1 -0.4 q -0.4 -0.4 -0.4 -1 v -16.3 q 0 -0.3 0.1 -0.6 q 0.1 -0.3 0.3 -0.5 q 0.2 -0.2 0.5 -0.3 q 0.3 -0.1 0.6 -0.1 h 7.9 q 0.3 0 0.6 0.1 q 0.3 0.1 0.5 0.3 q 0.2 0.2 0.3 0.5 q 0.1 0.3 0.1 0.6 q 0 0.6 -0.4 1.1 q -0.4 0.4 -1 0.4 h -6.5 v 5.2 h 4.7 q 0.3 0 0.6 0.1 q 0.3 0.1 0.5 0.3 q 0.2 0.2 0.3 0.5 q 0.1 0.3 0.1 0.6 q 0 0.6 -0.4 1 q -0.4 0.4 -1 0.4 h -4.7 v 5.1 h 6.5 q 0.6 0 1 0.4 q 0.4 0.4 0.4 1.1 q 0 0.3 -0.1 0.6 q -0.1 0.3 -0.3 0.5 q -0.2 0.2 -0.5 0.3 q -0.3 0.1 -0.6 0.1 z m 13.6 -19.1 q -0.4 0 -0.7 0.1 q -0.3 0.1 -0.4 0.3 q -0.2 0.2 -0.3 0.5 q -0.1 0.3 -0.1 0.5 v 16.2 q 0 0.3 0.1 0.6 q 0.1 0.3 0.3 0.5 q 0.2 0.2 0.5 0.3 q 0.3 0.1 0.6 0.1 q 0.3 0 0.6 -0.1 q 0.3 -0.1 0.5 -0.3 q 0.2 -0.2 0.3 -0.5 q 0.1 -0.3 0.1 -0.6 v -6.7 h 4.4 q 0.6 0 1 -0.4 q 0.4 -0.4 0.4 -1 q 0 -0.6 -0.4 -1 q -0.4 -0.4 -1 -0.4 h -4.4 v -5.1 h 6.4 q 0.6 0 1 -0.4 q 0.4 -0.4 0.4 -1.1 q 0 -0.3 -0.1 -0.6 q -0.1 -0.3 -0.3 -0.5 q -0.2 -0.2 -0.5 -0.3 q -0.3 -0.1 -0.6 -0.1 z" FillRule="Nonzero"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <Label 
                                Content="Select as&#10;Reference"
                                Style="{StaticResource ButtonLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>        
        </Grid>
    </Border>
</ContentControl>
