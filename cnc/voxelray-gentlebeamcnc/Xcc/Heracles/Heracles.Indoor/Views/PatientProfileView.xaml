<ContentControl 
    x:Class="Heracles.Indoor.Views.PatientProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:sys="clr-namespace:System;assembly=netstandard"

    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"

    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
    
    IsTabStop="False"

    mc:Ignorable="d" 
    d:Width="1600"
    d:DataContext="{d:DesignInstance {x:Type viewModels:PatientProfileViewModel}}"
    x:Name="Root">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonTransparentStyle.xaml"/>

                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="PatientImageSize">96</sys:Double>
            <sys:Double x:Key="HugeFontSize">23</sys:Double>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid d:ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Margin="50,12,12,12" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BorderBlockStyle}"/>

        <!--Patient data-->
        <Grid Grid.Column="1" d:ShowGridLines="True" Margin="24,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="0,4,0,0"></Setter>
                </Style> 
            </Grid.Resources>

            <TextBlock
                MaxWidth="900"
                FontSize="29"
                Foreground="{StaticResource AccentForegroundColor}"
                Style="{StaticResource TextBlockLegendStyle}">
            
                <TextBlock.Text>
                    <MultiBinding Converter="{convx:ConditionalSeparatorConverter}" ConverterParameter=", ">
                        <Binding Path="TreatmentInfoStore.Patient.LastName"/>
                        <Binding Path="TreatmentInfoStore.Patient.FirstName"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!--Sex-->
            <Grid Grid.Column="2" MaxWidth="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource BlockContentMarginGridLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock 
                    Grid.Column="0"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStylePale}">
                        
                    <Run Text="Sex:"/>
                </TextBlock>         
                
                <TextBlock 
                    Grid.Column="2"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStyle}">
                        
                    <Run Text="{Binding TreatmentInfoStore.Patient.Sex}"/>
                </TextBlock>   
            </Grid>

            <!--DOB-->
            <Grid Grid.Column="4" MaxWidth="560">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource BlockContentMarginGridLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock 
                    Grid.Column="0"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStylePale}">
                        
                    <Run Text="DOB:"/>
                </TextBlock>         
                
                <TextBlock 
                    Grid.Column="2"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStyle}">
                        
                    <Run Text="{Binding TreatmentInfoStore.Patient.DOB, StringFormat={}{0:MM.dd.yyyy}}"/>
                    <Run Text="{Binding TreatmentInfoStore.Patient.DOB, Converter={convx:DateOfBirthToYearsOldConverter}, StringFormat='({0})'}"/>
                </TextBlock>   
            </Grid>

            <!--MRN-->
            <Grid Grid.Column="6" MaxWidth="480">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource BlockContentMarginGridLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock 
                    Grid.Column="0"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStylePale}">
                        
                    <Run Text="MRN:"/>
                </TextBlock>         
                
                <TextBlock 
                    Grid.Column="2"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStyle}">
                        
                    <Run Text="{Binding TreatmentInfoStore.Patient.MRN}"/>
                </TextBlock>   
            </Grid>

            <!--MRN-->
            <Grid Grid.Column="8" MaxWidth="480">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource BlockContentMarginGridLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock 
                    Grid.Column="0"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStylePale}"
                    Visibility="{Binding TreatmentInfoStore.Patient.Notes, Converter={convx:ObjectToVisibilityConverter}}">
                        
                    <Run Text="Notes:"/>
                </TextBlock>         
                
                <TextBlock 
                    Grid.Column="2"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource TextBlockLegendStyle}">
                        
                    <Run Text="{Binding TreatmentInfoStore.Patient.Notes}"/>
                </TextBlock>   
            </Grid>
        </Grid>

        <Button 
            Grid.Column="0"
            Style="{StaticResource ButtonTransparentStyle}"
            Command="{Binding LoadPictureCommand}" 
            Width="{StaticResource PatientImageSize}"
            Height="{StaticResource PatientImageSize}">

            <ucx:ProfileImageControl PathToImage="{Binding ProfilePicture}"/>
        </Button>

        <ucx:TaskOverlay 
            Grid.Column="0" Grid.ColumnSpan="2"
            Visibility="{Binding CurrentTask.IsSuccessfullyCompleted, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
            ObservedTask="{Binding CurrentTask}"
            RetryCommand="{Binding RetryCurrentTaskCommand}"
            CancelCommand="{Binding CancelCurrentTaskCommand}"
            Description="{Binding CurrentTask.ErrorMessage}"
            Orientation="Horizontal"
            CornerRadius="48,7,7,48"/>
    </Grid>
</ContentControl>
