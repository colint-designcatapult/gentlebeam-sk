<UserControl 
    x:Class="Heracles.Indoor.Views.PrescriptionSummary1View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:enums="clr-namespace:Heracles.Core.Enums;assembly=Heracles.Core"
    
    xmlns:viewModels="clr-namespace:Heracles.Indoor.ViewModels"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    
    xmlns:prism="http://prismlibrary.com/"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    prism:ViewModelLocator.AutoWireViewModel="True"

    FontSize="{StaticResource BaseFontSize}"

    UseLayoutRounding="True"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance {x:Type viewModels:PrescriptionSummaryViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="EnergyDataSource" ObjectType="{x:Type system:Enum}" MethodName="GetValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enums:Energy"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <DockPanel IsEnabled="{Binding TreatmentInfoStore.Simulation, Converter={convx:ObjectIsNotNullConverter}, FallbackValue=false}">
            <Border Style="{StaticResource BorderBlockStyle}">
                <Grid Margin="{StaticResource LabeledBlockContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock 
                        Grid.Row="0"
                        Text="Prescription"  
                        FontSize="{StaticResource LargeFontSize}" 
                        Style="{StaticResource TextBlockLegendStyle}"
                        Foreground="{StaticResource ForegroundPaleBrush}"
                        HorizontalAlignment="Left" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="{StaticResource BlockMarginGridLength}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Fx per week -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}" Text="Fx per week" />

                            <controls:XccTextBox 
                                Grid.Row="2"
                                IsReadOnly="True"
                                Text="{Binding TreatmentInfoStore.Prescription.FxsPerWeek}"/>
                        </Grid>

                        <!-- Number of Fx -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}" Text="Number of Fx" />
                            <controls:XccTextBox 
                                Grid.Row="2"
                                IsReadOnly="True"
                                Name="NumberOfFxTextBox"
                                IsGotFocus="{Binding NumberOfFxsGotFocus, Mode=OneWayToSource}"
                                Text="{Binding TreatmentInfoStore.Prescription.NumberOfFxs}"
                                Watermark="0" />
                        </Grid>

                        <!-- Energy -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}">
                                <Run Text="Energy" />
                                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[kV]" />
                            </TextBlock>

                            <controls:XccTextBox 
                                Grid.Row="2"
                                IsReadOnly="True"
                                Text="{Binding TreatmentInfoStore.Prescription.Energy, Converter={convx:EnumValueToDisplayNameConverter}}"/>
                        </Grid>

                        <!-- TDF -->
                        <Grid Grid.Column="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}" Text="TDF" />
                            <controls:XccTextBox 
                                Grid.Row="2"
                                IsReadOnly="True"
                                Text="{Binding TreatmentInfoStore.Prescription.Tdf, Converter={convx:EnumValueToDisplayNameConverter}}"/>
                        </Grid>

                        <!-- Dose Per Fx -->
                        <Grid Grid.Column="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}">
                                <Run Text="Dose Per Fx" />
                                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[cGy]" />
                            </TextBlock>
                            <controls:XccTextBox 
                                Grid.Row="2"
                                IsReadOnly="True"
                                Name="DosePerFxTextBox"
                                Text="{Binding TreatmentInfoStore.Prescription.DailyDose, Converter={convx:DoubleToPersistantStringConverter}}"
                                Watermark="0.00" />
                        </Grid>

                        <!-- Total Dose -->
                        <Grid Grid.Column="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}">
                                <Run Text="Total Dose" />
                                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[cGy]" />
                            </TextBlock>
                            <controls:XccTextBox 
                                Grid.Row="2"
                                Text="{Binding TreatmentInfoStore.Prescription.TotalDose}"
                                IsReadOnly="True" />
                        </Grid>

                        <!-- Duration -->
                        <Grid Grid.Column="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}">
                                <Run Text="Duration" />
                                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[s]" />
                            </TextBlock>
                            <controls:XccTextBox Grid.Row="2" Text="{Binding TreatmentInfoStore.Prescription.DwellTime}" IsReadOnly="True"/>
                        </Grid>

                        <!-- Actual Dose -->
                        <Grid Grid.Column="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}" />
                                <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}">
                                <Run Text="Actual Dose" />
                                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[cGy]" />
                            </TextBlock>
                            <controls:XccTextBox 
                                Grid.Row="2"
                                Text="{Binding ActualDose}"
                                IsReadOnly="True" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
