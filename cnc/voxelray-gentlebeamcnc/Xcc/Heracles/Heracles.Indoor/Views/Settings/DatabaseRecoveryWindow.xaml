<Window x:Class="Heracles.Indoor.Views.Settings.DatabaseRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
        Style="{StaticResource WindowDefaultStyle}"
        Title="Database recovery" Width="850" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ApplicationBackgroundColor}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockErrorStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" Style="{StaticResource TextBlockLegendStyle}" FontSize="{StaticResource HugeFontSize}" Margin="0,0,0,16" />
        <TextBlock x:Name="Instructions" Style="{StaticResource TextBlockLegendStyle}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,20" />
        <TextBlock Text="MEK recovery key" Style="{StaticResource TextBlockLegendStyle}" Margin="0,0,0,8" />
        <controls:XccTextBox x:Name="RecoveryKeyBox" FontFamily="Consolas" FontSize="18" Padding="8"
                             AutomationProperties.Name="MEK recovery key" SpellCheck.IsEnabled="False" IsUndoEnabled="False" />
        <TextBlock x:Name="ValidationMessage" Style="{StaticResource TextBlockErrorStyle}" Margin="0,12,0,8" />
        <CheckBox x:Name="Acknowledgement" Content="I have saved this recovery key" Margin="0,8,0,16"
                  Checked="AcknowledgementChanged" Unchecked="AcknowledgementChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="130" Height="42" Margin="0,0,12,0" IsCancel="True" Click="CancelClicked" />
            <Button x:Name="ContinueButton" Width="130" Height="42" IsDefault="True" Click="ContinueClicked" />
        </StackPanel>
    </StackPanel>
</Window>
