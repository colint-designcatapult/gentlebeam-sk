<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="UcsiBackgroundColor">#10191E</Color>
    <Color x:Key="UcsiPanelColor">#19262D</Color>
    <Color x:Key="UcsiPanelAlternateColor">#22323A</Color>
    <Color x:Key="UcsiBorderColor">#41545E</Color>
    <Color x:Key="UcsiTextColor">#E8EEF2</Color>
    <Color x:Key="UcsiMutedTextColor">#9EADB5</Color>
    <Color x:Key="UcsiAccentColor">#42BFD0</Color>
    <Color x:Key="UcsiGoodColor">#72C98D</Color>
    <Color x:Key="UcsiWarningColor">#F0B44D</Color>
    <Color x:Key="UcsiFaultColor">#E56B6F</Color>

    <SolidColorBrush x:Key="UcsiBackgroundBrush" Color="{StaticResource UcsiBackgroundColor}"/>
    <SolidColorBrush x:Key="UcsiPanelBrush" Color="{StaticResource UcsiPanelColor}"/>
    <SolidColorBrush x:Key="UcsiPanelAlternateBrush" Color="{StaticResource UcsiPanelAlternateColor}"/>
    <SolidColorBrush x:Key="UcsiBorderBrush" Color="{StaticResource UcsiBorderColor}"/>
    <SolidColorBrush x:Key="UcsiTextBrush" Color="{StaticResource UcsiTextColor}"/>
    <SolidColorBrush x:Key="UcsiMutedTextBrush" Color="{StaticResource UcsiMutedTextColor}"/>
    <SolidColorBrush x:Key="UcsiAccentBrush" Color="{StaticResource UcsiAccentColor}"/>
    <SolidColorBrush x:Key="UcsiGoodBrush" Color="{StaticResource UcsiGoodColor}"/>
    <SolidColorBrush x:Key="UcsiWarningBrush" Color="{StaticResource UcsiWarningColor}"/>
    <SolidColorBrush x:Key="UcsiFaultBrush" Color="{StaticResource UcsiFaultColor}"/>

    <Style x:Key="UcsiPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UcsiPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style x:Key="UcsiPopupBorderStyle" TargetType="Border" BasedOn="{StaticResource UcsiPanelBorderStyle}">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UcsiButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UcsiAccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource UcsiAccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UcsiCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource UcsiButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="UcsiGraphNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource UcsiCompactButtonStyle}">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>

    <Style x:Key="UcsiCompactToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinWidth" Value="64"/>
    </Style>

    <Style x:Key="UcsiGraphTitleStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UcsiSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UcsiAccentBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="10,8,10,5"/>
    </Style>

    <Style x:Key="UcsiTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource UcsiTextBrush}"/>
    </Style>

    <Style x:Key="UcsiValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="UcsiTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="UcsiTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource UcsiMutedTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource UcsiPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource UcsiAccentBrush}"/>
                            <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
