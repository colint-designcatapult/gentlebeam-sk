<UserControl x:Class="Heracles.Ucsi.Views.UnifiedCalibrationServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:Heracles.Ucsi.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource UcsiBackgroundBrush}"
             Foreground="{DynamicResource UcsiTextBrush}"
             MinWidth="900" MinHeight="620">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Heracles.Ucsi;component/Resources/UcsiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource UcsiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource UcsiPanelBrush}" BorderBrush="{StaticResource UcsiBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unified Calibration &amp; Service Interface" FontSize="20" FontWeight="SemiBold"/>
                    <Border Margin="14,0,0,0" Padding="9,3" CornerRadius="2" Background="{StaticResource UcsiPanelAlternateBrush}">
                        <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource UcsiAccentBrush}" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding TransportText}" Margin="10,0,0,0" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Foreground="{StaticResource UcsiFaultBrush}"
                           MaxWidth="650" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8,4,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" MinHeight="260"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="0.8*" MinHeight="280"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.82*" MinWidth="250"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1.5*" MinWidth="320"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="0.8*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource UcsiPanelBorderStyle}">
                        <Grid Margin="10">
                            <Viewbox Stretch="Uniform">
                                <Border Width="300" Height="300" Background="#0A1014" BorderBrush="{StaticResource UcsiBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Line X1="0" Y1="0" X2="300" Y2="300" Stroke="#283B45" StrokeThickness="1"/>
                                        <Line X1="300" Y1="0" X2="0" Y2="300" Stroke="#283B45" StrokeThickness="1"/>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="17">
                                            <Run Text="Teledyne DALSA"/><LineBreak/>
                                            <Run Text="X-Ray Display"/><LineBreak/>
                                            <Run Text="Placeholder"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource UcsiBorderBrush}"/>

                    <Border Grid.Column="2" Style="{StaticResource UcsiPanelBorderStyle}">
                        <TabControl Style="{StaticResource UcsiTabControlStyle}" ItemContainerStyle="{StaticResource UcsiTabItemStyle}" Margin="6">
                            
                            <!-- System Status Tab -->
                            <TabItem Header="System Status">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="System Status" Style="{StaticResource UcsiSectionTitleStyle}"/>
                                        <Grid Margin="10,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Connection" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding ConnectionText}"/>
                                            <TextBlock Grid.Row="1" Text="Control state" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemStateText}"/>
                                            <TextBlock Grid.Row="2" Text="Runtime" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeText}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Grid.Row="3" Text="Capture rate" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SampleRateText}"/>
                                            <TextBlock Grid.Row="4" Text="GCB firmware" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="v3.0.0 abc123"/>
                                            <TextBlock Grid.Row="5" Text="HVPS firmware" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="v3.0.0 def456"/>
                                            <TextBlock Grid.Row="6" Text="Applicator ID" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,8,0"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentSample.Telemetry.CollimatorSerial, StringFormat={}0x{0:X}}" Style="{StaticResource UcsiValueTextStyle}"/>
                                        </Grid>
                                        <Separator Margin="10" Background="{StaticResource UcsiBorderBrush}"/>
                                        <TextBlock Text="HVPS &amp; Beam" Style="{StaticResource UcsiSectionTitleStyle}"/>
                                        <UniformGrid Columns="2" Margin="10,0,10,8">
                                            <TextBlock Text="kV feedback" Foreground="{StaticResource UcsiMutedTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentSample.Telemetry.KvFeedback, StringFormat={}{0:F2} kV}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Text="Emission" Foreground="{StaticResource UcsiMutedTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentSample.Telemetry.EmissionCurrent, StringFormat={}{0:F3} mA}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Text="Heater feedback" Foreground="{StaticResource UcsiMutedTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentSample.Telemetry.HeaterCurrentFeedback, StringFormat={}{0:F3} A}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Text="Grid voltage" Foreground="{StaticResource UcsiMutedTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentSample.Telemetry.GridVoltage, StringFormat={}{0:F1} V}" Style="{StaticResource UcsiValueTextStyle}"/>
                                        </UniformGrid>
                                        <TextBlock Text="Coils" Style="{StaticResource UcsiSectionTitleStyle}"/>
                                        <UniformGrid Columns="2" Margin="10,0,10,8">
                                            <TextBlock Text="X coil" Foreground="{StaticResource UcsiMutedTextBrush}"/><TextBlock Text="{Binding CurrentSample.Telemetry.XCoilCurrent, StringFormat={}{0:F3} A}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Text="Y coil" Foreground="{StaticResource UcsiMutedTextBrush}"/><TextBlock Text="{Binding CurrentSample.Telemetry.YCoilCurrent, StringFormat={}{0:F3} A}" Style="{StaticResource UcsiValueTextStyle}"/>
                                            <TextBlock Text="Focus coil" Foreground="{StaticResource UcsiMutedTextBrush}"/><TextBlock Text="{Binding CurrentSample.Telemetry.FocusCurrent, StringFormat={}{0:F3} A}" Style="{StaticResource UcsiValueTextStyle}"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- HVPS Tab -->
                            <TabItem Header="HVPS">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <!-- All 5 sliders in one row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Group 1: HV, e-, Power -->
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#1FFFFFFF" CornerRadius="4" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="200"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- HV [kV] - Enabled only when Power > 0 -->
                                                    <TextBlock Grid.Column="0" Text="HV [kV]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="100" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Slider x:Name="HvCommandSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding HvpsCommandHV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180" IsEnabled="{Binding IsHvEnabled}" Opacity="{Binding HvCommandSliderOpacity}"
                                                                TickPlacement="BottomRight" TickFrequency="10" PreviewMouseLeftButtonUp="OnHvCommandSliderReleased"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>

                                                    <!-- e- [mA] - Read Only (Derived) -->
                                                    <TextBlock Grid.Column="1" Text="e- [mA]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="4.0" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Slider Orientation="Vertical" Minimum="0" Maximum="4" Value="{Binding HvpsCommandEmission, Mode=OneWay}" Width="30" Height="180" IsEnabled="False" Opacity="0.6"
                                                                TickPlacement="BottomRight" TickFrequency="0.4"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>

                                                    <!-- Power [W] - User Editable (Set First) -->
                                                    <TextBlock Grid.Column="2" Text="Power [W]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="400" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Slider x:Name="PowerCommandSlider" Orientation="Vertical" Minimum="0" Maximum="400" Value="{Binding HvpsCommandPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                TickPlacement="BottomRight" TickFrequency="50" PreviewMouseLeftButtonUp="OnPowerCommandSliderReleased"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Grid.Row="2" Text="0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Group 2: Grid, Heat -->
                                            <Border Grid.Column="4" Grid.ColumnSpan="2" Background="#1FFFFFFF" CornerRadius="4" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="200"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Grid [V] -->
                                                    <TextBlock Grid.Column="0" Text="Grid [V]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="600" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Slider x:Name="GridCommandSlider" Orientation="Vertical" Minimum="0" Maximum="600" Value="{Binding HvpsCommandGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                TickPlacement="BottomRight" TickFrequency="50" PreviewMouseLeftButtonUp="OnGridCommandSliderReleased"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>

                                                    <!-- Heat [mA] -->
                                                    <TextBlock Grid.Column="1" Text="Heat [mA]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="4000" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        <Slider x:Name="HeatCommandSlider" Orientation="Vertical" Minimum="0" Maximum="4000" Value="{Binding HvpsCommandHeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                TickPlacement="BottomRight" TickFrequency="500" PreviewMouseLeftButtonUp="OnHeatCommandSliderReleased"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Values Grid: Command / SP / FB -->
                                        <Separator Margin="0,12,0,12" Background="{StaticResource UcsiBorderBrush}"/>
                                        <Grid Margin="10,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header Row -->
                                            <TextBlock Grid.Column="0" Text="State" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,10,6"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="HV [kV]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="e- [mA]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Power [W]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Grid [V]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Heat [mA]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Command Row -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Command" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="0,0,10,4"/>
                                            <TextBox x:Name="HvCommandTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding HvpsCommandHV, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}" IsEnabled="{Binding IsHvEnabled}" Margin="0,0,6,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" PreviewKeyDown="OnCommandTextBoxPreviewKeyDown" LostFocus="OnHvCommandLostFocus"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HvpsCommandEmission, Mode=OneWay, StringFormat={}{0:F3}}" IsReadOnly="True" Margin="0,0,6,4" Opacity="0.6" Style="{StaticResource UcsiTextBoxStyle}" BorderBrush="{Binding EmissionTextBoxBorder}" BorderThickness="2"/>
                                            <TextBox x:Name="PowerCommandTextBox" Grid.Row="1" Grid.Column="3" Text="{Binding HvpsCommandPower, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}" Margin="0,0,6,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" PreviewKeyDown="OnCommandTextBoxPreviewKeyDown" LostFocus="OnPowerCommandLostFocus"/>
                                            <TextBox x:Name="GridCommandTextBox" Grid.Row="1" Grid.Column="4" Text="{Binding HvpsCommandGrid, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}" Margin="0,0,6,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" PreviewKeyDown="OnCommandTextBoxPreviewKeyDown" LostFocus="OnGridCommandLostFocus"/>
                                            <TextBox x:Name="HeatCommandTextBox" Grid.Row="1" Grid.Column="5" Text="{Binding HvpsCommandHeat, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" Margin="0,0,0,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" PreviewKeyDown="OnCommandTextBoxPreviewKeyDown" LostFocus="OnHeatCommandLostFocus"/>

                                            <!-- SP Row -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center">
                                                <TextBlock Text="SP" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="0,0,6,0"/>
                                                <Button Command="{Binding RefreshSetpointsCommand}"
                                                        ToolTip="Refresh setpoint values from firmware"
                                                        Width="24" Height="24"
                                                        Padding="4" Margin="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        IsEnabled="{Binding RefreshEnabled}">
                                                    <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                                                          Fill="{StaticResource UcsiMutedTextBrush}" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding HvpsSetpointKV, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.KvSetpoint" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding HvpsSetpointEmission, StringFormat={}{0:F3}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="mock.Setpoint.Emission" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding HvpsSetpointPower, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.HvpsPowerSetpoint" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding HvpsSetpointGrid, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.GridSetpoint" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding HvpsSetpointHeat, StringFormat={}{0:F0}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.HeaterCurrentSetpoint" Click="OnEyeButtonClick"/>
                                            </StackPanel>

                                            <!-- FB Row -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="FB" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HvpsFeedbackKV, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.KvFeedback" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HvpsFeedbackEmission, StringFormat={}{0:F3}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.EmissionCurrent" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HvpsFeedbackPower, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.PowerFeedback" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HvpsFeedbackGrid, StringFormat={}{0:F1}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.GridVoltage" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="{Binding HvpsFeedbackHeat, StringFormat={}{0:F0}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                <Button Content="👁" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiMutedTextBrush}" Cursor="Hand" Tag="system.HeaterCurrentFeedback" Click="OnEyeButtonClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    </ScrollViewer>
                                    
                                    <!-- Right panel: Emission, Interlocks, Controls -->
                                    <ScrollViewer Grid.Column="1" Margin="10,10,10,10" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Width="180" VerticalAlignment="Top">
                                        <!-- Emission Button -->
                                        <Button Content="▶ Emission" Foreground="{StaticResource UcsiTextBrush}" Background="{Binding EmissionButtonBrush}" Padding="10,8" Margin="0,0,0,4" FontSize="12" Cursor="Hand" IsEnabled="{Binding CanClickEmission}" Focusable="False" Click="OnEmissionButtonClick"/>

                                        
                                        <!-- Interlocks Section -->
                                        <TextBlock Text="Interlocks" Style="{StaticResource UcsiSectionTitleStyle}" Margin="0,0,0,8"/>
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid Margin="0,2" Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding InterlockHvColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="HV Interlock" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,2" Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding InterlockGridColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Grid Interlock" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,2" Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding InterlockGridWatchdogColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Grid Watchdog" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- State Controls Section -->
                                        <TextBlock Text="State" Style="{StaticResource UcsiSectionTitleStyle}" Margin="0,8,0,8"/>
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid Margin="0,2" Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding WarmingIndicatorColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Warming" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,2" Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding HvRampingIndicatorColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="HV Ramping" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- PID Section -->
                                        <CheckBox Content="PID Enabled" Margin="0,2" Foreground="{StaticResource UcsiMutedTextBrush}" IsChecked="{Binding PidEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        
                                        <!-- Cooling Section -->
                                        <TextBlock Text="Cooling" Style="{StaticResource UcsiSectionTitleStyle}" Margin="0,12,0,8"/>
                                        <StackPanel Margin="0,0,0,8" Opacity="0.5">
                                            <ToggleButton IsEnabled="False" Foreground="{StaticResource UcsiTextBrush}" Background="{StaticResource UcsiPanelAlternateBrush}" Padding="8,6" Margin="0,0,0,6" Cursor="No">
                                                <TextBlock Text="Water Pump (Not Functional)"/>
                                            </ToggleButton>
                                            <ToggleButton IsEnabled="False" Foreground="{StaticResource UcsiTextBrush}" Background="{StaticResource UcsiPanelAlternateBrush}" Padding="8,6" Cursor="No">
                                                <TextBlock Text="Radiator Fan (Not Functional)"/>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- mA Limit Section -->
                                        <TextBlock Text="mA Limit" Style="{StaticResource UcsiSectionTitleStyle}" Margin="0,12,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding MaLimitValue, Mode=TwoWay}" Style="{StaticResource UcsiTextBoxStyle}" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="Set" Padding="8,4" Background="{StaticResource UcsiAccentBrush}" Foreground="{StaticResource UcsiTextBrush}" Cursor="Hand" Click="OnSetMaLimitClick"/>
                                        </Grid>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- Coils Tab -->
                            <TabItem Header="Coils">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <!-- All 3 sliders in one row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- X Coil [-1.5 to 1.5] -->
                                                <Border Grid.Column="0" Background="#1FFFFFFF" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="200"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="X Coil [A]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                            <TextBlock Text="1.5" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <Slider x:Name="XCoilCommandSlider" Orientation="Vertical" Minimum="-1.5" Maximum="1.5" Value="{Binding CoilsCommandXCoil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                    TickPlacement="BottomRight" TickFrequency="0.3" PreviewMouseLeftButtonUp="OnXCoilCommandSliderReleased"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Text="-1.5" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Y Coil [-1.5 to 1.5] -->
                                                <Border Grid.Column="1" Background="#1FFFFFFF" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="200"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="Y Coil [A]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                            <TextBlock Text="1.5" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <Slider x:Name="YCoilCommandSlider" Orientation="Vertical" Minimum="-1.5" Maximum="1.5" Value="{Binding CoilsCommandYCoil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                    TickPlacement="BottomRight" TickFrequency="0.3" PreviewMouseLeftButtonUp="OnYCoilCommandSliderReleased"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Text="-1.5" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Focus [0.0 to 3.0] -->
                                                <Border Grid.Column="2" Background="#1FFFFFFF" CornerRadius="4" Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="200"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="Focus [A]" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,0,0,6"/>
                                                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
                                                            <TextBlock Text="3.0" FontSize="10" Foreground="{StaticResource UcsiMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <Slider x:Name="FocusCommandSlider" Orientation="Vertical" Minimum="0" Maximum="3.0" Value="{Binding CoilsCommandFocus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="180"
                                                                    TickPlacement="BottomRight" TickFrequency="0.3" PreviewMouseLeftButtonUp="OnFocusCommandSliderReleased"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Text="0.0" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource UcsiMutedTextBrush}" Margin="0,4,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Values Grid: Command / FB -->
                                            <Separator Margin="0,12,0,12" Background="{StaticResource UcsiBorderBrush}"/>
                                            <Grid Margin="10,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header Row -->
                                                <TextBlock Grid.Column="0" Text="State" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,10,6"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="X Coil [A]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Y Coil [A]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Focus [A]" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>

                                                <!-- Command Row -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Command" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="0,0,10,4"/>
                                                <TextBox x:Name="CoilsXCommandTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding CoilsCommandXCoil, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}" Margin="0,0,6,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" LostFocus="OnXCoilCommandLostFocus"/>
                                                <TextBox x:Name="CoilsYCommandTextBox" Grid.Row="1" Grid.Column="2" Text="{Binding CoilsCommandYCoil, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}" Margin="0,0,6,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" LostFocus="OnYCoilCommandLostFocus"/>
                                                <TextBox x:Name="CoilsFocusCommandTextBox" Grid.Row="1" Grid.Column="3" Text="{Binding CoilsCommandFocus, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}" Margin="0,0,0,4" Style="{StaticResource UcsiTextBoxStyle}" KeyDown="OnCommandTextBoxKeyDown" LostFocus="OnFocusCommandLostFocus"/>

                                                <!-- FB Row -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="FB" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CoilsFeedbackXCoil, StringFormat={}{0:F3}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CoilsFeedbackYCoil, StringFormat={}{0:F3}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock Text="{Binding CoilsFeedbackFocus, StringFormat={}{0:F3}}" Style="{StaticResource UcsiValueTextStyle}" Margin="0,0,6,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource UcsiBorderBrush}"/>

                    <Border Grid.Column="4" Style="{StaticResource UcsiPanelBorderStyle}">
                        <TabControl Style="{StaticResource UcsiTabControlStyle}" ItemContainerStyle="{StaticResource UcsiTabItemStyle}" Margin="6">
                            <TabItem Header="Interlocks">
                                <ListBox ItemsSource="{Binding Interlocks}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiTextBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{StaticResource UcsiFaultBrush}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource UcsiFaultBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{StaticResource UcsiGoodBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Fill" Value="{StaticResource UcsiMutedTextBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource UcsiMutedTextBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="HVPS Status">
                                <ListBox ItemsSource="{Binding HvpsStates}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiTextBrush}">
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource UcsiAccentBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="Faults">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Margin="6" Content="Clear Faults" Command="{Binding ClearFaultsCommand}"
                                            IsEnabled="{Binding CanClearFaults}" ToolTip="{Binding ClearFaultsToolTip}" Style="{StaticResource UcsiButtonStyle}"/>
                                    <ListBox ItemsSource="{Binding ActiveFaults}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiTextBrush}"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="System Config">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center">
                                        <TextBlock Text="Config" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11" Margin="10,6,6,0"/>
                                        <Button Command="{Binding RefreshSystemConfigCommand}"
                                                ToolTip="Refresh system configuration values from firmware"
                                                Width="24" Height="24"
                                                Padding="4" Margin="0,4,0,0"
                                                Background="Transparent" BorderThickness="0"
                                                IsEnabled="{Binding ConfigEditingEnabled}">
                                            <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                                                  Fill="{StaticResource UcsiMutedTextBrush}" Stretch="Uniform" />
                                        </Button>
                                        <TextBlock Text="No USB UART Connection" Margin="10,6,0,0" Foreground="{StaticResource UcsiFaultBrush}" FontSize="11"
                                                   Visibility="{Binding HvpsNotConnected, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                                        <ItemsControl ItemsSource="{Binding ConfigItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,4" Height="28">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource UcsiMutedTextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CurrentValue, StringFormat={}{0:F1}}" Foreground="{StaticResource UcsiAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        <TextBox Grid.Column="2" Text="{Binding InputValue, Mode=TwoWay}" Style="{StaticResource UcsiTextBoxStyle}" Margin="4,2,4,2" KeyDown="OnSystemConfigTextBoxKeyDown"/>
                                                        <Button Grid.Column="3" Content="Set" Padding="8,4" Command="{Binding SetCommand}" Background="{StaticResource UcsiAccentBrush}" Foreground="{StaticResource UcsiTextBrush}" Cursor="Hand" Margin="0,0,4,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource UcsiBorderBrush}"/>

                <Border Grid.Row="2" Style="{StaticResource UcsiPanelBorderStyle}">
                    <TabControl Style="{StaticResource UcsiTabControlStyle}" ItemContainerStyle="{StaticResource UcsiTabItemStyle}" Margin="6">
                        <TabItem Header="Graphs">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Button Content="Add Graph" Command="{Binding AddGraphCommand}" Style="{StaticResource UcsiCompactButtonStyle}" HorizontalAlignment="Left" Margin="4,6"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Graphs}">
                                        <ItemsControl.ItemTemplate><DataTemplate><views:GraphPaneView/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Logs">
                            <Grid>
                                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          Background="{StaticResource UcsiBackgroundBrush}" Foreground="{StaticResource UcsiTextBrush}" BorderThickness="0">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="{StaticResource UcsiBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource UcsiMutedTextBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource UcsiBorderBrush}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="{StaticResource UcsiBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource UcsiPanelAlternateBrush}"/>
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="130"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Type}" Width="120"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,32,16,0">
                                    <Button Content="Export Logs" Command="{Binding SaveLogsCommand}" Style="{StaticResource UcsiCompactButtonStyle}" 
                                            Padding="12,5" ToolTip="Save all logs to text file"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource UcsiBorderBrush}"/>

            <Border Grid.Column="2" Style="{StaticResource UcsiPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Monitored Parameters" Style="{StaticResource UcsiSectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="ParameterButton" Grid.Column="1" Content="Configure" Style="{StaticResource UcsiCompactToggleButtonStyle}"/>
                        <Popup x:Name="ParameterPopup" PlacementTarget="{Binding ElementName=ParameterButton}" Placement="Bottom" StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=ParameterButton}">
                            <Border Width="350" MaxHeight="520" Style="{StaticResource UcsiPopupBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox Margin="8" Text="{Binding ParameterFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search all telemetry parameters"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ParameterView}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="7,3"><StackPanel><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding Group}" FontSize="10" Opacity="0.65"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="2" Content="Apply" Margin="8" Command="{Binding ApplyMonitoredSelectionCommand}" Click="OnApplyMonitoredParametersClick" Style="{StaticResource UcsiCompactButtonStyle}"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{Binding MonitoredParameters}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource UcsiTextBrush}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{StaticResource UcsiTextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Parameter" Width="190" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Value" Width="105" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="Unit" Width="50" DisplayMemberBinding="{Binding Unit}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource UcsiPanelBrush}" BorderBrush="{StaticResource UcsiBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding RecordButtonText}" Command="{Binding RecordCommand}" Style="{StaticResource UcsiButtonStyle}"/>
                <Button Grid.Column="1" Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource UcsiButtonStyle}" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="{Binding PlayPauseButtonText}" Command="{Binding PlayPauseCommand}" Style="{StaticResource UcsiButtonStyle}" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Content="Return to Live" Command="{Binding ReturnToLiveCommand}" Style="{StaticResource UcsiButtonStyle}" Margin="8,0,12,0"/>
                <StackPanel Grid.Column="4" Margin="6,0,12,0">
                    <Slider Minimum="0" Maximum="{Binding TimelineMaximumSeconds}" Value="{Binding TimelineSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsReplay}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RecordingCountText}" Foreground="{StaticResource UcsiMutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding TimelineText}" Style="{StaticResource UcsiValueTextStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="6" Content="Export to CSV" Command="{Binding ExportSessionDataCommand}" Style="{StaticResource UcsiButtonStyle}" Margin="8,0,0,0" ToolTip="Export last 5 minutes of session data as CSV"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
