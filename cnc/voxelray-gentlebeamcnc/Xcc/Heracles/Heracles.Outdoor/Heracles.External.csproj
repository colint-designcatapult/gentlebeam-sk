<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AssemblyVersion>1.1.21</AssemblyVersion>
    <BuildNumber>0</BuildNumber>
    <InformationalVersion>$(AssemblyVersion) SP $(BuildNumber) </InformationalVersion>
    <ApplicationIcon>Heracles.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Heracles.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Xcc.Shared\Xcc.Shared.csproj" />
    <ProjectReference Include="..\Heracles.Application\Heracles.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\PatientProfileView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\QualityCheck\QaTabsView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\QualityCheck\BeamQaSelectorView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local-dual.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\GryphonBoard\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
  </ItemGroup>

</Project>
