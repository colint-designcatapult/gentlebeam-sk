<UserControl 
    x:Class="Heracles.External.Views.QualityCheck.SafetyCheckReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    
    xmlns:local="clr-namespace:Heracles.External.Views.QualityCheck"
    xmlns:viewmodels="clr-namespace:Heracles.External.ViewModels.QualityCheck" 
    
    xmlns:prism="http://prismlibrary.com/" 
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    mc:Ignorable="d" 
    d:DesignHeight="720" d:DesignWidth="1280"
    d:DataContext="{d:DesignInstance Type=viewmodels:SafetyCheckReportsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <!--SafetyCheck list-->
    <ListView
        Style="{StaticResource TableListView}"
        Tag="{StaticResource SafetyCheckReportListHeaderTemplate}"
        ItemTemplate="{StaticResource SafetyCheckReportListItemTemplate}"
        SelectedItem="{Binding SafetyCheckModel.SelectedSafetyCheck}"
        ItemsSource="{Binding CollectionViewSource.View}"/>
</UserControl>
