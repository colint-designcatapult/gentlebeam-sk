<UserControl 
    x:Class="Heracles.External.Views.TreatmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    
    xmlns:views="clr-namespace:Heracles.External.Views"
    xmlns:viewModels="clr-namespace:Heracles.External.ViewModels" 
    
    xmlns:uc="clr-namespace:Heracles.Application.UI.UserControls;assembly=Heracles.Application"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:conv2="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:sharedHeraclesViews="clr-namespace:Heracles.Application.UI.Views;assembly=Heracles.Application"
    xmlns:enums2="clr-namespace:Heracles.External.Models"
    xmlns:viewsx="clr-namespace:Xcc.Application.Views;assembly=Xcc.Application"

    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    UseLayoutRounding="True"
    
    mc:Ignorable="d" 
    d:FontFamily="{StaticResource BaseFont}"
    d:FontSize="{StaticResource BaseFontSize}"
    d:DesignHeight="1080" d:DesignWidth="1920"
    d:DataContext="{d:DesignInstance Type=viewModels:TreatmentViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Border/BorderOutlineStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonDefaultStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonToolbarStyle.xaml" />


                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/TabControlMainIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;component/Styles/ProgressBar/ProgressBarXRayStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource ButtonDefaultStyle}">
                <Setter Property="FontSize" Value="{StaticResource LargeFontSize}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource BorderOutlineStyle}">
            <Grid Margin="{StaticResource ViewMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4.2*"/>
                    <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                    <RowDefinition Height="{StaticResource XRayButtonHeightGridLength}"/>
                    <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/> <!--Applicator-->
                    <ColumnDefinition Width="0"/> <!--Applicator-->
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="{StaticResource BlockMarginGridLength}"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <viewsx:TelemetryView Grid.ColumnSpan="5" IsTabStop="False"/>

                <!--Target mismatch message-->
                <ucx:XccWarningLabel
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                    Margin="{StaticResource BlockContentSmallMarginTopBottom}"
                    Text="{Binding ApplicatorCompatibilityStatus.CompatibilityMessage}"
                    FontSize="{StaticResource BaseFontSize}"
                    Visibility="{Binding ApplicatorCompatibilityStatus.IsCompatible, Converter={conv2:BooleanToInvisibilityConverter Invisibility=Hidden}}"/>

                <ListView
                    Grid.Column="2" Grid.Row="2"
                    Style="{StaticResource TableListView}"
                    Tag="{StaticResource ActualFieldsListHeaderTemplate}"
                    ItemTemplate="{StaticResource ActualFieldsListItemTemplate}"
                    ItemsSource="{Binding TreatmentFieldsViewSource.View}"
                    SelectedItem="{Binding PlanModel.SelectedTreatmentField}"
                    IsHitTestVisible="False"/>

                <!--X-Ray control buttons-->
                <Border
                    x:Name="ButtonsBlock"
                    Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                    Style="{StaticResource BorderBlockStyle}">

                    <Grid Margin="{StaticResource BlockContentMargin}" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource XRayButtonGridLength}"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="{StaticResource XRayButtonGridLength}"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="{StaticResource XRayButtonGridLength}"/>
                        </Grid.ColumnDefinitions>

                        <!--Prepare buttons group-->
                        <Grid Grid.Column="0">
                            <!--'Prepare' button-->
                            <Button 
                                Command="{Binding PrepareCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.LeftButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.LeftButton.State, 
                                    Converter={conv2:IntToVisibilityVisibleConverter}, 
                                    ConverterParameter={x:Static enums2:UILeftButtonState.Prepare}}">

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid>
                                            <Path 
                                                Data="{StaticResource PrepareIconPath}" 
                                                Style="{StaticResource XRayButtonsIconStyle}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeLineJoin="Round"/>
                                            <Path 
                                                Data="{StaticResource LightningIconPath}"
                                                Style="{StaticResource XRayButtonsIconStyle}"
                                                Height="24"
                                                StrokeThickness="0"
                                                StrokeLineJoin="Round"
                                                Fill="White"/>
                                        </Grid>
                                        <TextBlock Text="Prepare" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <ProgressBar 
                                Style="{StaticResource ProgressBarXRayStyle}" 
                                Background="CornflowerBlue" 
                                Maximum="100" Minimum="0"
                                Value="{Binding GcbIndicators.WarmUpProgress.Value, Mode=OneWay}"
                                Tag="Warming Up"
                                IsEnabled="{Binding UIStateMachine.LeftButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.LeftButton.State, 
                                    Converter={conv2:IntToVisibilityVisibleConverter}, 
                                    ConverterParameter={x:Static enums2:UILeftButtonState.WarmUpProgress}}"/>

                            <!--'Clear Plan' button-->
                            <Button 
                                Command="{Binding ClearPlanCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.LeftButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.LeftButton.State, Converter={conv2:IntToVisibilityVisibleConverter}, ConverterParameter={x:Static enums2:UILeftButtonState.ClearPlan}}">

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid>
                                            <Path 
                                                Data="{StaticResource PrepareIconPath}" 
                                                Style="{StaticResource XRayButtonsIconStyle}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeLineJoin="Round"/>
                                            <Path 
                                                Data="{StaticResource LightningIconPath}"
                                                Style="{StaticResource XRayButtonsIconStyle}"
                                                Height="24"
                                                StrokeThickness="0"
                                                StrokeLineJoin="Round"
                                                Fill="{StaticResource ButtonStrokeBrush}"/>
                                        </Grid>
                                        <TextBlock Text="Clear Plan" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <ProgressBar 
                                    Style="{StaticResource ProgressBarXRayStyle}" 
                                    Background="CornflowerBlue" 
                                    Minimum="0" Maximum="100"                                    
                                    Value="{Binding GcbIndicators.HVSetupProgress.Value}"
                                    Tag="Loading"
                                    IsEnabled="{Binding UIStateMachine.LeftButton.IsEnabled}"
                                    Visibility="{Binding UIStateMachine.LeftButton.State, 
                                        Converter={conv2:IntToVisibilityVisibleConverter}, 
                                        ConverterParameter={x:Static enums2:UILeftButtonState.LoadingProgress}}"/>
                        </Grid>

                        <!--Beam On buttons group-->
                        <Grid Grid.Column="2">
                            <!--'Beam On' button-->
                            <Button 
                                Background="{StaticResource StartButtonBackgroundBrush}"
                                Command="{Binding BeamOnCommand}"
                                IsEnabled="{Binding UIStateMachine.CentralButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.CentralButton.State, 
                                Converter={conv2:IntToVisibilityVisibleConverter}, 
                                ConverterParameter={x:Static enums2:UICentralButtonState.BeamOn}}">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path 
                                        Data="{StaticResource TreatmentIcon}" 
                                        Style="{StaticResource XRayButtonsIconStyle}"/>
                                    <TextBlock Text="Beam On" Style="{StaticResource TextBlockButtonStyle}"/>
                                </StackPanel>

                            </Button>

                            <Border Background="{StaticResource ButtonBackgroundColor}" CornerRadius="{StaticResource BlockCornerRadius}"
                                    IsEnabled="{Binding UIStateMachine.CentralButton.IsEnabled}"
                                    Visibility="{Binding UIStateMachine.CentralButton.State, 
                                        Converter={conv2:IntToVisibilityVisibleConverter}, 
                                        ConverterParameter={x:Static enums2:UICentralButtonState.EmissionProgress}}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <ProgressBar 
                                        Margin="4,4,4,4"
                                        Style="{StaticResource ProgressBarXRayStyle}" 
                                        Maximum="100" Minimum="0"
                                        Value="{Binding GcbIndicators.LaunchingProgress.Value}" 
                                        Background="CornflowerBlue"
                                        Tag="Launching"/>

                                    <ProgressBar 
                                        Grid.Row="1"
                                        Margin="4,4,4,4"
                                        Style="{StaticResource ProgressBarXRayStyle}" 
                                        Maximum="100" Minimum="0"
                                        Background="Gold"
                                        Value="{Binding GcbIndicators.BeamOnProgress.Value}" 
                                        Tag="Beaming-On"/>
                                </Grid>
                            </Border>
                            <!--CURRENT_CONTROL-->

                            <!--'Reset Timers' button-->
                            <Button 
                                Command="{Binding ResetTimersCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.CentralButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.CentralButton.State, 
                                    Converter={conv2:IntToVisibilityVisibleConverter}, 
                                    ConverterParameter={x:Static enums2:UICentralButtonState.ResetTimers}}">

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path 
                                            Data="{StaticResource RefreshIcon3}" 
                                            Style="{StaticResource XRayButtonsIconStyle}"/>
                                        <TextBlock Text="Reset&#10;Timers" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!--'Clear Errors' button-->
                            <Button 
                                Command="{Binding ClearErrorsCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.CentralButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.CentralButton.State, 
                                    Converter={conv2:IntToVisibilityVisibleConverter}, 
                                    ConverterParameter={x:Static enums2:UICentralButtonState.ClearErrors}}">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid>
                                        <Path 
                                            Data="{StaticResource RefreshIcon3}" 
                                            Style="{StaticResource XRayButtonsIconStyle}"/>
                                        <Path 
                                            Data="{StaticResource CancelIconPath}"
                                            Style="{StaticResource XRayButtonsIconStyle}"
                                            Height="10"
                                            StrokeThickness="2"
                                            Stroke="Red"
                                            StrokeEndLineCap="Square"
                                            StrokeStartLineCap="Square"/>
                                    </Grid>
                                    <TextBlock Text="Clear&#10;Errors" Style="{StaticResource TextBlockButtonStyle}"/>
                                </StackPanel>
                            </Button>
                            
                        </Grid>

                        <!--Stop buttons group-->
                        <Grid Grid.Column="4">
                            <!--Stop-->
                            <Button 
                                Background="{StaticResource StopButtonBackgroundBrush}"
                                Command="{Binding StopCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.RightButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.RightButton.State, 
                                    Converter={conv2:IntToVisibilityVisibleConverter}, 
                                    ConverterParameter={x:Static enums2:UIRightButtonState.Stop}}">

                                <Grid Margin="0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource StopEmissionSequenceIcon}" Style="{StaticResource XRayButtonsIconStyle}"/>
                                        <TextBlock Text="Stop" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!--'Resume' button-->
                            <Button 
                                Command="{Binding ResumeCommand}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsEnabled="{Binding UIStateMachine.RightButton.IsEnabled}"
                                Visibility="{Binding UIStateMachine.RightButton.State, 
                                Converter={conv2:IntToVisibilityVisibleConverter}, 
                                ConverterParameter={x:Static enums2:UIRightButtonState.Resume}}">

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path 
                                            Data="{StaticResource RefreshIcon3}" 
                                            Style="{StaticResource XRayButtonsIconStyle}">

                                            <Path.LayoutTransform>
                                                <ScaleTransform ScaleX="-1"></ScaleTransform>
                                            </Path.LayoutTransform>
                                        </Path>
                                        <TextBlock Text="Resume" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!--Patient profile and camera-->
                <Grid Grid.Column="4" Grid.Row="2" Grid.RowSpan="3" DockPanel.Dock="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource BlockMarginGridLength}"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <views:PatientProfileView 
                        d:DataContext="{d:DesignInstance viewModels:PatientProfileViewModel, IsDesignTimeCreatable=True}"/>

                    <ucx:VideoLiveFeedControl 
                        Grid.Row="2"
                        UriSource="{Binding HeraclesExternalSettings.CameraUriSource}"
                        ControlPanelVisibility="Collapsed"/>
                </Grid>

                <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" IsEnabled="{Binding CommonProperties.IsInSafeState}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <sharedHeraclesViews:InterlocksView HorizontalAlignment="Center"/>

                    <Button 
                        Grid.Column="1"
                        Width="{StaticResource ButtonHeight}" Height="{StaticResource ButtonHeight}" 
                        Margin="{StaticResource BlockContentMarginLeft}"
                        Command="{Binding GetFaultsCommand}"
                        Style="{StaticResource ButtonToolbarStyle}"
                        ToolTip="Show Faults"
                        Visibility="{Binding UIStateMachine.CentralButton.State, 
                            Converter={conv2:IntToVisibilityVisibleConverter}, 
                            ConverterParameter={x:Static enums2:UICentralButtonState.ClearErrors}}">

                        <Image Source="{StaticResource FaultsIcon36x36}" Style="{StaticResource ButtonImageStyle}"/>
                    </Button>

                    <Button 
                        Grid.Column="2"
                        Width="{StaticResource ButtonHeight}" Height="{StaticResource ButtonHeight}" 
                        Margin="{StaticResource BlockContentMarginLeft}"
                        Command="{Binding ShowInterlocksCommand}"
                        Style="{StaticResource ButtonToolbarStyle}"
                        ToolTip="Show Interlocks">

                        <Image Source="{StaticResource InterlocksIcon36x36}" Style="{StaticResource ButtonImageStyle}"/>
                    </Button>

                    <Button 
                        Grid.Column="3"
                        Width="{StaticResource ButtonHeight}" Height="{StaticResource ButtonHeight}" 
                        Margin="{StaticResource BlockContentMarginLeft}"
                        Command="{Binding ShowDetailedTelemetryCommand}"
                        Style="{StaticResource ButtonToolbarStyle}">

                        <Image Source="{StaticResource ServiceIcon36x36}" Style="{StaticResource ButtonImageStyle}"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <ucx:TaskOverlay 
            Grid.RowSpan="2" Grid.ColumnSpan="3"
            Visibility="{Binding CurrentTask.IsSuccessfullyCompleted, Converter={conv2:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
            ObservedTask="{Binding CurrentTask}"
            RetryCommand="{Binding CurrentTaskCommand}"
            CancelCommand="{Binding CancelCurrentTaskCommand}"
            Description="{Binding CurrentTask.ErrorMessage}"
            CornerRadius="7,7,7,7"/>
    </Grid>
</UserControl>
