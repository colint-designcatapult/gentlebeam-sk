<ContentControl 
    x:Class="Heracles.External.Views.FaultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:prism="http://prismlibrary.com/"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Heracles.External.Views" 
    xmlns:system="clr-namespace:System;assembly=netstandard" 
                
    xmlns:enums="clr-namespace:Heracles.Application.Enums;assembly=Heracles.Application"
    xmlns:enumsx="clr-namespace:Xcc.Core.Enums;assembly=Xcc.Core"
    xmlns:conv1="clr-namespace:Heracles.Application.UI.Converters;assembly=Heracles.Application"
    xmlns:conv2="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application" 
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:muc="clr-namespace:Heracles.Application.UI.UserControls;assembly=Heracles.Application"
    prism:ViewModelLocator.AutoWireViewModel="True" 
                
    xmlns:viewModels="clr-namespace:Heracles.External.ViewModels"
    xmlns:sharedViews="clr-namespace:Xcc.Shared.Views;assembly=Xcc.Shared"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    FontSize="{StaticResource BaseFontSize}"
    
    mc:Ignorable="d" 
    d:Width="720"
    d:DataContext="{d:DesignInstance {x:Type viewModels:FaultsViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/TabControlMainIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/TabControlMainStyle.xaml" />
                
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Heracles.Application;Component/UI/Resources/ListViewTemplates.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonDefaultStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonToolbarStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="1000"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderColor1}" Style="{StaticResource BorderBlockStyle}">
        <Grid Margin="{StaticResource BlockContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <!--Header-->
            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource BlockContentSmallMarginLength}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl Content="{StaticResource DialogErrorIcon}"/>

                <!--Header-->
                <ContentControl 
                    Grid.Column="2" 
                    FontWeight="SemiBold"
                    FontSize="{StaticResource HugeFontSize}"
                    Style="{StaticResource ContentTextWithShadowStyle}" 
                    Content="System Faults"/>
            </Grid>
        
            <!--Fault List-->
            <ListView 
                Grid.Row="2"
                x:Name="FaultListView"
                Style="{StaticResource TableListView}"
                ItemsSource="{Binding Faults}"
                Tag="{StaticResource SystemFaultListHeaderTemplate}"
                ItemTemplate="{StaticResource SystemFaultListItemTemplate}"/>

            <controls:XccTextBox 
                Grid.Row="4"
                Height="224"
                VerticalContentAlignment="Top"
                HorizontalScrollBarVisibility="Visible"
                IsReadOnly="True"
                FontFamily="Consolas"
                
                Text="{Binding SelectedItem, ElementName=FaultListView}"
                Visibility="{Binding SelectedItem, ElementName=FaultListView, Converter={conv2:ObjectToVisibilityConverter}}">
            </controls:XccTextBox>
            
            <!--Buttons-->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <!--'Clear Errors' button-->
                <Button 
                    Command="{Binding ClearErrorsCommand}"
                    Height="{StaticResource ButtonHeight}"
                    x:Name="ButtonClearErrors">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Path 
                                Data="{StaticResource RefreshIcon3}" 
                                Style="{StaticResource XRayButtonsIconStyle}"
                                Height="24" Width="24"/>
                            <Path 
                                Data="{StaticResource CancelIconPath}"
                                Style="{StaticResource XRayButtonsIconStyle}"
                                Height="8"
                                Margin="0,0,0,0"
                                StrokeThickness="2"
                                Stroke="Red"
                                StrokeEndLineCap="Square"
                                StrokeStartLineCap="Square"/>
                        </Grid>

                        <TextBlock Text="Clear Errors" Style="{StaticResource TextBlockButtonStyle}"/>
                    </StackPanel>
                </Button>
                
                <!--'Close' button-->
                <Button 
                    Command="{Binding CloseDialogCommand}"
                    Width="{Binding ActualWidth, ElementName=ButtonClearErrors}"
                    Height="{StaticResource ButtonHeight}"
                    Margin="{StaticResource BlockContentMarginLeft}">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path 
                            Data="{StaticResource ExitIcon}" 
                            Style="{StaticResource XRayButtonsIconStyle}"
                            Width="26" Height="26"/>

                        <TextBlock Text="Close" Style="{StaticResource TextBlockButtonStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>    
</ContentControl>