<Window x:Class="Heracles.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:application="clr-namespace:Xcc.Application.UI;assembly=Xcc.Application"
        Title="{Binding Title}" 
        Background="{StaticResource AppBackgroundColor}"
        Style="{StaticResource BaseStyle}"
        Height="800" Width="1400"
        MinHeight="830" MinWidth="1400"
        Icon="pack://application:,,,/Xcc.Application;Component/UI/Assets/Images/morpheus_6_gray.ico"
        WindowStyle="{Binding WinStyle}"
        WindowState="{Binding WinState}"
        ResizeMode="{Binding WinResizeMode}"
        WindowStartupLocation="CenterScreen" >
    <!--MinHeight="835" MinWidth="1200"
        WindowStyle="None"
        WindowState="Maximized"
        Height="835" Width="1250"-->

    <!--WindowState="Maximized" WindowStyle="None"-->

    <Grid>
        <ContentControl prism:RegionManager.RegionName="{x:Static application:RegionNames.MainRegion}" />
    </Grid>
</Window>
