<sequences>
	<sequence name="Actuators Control Board Check">
		<step id="check_LLP" id_ok="report_LLP" id_failed="check_LLN">
			<!--No robotic motion-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=lock, Proximity=detected</value>
		</step>

		<step id="report_LLP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLP: No robotic motion</value>
		</step>

		<step id="check_LLN" id_ok="report_LLN" id_failed="check_LUP">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=lock, Proximity=not_detected</value>
		</step>

		<step id="report_LLN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLN: Non safe, technical intervention</value>
		</step>

		<step id="check_LUP" id_ok="report_LUP" id_failed="check_LUN">
			<!--Mounted -> resume pick / start release head.-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=detected</value>
		</step>

		<step id="report_LUP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LUP: Mounted -> resume pick / start release head.</value>
		</step>

		<step id="check_LUN" id_ok="report_LUN" id_failed="check_ULP">
			<!--Mounted -> resume pick/ start release head-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=not_detected</value>
		</step>

		<step id="report_LUN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LUN: Mounted -> resume pick / start release head.</value>
		</step>

		<step id="check_ULP" id_ok="report_ULP" id_failed="check_ULN">
			<!--Unmounted -> resume  release / start pick head -->
			<action>Check actuators</action>
			<value>Flange=unlock, Treatment cradle=lock, Proximity=detected</value>
		</step>

		<step id="report_ULP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>ULP: Unmounted -> resume  release / start pick head</value>
		</step>

		<step id="check_ULN" id_ok="report_ULN" id_failed="check_UUP">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Treatment cradle=lock, Proximity=not_detected</value>
		</step>

		<step id="report_ULN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>ULN: Non safe, technical intervention</value>
		</step>

		<step id="check_UUP" id_ok="report_UUP" id_failed="check_UUN">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Treatment cradle=unlock, Proximity=detected</value>
		</step>

		<step id="report_UUP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>UUP: Non safe, technical intervention</value>
		</step>

		<step id="check_UUN" id_ok="report_UUN" id_failed="report_unknown">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Treatment cradle=unlock, Proximity=not_detected</value>
		</step>

		<step id="report_UUN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>UUP: Non safe, technical intervention</value>
		</step>

		<step id="report_unknown" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Unknown: Non safe, technical intervention</value>
		</step>
	</sequence>

	<sequence name="Left User - Pick head">



		<step id="check_LUP" id_ok="translate_pull" id_failed="failure_message">
			<!--Mounted -> resume pick / start release head.-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=detected</value>
		</step>

		<step id="failure_message" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>This action requires that the head will be placed on the cradle</value>
		</step>

		<step id="translate_pull" id_ok="move_to_candle_with_head" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Z, -50</value>
			<!-- -50[mm]-->
		</step>

		<step id="move_to_candle_with_head" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>

	</sequence>

	<sequence name="Left User - Treat">
		<step id="move_to_treatment" id_ok="user_confirm_treatment" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment execution</value>
		</step>
		<step id="user_confirm_treatment" id_ok="set_local_control" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to enable hand guiding and move the robot to teratment position</value>
		</step>
		<step id="set_local_control" id_ok="user_confirm_move_to_execute" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>

		<step id="user_confirm_move_to_execute" id_ok="set_remote_control_to_execute" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to disable hand guiding when ready to load for treatment</value>
		</step>

		<step id="set_remote_control_to_execute" id_ok="stop_ok" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>



		<step id="move_to_candle" id_ok="move_to_treatment" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>

		<step id="check_zone" id_ok="safe_zone" id_failed="unsafe_zone">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
		<step id="safe_zone" id_ok="move_to_candle" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="unsafe_zone" id_ok="ask_user_to_move_to_safe_zone" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>
		<step id="ask_user_to_move_to_safe_zone" id_ok="check_zone" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Please move the Robot to safe zone and press OK</value>
		</step>

		<step id="contact_support_spoc" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Robot failed to gain SPOC - contact support</value>
		</step>
	</sequence>

	<sequence name="Left User - Place head">

		<step id="check_LLP" id_ok="user_confirm_completed_execution" id_failed="report_LLP">
			<!--No robotic motion-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=not_detected</value>
		</step>
		<step id="report_LLP" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLP: No robotic motion</value>
		</step>

		<step id="user_confirm_completed_execution" id_ok="set_local_control_execution_completed" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to enable hand guiding and move the robot to safe position</value>
		</step>

		<step id="set_local_control_execution_completed" id_ok="user_confirm_robot_back_in_safe_position" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>

		<step id="user_confirm_robot_back_in_safe_position" id_ok="set_remote_control_execution_copmleted" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm the robot is in safe position and the treatment head is ready to be placed back</value>
		</step>

		<step id="set_remote_control_execution_copmleted" id_ok="check_zone" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>





		<step id="check_zone" id_ok="safe_zone" id_failed="unsafe_zone">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
		<step id="safe_zone" id_ok="move_to_candle" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="unsafe_zone" id_ok="ask_user_to_move_to_safe_zone" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>
		<step id="ask_user_to_move_to_safe_zone" id_ok="check_zone" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Please move the Robot to safe zone and press OK</value>
		</step>


		<step id="move_to_candle" id_ok="move_above_head" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>
		<step id="move_above_head" id_ok="translate" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Above treatment head - for place</value>
		</step>


		<step id="translate" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Z, 50</value>
		</step>


	</sequence>

	<sequence name="Left User - Place head from QC">

		<step id="check_LLP" id_ok="move_to_candle" id_failed="report_LLP">
			<!--No robotic motion-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=not_detected</value>
		</step>
		<step id="report_LLP" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLP: No robotic motion</value>
		</step>

		<step id="move_to_candle" id_ok="move_above_head" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>
		<step id="move_above_head" id_ok="translate" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Above treatment head - for place</value>
		</step>


		<step id="translate" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Z, 50</value>
		</step>


	</sequence>

	<sequence name ="QC">
		<step id="check_zone" id_ok="safe_zone" id_failed="unsafe_zone">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
		<step id="safe_zone" id_ok="move_to_candle" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="unsafe_zone" id_ok="ask_user_to_move_to_safe_zone" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>
		<step id="ask_user_to_move_to_safe_zone" id_ok="check_zone" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Please move the Robot to safe zone and press OK</value>
		</step>


		<step id="move_to_candle" id_ok="move_to_qc" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>

		<step id="move_to_qc" id_ok="translate_push" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - QC</value>
		</step>

		<step id="translate_push" id_ok="start_qc_check" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Y, 50</value>
		</step>

		<step id="start_qc_check" id_ok="confirm_qc_completed" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>The system is ready to begin quality check of the X-Ray source (start from the external console)</value>
		</step>

		<step id="confirm_qc_completed" id_ok="translate_pull" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Press the foot pedal and confirm once quality check is complete and the robot is ready to place back the head</value>
		</step>

		<step id="translate_pull" id_ok="move_back_to_candle" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Y, -50</value>
		</step>

		<step id="move_back_to_candle" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>


		<!--Recovery-->
		<step id="contact_support_spoc" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Robot failed to gain SPOC - contact support</value>
		</step>

	</sequence>

	<sequence name="Right User - Pick head">
		<step id="check_LUP" id_ok="translate_pull" id_failed="failure_message">
			<!--Mounted -> resume pick / start release head.-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=detected</value>
		</step>

		<step id="failure_message" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>This action requires that the head will be placed on the cradle</value>
		</step>
		
		<step id="translate_pull" id_ok="move_to_candle_with_head_left" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Z, -50</value>
		</step>
		<step id="move_to_candle_with_head_left" id_ok="move_to_left_to_right_prepare" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>
		<step id="move_to_left_to_right_prepare" id_ok="move_to_left_to_right_ready" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left to right - prepare</value>
		</step>
		<step id="move_to_left_to_right_ready" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left_to_right - ready for right</value>
		</step>
	</sequence>

	<sequence name="Right User - Treat">
		<step id="move_to_treatment" id_ok="user_confirm_treatment" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Right User - Treatment execution</value>
		</step>



		<step id="user_confirm_treatment" id_ok="set_local_control" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to enable hand guiding and move the robot to teratment position</value>
		</step>
		<step id="set_local_control" id_ok="user_confirm_move_to_execute" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>

		<step id="user_confirm_move_to_execute" id_ok="set_remote_control_to_execute" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to disable hand guiding when ready to load for treatment</value>
		</step>

		<step id="set_remote_control_to_execute" id_ok="stop_ok" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>


		<step id="move_to_candle" id_ok="move_to_treatment" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Right User - Candle with treatment head</value>
		</step>



		<step id="check_zone" id_ok="safe_zone" id_failed="unsafe_zone">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
		<step id="safe_zone" id_ok="move_to_candle" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="unsafe_zone" id_ok="ask_user_to_move_to_safe_zone" id_failed="contact_support_spoc">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>
		<step id="ask_user_to_move_to_safe_zone" id_ok="check_zone" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Please move the Robot to safe zone and press OK</value>
		</step>

		<step id="contact_support_spoc" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Robot failed to gain SPOC - contact support</value>
		</step>
	</sequence>

	<sequence name="Right User - Place head">
		<step id="check_LLP" id_ok="user_confirm_completed_execution" id_failed="report_LLP">
			<!--No robotic motion-->
			<action>Check actuators</action>
			<value>Flange=lock, Treatment cradle=unlock, Proximity=not_detected</value>
		</step>
		<step id="report_LLP" id_ok="stop_failure" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLP: No robotic motion</value>
		</step>

		<step id="user_confirm_completed_execution" id_ok="set_local_control_execution_completed" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm to enable hand guiding and move the robot to safe position</value>
		</step>

		<step id="set_local_control_execution_completed" id_ok="user_confirm_robot_back_in_safe_position" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>

		<step id="user_confirm_robot_back_in_safe_position" id_ok="set_remote_control_execution_copmleted" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Confirm the robot is in safe position and the treatment head is ready to be placed back</value>
		</step>

		<step id="set_remote_control_execution_copmleted" id_ok="check_zone" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="check_zone" id_ok="safe_zone" id_failed="unsafe_zone">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
		<step id="safe_zone" id_ok="move_to_left_to_right_ready" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Remote control</value>
		</step>
		<step id="unsafe_zone" id_ok="ask_user_to_move_to_safe_zone" id_failed="stop_failure">
			<action>Set operating mode</action>
			<value>Local control</value>
		</step>
		<step id="ask_user_to_move_to_safe_zone" id_ok="check_zone" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Please move the Robot to safe zone and press OK</value>
		</step>

		<!--<step id="move_to_candle_right" id_ok="move_to_left_to_right_ready" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Right User - Candle with treatment head</value>
		</step>-->
		<step id="move_to_left_to_right_ready" id_ok="move_to_left_to_right_prepare" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left_to_right - ready for right</value>
		</step>

		<step id="move_to_left_to_right_prepare" id_ok="move_to_candle_left" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left to right - prepare</value>
		</step>
		<step id="move_to_candle_left" id_ok="move_above_head" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Treatment head candle</value>
		</step>
		<step id="move_above_head" id_ok="translate" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Move to position</action>
			<value>Left User - Above treatment head - for place</value>
		</step>
		<step id="translate" id_ok="stop_ok" id_failed="stop_failure">
			<actuators_precondition>Flange=lock, Treatment cradle=unlock</actuators_precondition>
			<action>Translate</action>
			<value>Z, 50</value>
		</step>
	</sequence>

</sequences>