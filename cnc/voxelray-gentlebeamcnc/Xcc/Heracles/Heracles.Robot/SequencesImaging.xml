<sequences>
	<sequence name="Actuators Control Board Check">
		<step id="check_LLP" id_ok="report_LLP" id_failed="check_LLN">
			<!--No robotic motion-->
			<action>Check actuators</action>
			<value>Flange=lock, Imaging cradle=lock, Proximity=detected</value>
		</step>

		<step id="report_LLP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLP: No robotic motion</value>
		</step>

		<step id="check_LLN" id_ok="report_LLN" id_failed="check_LUP">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=lock, Imaging cradle=lock, Proximity=not_detected</value>
		</step>

		<step id="report_LLN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LLN: Non safe, technical intervention</value>
		</step>

		<step id="check_LUP" id_ok="report_LUP" id_failed="check_LUN">
			<!--Mounted -> resume pick / start release head.-->
			<action>Check actuators</action>
			<value>Flange=lock, Imaging cradle=unlock, Proximity=detected</value>
		</step>

		<step id="report_LUP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LUP: Mounted -> resume pick / start release head.</value>
		</step>

		<step id="check_LUN" id_ok="report_LUN" id_failed="check_ULP">
			<!--Mounted -> resume pick/ start release head-->
			<action>Check actuators</action>
			<value>Flange=lock, Imaging cradle=unlock, Proximity=not_detected</value>
		</step>

		<step id="report_LUN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>LUN: Mounted -> resume pick / start release head.</value>
		</step>

		<step id="check_ULP" id_ok="report_ULP" id_failed="check_ULN">
			<!--Unmounted -> resume  release / start pick head -->
			<action>Check actuators</action>
			<value>Flange=unlock, Imaging cradle=lock, Proximity=detected</value>
		</step>

		<step id="report_ULP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>ULP: Unmounted -> resume  release / start pick head</value>
		</step>

		<step id="check_ULN" id_ok="report_ULN" id_failed="check_UUP">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Imaging cradle=lock, Proximity=not_detected</value>
		</step>

		<step id="report_ULN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>ULN: Non safe, technical intervention</value>
		</step>

		<step id="check_UUP" id_ok="report_UUP" id_failed="check_UUN">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Imaging cradle=unlock, Proximity=detected</value>
		</step>

		<step id="report_UUP" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>UUP: Non safe, technical intervention</value>
		</step>

		<step id="check_UUN" id_ok="report_UUN" id_failed="report_unknown">
			<!--Non safe, technical intervention-->
			<action>Check actuators</action>
			<value>Flange=unlock, Imaging cradle=unlock, Proximity=not_detected</value>
		</step>

		<step id="report_UUN" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>UUP: Non safe, technical intervention</value>
		</step>

		<step id="report_unknown" id_ok="stop_ok" id_failed="stop_failure">
			<action>User confirmation</action>
			<value>Unknown: Non safe, technical intervention</value>
		</step>
	</sequence>

	<sequence name="Left User - Pick head">
		<step id="crandle_unlock" id_ok="stop_ok" id_failed="stop_failure">
			<action>Head action</action>
			<value>Imaging cradle, unlock</value>
		</step>

	</sequence>

	<sequence name="Left User - Treat">
		<step id="check_zone" id_ok="stop_ok" id_failed="stop_ok">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
	</sequence>

	<sequence name="Left User - Place head">
		<step id="crandle_lock" id_ok="stop_ok" id_failed="stop_failure">
			<action>Head action</action>
			<value>Imaging cradle, lock</value>
		</step>
	</sequence>




	<sequence name="Right User - Pick head">
		<step id="crandle_unlock" id_ok="stop_ok" id_failed="stop_failure">
			<action>Head action</action>
			<value>Imaging cradle, unlock</value>
		</step>
	</sequence>

	<sequence name="Right User - Treat">
		<step id="check_zone" id_ok="stop_ok" id_failed="stop_ok">
			<action>Check zone</action>
			<value>Safe</value>
		</step>
	</sequence>

	<sequence name="Right User - Place head">
		<step id="crandle_lock" id_ok="stop_ok" id_failed="stop_failure">
			<action>Head action</action>
			<value>Imaging cradle, lock</value>
		</step>
	</sequence>

</sequences>