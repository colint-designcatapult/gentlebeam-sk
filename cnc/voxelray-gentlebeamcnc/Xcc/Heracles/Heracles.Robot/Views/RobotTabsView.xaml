<ContentControl 
    x:Class="Heracles.Robot.Views.RobotTabsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:views ="clr-namespace:Heracles.Robot.Views"
    xmlns:viewModels="clr-namespace:Heracles.Robot.ViewModels"
    xmlns:system="clr-namespace:System;assembly=netstandard"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
             
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:conv="clr-namespace:Heracles.Application.UI.Converters;assembly=Heracles.Application"
    xmlns:convr="clr-namespace:Heracles.Robot.UI.Converters"
    
    
    xmlns:sharedViews="clr-namespace:Xcc.Shared.Views;assembly=Xcc.Shared"
    xmlns:converters="clr-namespace:Heracles.Robot.Converters"

    mc:Ignorable="d" 
    d:DesignWidth="1920" d:DesignHeight="1080"
    d:DataContext="{d:DesignInstance {x:Type viewModels:RobotTabsViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TabControl/FolderTabControl.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TabControl 
             Grid.Row="0"
             Margin="{StaticResource BlockContentMargin}"
             Style="{StaticResource FolderTabControl}">

            <TabItem Header="General" IsSelected="True">
                <views:RobotView/>
            </TabItem>

            <!--<TabItem Header="Movements">
                 <views:MovementsView/>
             </TabItem>-->

            <TabItem Header="User Settings">
                <views:UserSettingsView/>
            </TabItem>

            <!--<TabItem Header="Scan">
                 <views:ScanView/>
             </TabItem>-->
        </TabControl>


        <!-- Robot Log -->
        <!--<sharedViews:LogView Grid.Row="1" Margin="{StaticResource BlockContentMargin}"/>-->
        <Grid Grid.Row="1" Margin="{StaticResource BlockContentMarginLeftRightBottom}">
            <ListBox 
                x:Name="RobotLog"
                ItemsSource="{Binding RobotLog}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox 
                    BorderThickness="0"
                     Background="Transparent"
                    FontSize="12"
                    Foreground="{StaticResource BaseForegroundColor}"
                    Text="{Binding Mode=OneWay}" 
                    IsReadOnly="True"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Template>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Style="{StaticResource BorderBlockStyle}">
                            <ScrollViewer Margin="10">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" Margin="{StaticResource BlockContentMarginLeftRightBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <TextBlock 
                Grid.Column="0"
                Text="{Binding Status, Converter={converters:RobotArmStatusToStringConverter}}" 
                Foreground="{Binding Status, Converter={converters:RobotArmStatusToColorConverter}}" 
                VerticalAlignment="Center" 
                Style="{StaticResource TextBlockLegendStyle}"/>

            <TextBlock 
                Grid.Column="1"
                Text="{Binding AcbState}"
                VerticalAlignment="Center" 
                Style="{StaticResource TextBlockLegendStyle}"
                Margin="0"
                />

            <TextBlock 
                Grid.Column="2"
                Text="{Binding HardwareInfo}"
                VerticalAlignment="Center" 
                Style="{StaticResource TextBlockLegendStyle}"
                Margin="0"
                />

            <TextBlock 
                Grid.Column="3"
                Text="Movement:" 
                Foreground="{Binding InterlockState, Converter={convr:InterlockStateToColorConverter}}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Right"
                Style="{StaticResource TextBlockLegendStyle}"/>

            <TextBlock 
                Grid.Column="4"
                Text="{Binding InterlockState}"
                Foreground="{Binding InterlockState, Converter={convr:InterlockStateToColorConverter}}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Right"
                Style="{StaticResource TextBlockLegendStyle}"
                Margin="0"
                />
        </Grid>
    </Grid>
</ContentControl>
