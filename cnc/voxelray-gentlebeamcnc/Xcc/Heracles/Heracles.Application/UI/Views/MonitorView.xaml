<ContentControl 
    x:Class="Heracles.Application.UI.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:uc="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:conv2="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:viewModels="clr-namespace:Heracles.Application.UI.ViewModels" 
    
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Heracles.Application.UI.Views"
    xmlns:views1="clr-namespace:Xcc.Application.Views;assembly=Xcc.Application"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    mc:Ignorable="d"
    d:DesignWidth="140"
    d:DataContext="{d:DesignInstance {x:Type viewModels:MonitorViewModel}, IsDesignTimeCreatable=True}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/InterlockIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Label/TelemetryLabelStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="InterlocksIndicatorStyle" TargetType="ContentControl" >
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="22"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="IsTabStop" Value="False"  />
            </Style>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="{StaticResource TelemetryFieldHeight}"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Style="{StaticResource TextBlockLegendStyle}"
                Text="System status"/>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}"
                Foreground="{Binding TelemetryForeground}"
                Padding="0,0,0,2"
                FontSize="24"
                FontFamily="Segoe UI" 
                Content="{Binding ControlBoardState, Converter={conv2:TelemetryControlBoardStateNewToValueConverter}}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="{StaticResource TelemetryFieldHeight}"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Style="{StaticResource TextBlockLegendStyle}"
                Text="Energy [kV]"/>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground}"
                Content="{Binding MappedKvFeedback}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="{StaticResource TelemetryFieldHeight}"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Style="{StaticResource TextBlockLegendStyle}"
                Text="Timer [Sec]"/>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Content="{Binding GCBDataStore.SystemTelemetry.PrimaryTimerValue}"
                Foreground="{Binding TelemetryForeground}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>
        
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="{StaticResource TelemetryFieldHeight}"/>
                <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Style="{StaticResource TextBlockLegendStyle}"
                Text="Emission [mA]"/>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Content="{Binding GCBDataStore.SystemTelemetry.EmissionCurrent}"
                Foreground="{Binding TelemetryForeground}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <uc:RadiationHazardControl 
            Grid.Row="5"
            Margin="4,36" 
            IsActive="{Binding GCBDataStore.SystemTelemetry.ControlBoardState, Converter={conv2:GcbStatusToRadiationHazardActiveStateConverter}}" />

        <views:InterlocksView Grid.Row="6" Orientation="Vertical"/>

        <views1:ServiceButtonsView Grid.Row="8" HorizontalAlignment="Center"/>
    </Grid>
</ContentControl>
