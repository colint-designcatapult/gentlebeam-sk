<ContentControl 
    x:Class="Heracles.Application.UI.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    
    xmlns:prism="http://prismlibrary.com/" 
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application" 
    
    xmlns:viewModels="clr-namespace:Xcc.Application.ViewModels;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    prism:ViewModelLocator.AutoWireViewModel="True"
    UseLayoutRounding="True"
    
    FontSize="{StaticResource BaseFontSize}"

    IsTabStop="False"
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:LoginViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockErrorStyle.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/Logos.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/KeyboardToggleButtonStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/RevealToggleButton.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBox/XccTextBoxDefaultStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Canvas x:Key="WaveBackground" UseLayoutRounding="False">
                <Path Fill="#a0f0f8ff">
                    <Path.Data>
                        <PathGeometry Figures="M400 0V195.3c-19.85 15.3-61.77 46.19-106.25 46.69-81.63.93-102.4-46.32-182.39-45.11-46.38.7-89.74 28.7-111.36 46.42L0 0Z"/>
                    </Path.Data>
                </Path>
                <Path Fill="#fff0f8ff">
                    <Path.Data>
                        <PathGeometry Figures="M0 0V236.15c21.62-15.9 64.44-45.24 110.82-45.87 79.99-1.08 101.3 35.55 182.93 34.72 44.48-.45 86.4-25.35 106.25-39.07V0Z"/>
                    </Path.Data>
                </Path>
            </Canvas>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Width="400" Height="600" Style="{StaticResource BorderBlockStyle}" Loaded="Border_Loaded">
            <Grid>
                <ContentControl IsTabStop="False" Content="{StaticResource WaveBackground}" VerticalAlignment="Top" />

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Image 
                    Margin="30,0"
                    Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Images/GentleBeamLogo.png"/>

                    <Grid Margin="48,30" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource FieldMarginGridLength}" />
                            <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            <RowDefinition Height="{StaticResource FieldMarginGridLength}" />
                            <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                            <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <Style TargetType="Path">
                                <Setter Property="Height" Value="20" />
                                <Setter Property="StrokeThickness" Value="1.25" />
                                <Setter Property="Stroke" Value="{StaticResource ButtonStrokeColor}" />
                                <Setter Property="Margin" Value="4,0,8,0" />
                                <Setter Property="Stretch" Value="Uniform" />
                            </Style>
                        </Grid.Resources>

                    <TextBlock 
                        Grid.Row="0"
                        FontSize="{StaticResource LargeFontSize}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Style="{StaticResource TextBlockLegendStyle}"
                        Text="Sign In" />

                        <!-- Username -->
                        <controls:XccTextBox
                            Grid.Row="2"
                            Text="{Binding Username}"
                            Watermark="Username">

                            <controls:XccTextBox.Icon>
                                <Image Source="{StaticResource UsernameIcon}" Style="{StaticResource ButtonImageStyle}" Width="24"/>
                            </controls:XccTextBox.Icon>
                        </controls:XccTextBox>

                        <!-- Password -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            </Grid.ColumnDefinitions>

                            <controls:XccTextBox
                                UseLayoutRounding="True"
                                Grid.ColumnSpan="3"
                                Watermark="Password"
                                FontFamily="{Binding RevealPassword, Converter={convx:PasswordFontConverter}}"
                                Text="{Binding Password}"
                                IsClipboardDisabled="True"
                                Padding="4,0,20,0">

                                <controls:XccTextBox.Icon>
                                    <Image Source="{StaticResource PasswordIcon}" Style="{StaticResource ButtonImageStyle}" Width="24"/>
                                </controls:XccTextBox.Icon>
                            </controls:XccTextBox>

                            <ToggleButton 
                            Grid.Column="1" 
                            Style="{StaticResource RevealToggleButton}"
                            IsChecked="{Binding RevealPassword}"
                            Margin="0,2"/>
                        </Grid>

                        <TextBlock 
                        Grid.Row="6"
                        HorizontalAlignment="Right">
                        <Hyperlink Foreground="{StaticResource ForegroundPaleBrush}" Focusable="False">
                            Forgot password?
                        </Hyperlink>
                        </TextBlock>

                        <TextBlock 
                            Grid.Row="8" 
                            Text="{Binding ErrorMessage}" 
                            Style="{StaticResource TextBlockErrorStyle}"
                            TextAlignment="Center"/>

                        <Button 
                            Grid.Row="10" 
                            Command="{Binding SignInCommand}" 
                            IsDefault="True"
                            Width="{StaticResource ButtonWidth}" 
                            Height="{StaticResource ButtonHeight}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource BlockContentSmallMarginLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Source="{StaticResource UnlockIcon_Aligned}" Style="{StaticResource ButtonImageStyle}"/>
                                <TextBlock Grid.Column="2" Text="Sign In" Style="{StaticResource ButtonTextBlockStyle}"/>
                            </Grid>
                    </Button>
                </Grid>

                    <Button 
                    Grid.Row="0" Grid.RowSpan="2"
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonCloseStyle}"/>
                </Grid>

                <ToggleButton Style="{StaticResource KeyboardToggleButtonStyle}" IsChecked="{Binding ShowVirtualKeyboard}" Tag="{StaticResource KeyboardButtonCornerRadius}" BorderThickness="1,1,0,0"/>
            </Grid>
        </Border>

        <ucx:XccKeyboard 
            Grid.Row="1"
            Margin="{StaticResource BlockContentMargin}"
            Background="{StaticResource BlockBackgroundColor}"
            Visibility="{Binding KeyboardAppearance.KeyboardVisibility}"
            DockButtonsVisibility="Hidden"
            Height="380" Width="1280"/>
    </Grid>
</ContentControl>
