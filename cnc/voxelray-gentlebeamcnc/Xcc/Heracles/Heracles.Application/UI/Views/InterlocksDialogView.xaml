                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.HvpsReady, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.HvpsReady, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                        
                        
                        <TextBlock 
                            Grid.Row="28"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Cooler Alarm:"/>

                        <Grid Grid.Row="28" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.CoolerReady, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
