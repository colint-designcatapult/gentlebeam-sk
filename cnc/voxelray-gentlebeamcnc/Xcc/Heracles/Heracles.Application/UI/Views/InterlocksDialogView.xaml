                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.WaterLevelOk, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>

                        
                        <TextBlock 
                            Grid.Row="24"
                            HorizontalAlignment="Right"
