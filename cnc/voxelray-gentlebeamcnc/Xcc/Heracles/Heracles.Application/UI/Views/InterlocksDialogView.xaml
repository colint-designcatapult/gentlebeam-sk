                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.IonPumpOk, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
