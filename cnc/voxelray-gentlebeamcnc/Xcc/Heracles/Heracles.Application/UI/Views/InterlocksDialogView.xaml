                            <ContentControl Style="{StaticResource InterlocksIndicatorStyle}" Content="{StaticResource ThumbUnknownSvgIcon}"/>
                            <ContentControl Style="{StaticResource InterlocksIndicatorStyle}" Content="{StaticResource ThumbDislikeSvgIcon}"
                                            Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.DriveSystemReady, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}"/>
                            <ContentControl Style="{StaticResource InterlocksIndicatorStyle}" Content="{StaticResource ThumbLikeSvgIcon}"
