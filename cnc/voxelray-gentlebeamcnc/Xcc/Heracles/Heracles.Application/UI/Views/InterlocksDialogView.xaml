                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.CoolerReady, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                        
                        
                        <TextBlock 
                            Grid.Row="30"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Watchdog:"/>

                        <Grid Grid.Row="30" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.WatchdogReady, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.WatchdogReady, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                                
                        
                        <TextBlock 
                            Grid.Row="32"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Ion Pump:"/>
                        
                        <Grid Grid.Row="32" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
