                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.Timer1Ready, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>

                        
                        <TextBlock 
                            Grid.Row="20"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Timer #2:"/>

                        <Grid Grid.Row="20" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.Timer2Ready, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.Timer2Ready, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                        

                        <TextBlock 
                            Grid.Row="22"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Water Level:"/>

                        <Grid Grid.Row="22" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
