                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.RemoteEStopReleased, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                    
                        
                        <TextBlock 
