<ContentControl 
    x:Class="Heracles.Application.UI.Views.InterlocksDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:viewModels="clr-namespace:Heracles.Application.UI.ViewModels"

    mc:Ignorable="d"
    d:DesignWidth="600" d:DesignHeight="860" 
    d:DataContext="{d:DesignInstance {x:Type viewModels:InterlocksDialogViewModel}, IsDesignTimeCreatable=True}">
    
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/InterlockIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="BlockHeaderTextBoxStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                <Setter Property="FontSize" Value="{StaticResource HugeFontSize}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentForegroundColor}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="TelemetryTextBlockLegendStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                <Setter Property="FontSize" Value="{StaticResource LargeFontSize}"/>
            </Style>
            
            <Style x:Key="InterlocksIndicatorStyle" TargetType="ContentControl" >
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="22"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>            
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="860"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderBrush="{StaticResource BlockBorderColor1}" BorderThickness="1" Style="{StaticResource BorderBlockStyle}" Background="{StaticResource BlockBackgroundColor}">
        <DockPanel Margin="10">
            <Button 
                DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Command="{Binding CloseDialogCommand}"
                Style="{StaticResource ButtonCloseStyle}"/>

            <Grid Margin="{StaticResource BlockContentMargin}">
                <!--Interlocks-->
                <Border Grid.Row="0" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />   
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />                               
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />                               
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock 
                            Grid.ColumnSpan="3" 
                            Style="{StaticResource BlockHeaderTextBoxStyle}" 
                            Text="Interlocks"/>

                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Applicator:"/>
                    
                        <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.CollimatorOn, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.CollimatorOn, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>

                    
                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Remote Key:"/>
                    
                        <Grid Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.RemoteKeyOn, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.RemoteKeyOn, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Door Interlock:"/>


                        <Grid Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>

                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.DoorClosed, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />

                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.DoorClosed, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>


                        <TextBlock 
                            Grid.Row="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Base E-Stop:"/>
                    
                        <Grid Grid.Row="10" Grid.Column="2" HorizontalAlignment="Left">
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}"
                                Content="{StaticResource ThumbUnknownSvgIcon}"/>
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbDislikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.BaseEStopReleased, Converter={convx:BooleanToInvisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
            
                            <ContentControl 
                                Style="{StaticResource InterlocksIndicatorStyle}" 
                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.BaseEStopReleased, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                    
                    
                        <TextBlock 
                            Grid.Row="12"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Remote E-Stop:"/>
                    
                        <Grid Grid.Row="12" Grid.Column="2" HorizontalAlignment="Left">
