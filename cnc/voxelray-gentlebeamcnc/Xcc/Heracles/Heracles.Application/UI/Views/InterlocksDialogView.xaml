                                Content="{StaticResource ThumbLikeSvgIcon}" 
                                Visibility="{Binding GCBDataStore.SystemTelemetry.Interlocks.IonPumpOk, Converter={convx:BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}" />
                        </Grid>
                        <TextBlock Grid.Row="34" HorizontalAlignment="Right"
                                   Style="{StaticResource TelemetryTextBlockLegendStyle}" Text="Drive System:"/>
