<ContentControl 
    x:Class="Heracles.Application.UI.Views.ApproveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:views ="clr-namespace:Heracles.Application.UI.Views"
    xmlns:viewModels="clr-namespace:Heracles.Application.UI.ViewModels"
    xmlns:system="clr-namespace:System;assembly=netstandard"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
             
    xmlns:enums="clr-namespace:Heracles.Core.Enums;assembly=Heracles.Core"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls;assembly=Xcc.Application"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters;assembly=Xcc.Application"
    xmlns:behaviors="clr-namespace:Xcc.Application.UI.Behaviors;assembly=Xcc.Application"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"

    UseLayoutRounding="True"
    IsTabStop="False"

    FontSize="{StaticResource BaseFontSize}"

    mc:Ignorable="d" 
    d:DesignWidth="400"
    d:DataContext="{d:DesignInstance {x:Type viewModels:ApproveViewModel}, IsDesignTimeCreatable=True}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="400"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderColor}" Style="{StaticResource BorderBlockStyle}">
        <DockPanel Margin="{StaticResource BlockContentMargin}">
            <Grid DockPanel.Dock="Top">
                <TextBlock 
                    Text="{Binding Title}" 
                    Style="{StaticResource TextBlockLegendStyle}"
                    FontSize="{StaticResource HugeFontSize}"/>

                <Button 
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonCloseStyle}"
                    IsTabStop="False"
                    IsCancel="True">
                </Button>
            </Grid>

            <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}" Text="User"/>
                <controls:XccTextBox 
                    Grid.Row="1" 
                    
                    Text="{Binding Username}"
                    behaviors:FocusBehaviors.FocusOnLoad="True"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}" Text="Password"/>
                <controls:XccTextBox 
                    Grid.Row="1" Grid.Column="2" 
                    
                    FontFamily="{StaticResource PasswordFont}"
                    IsClipboardDisabled="True"
                    Text="{Binding Password}"/>

                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource TextBlockLegendStyle}" Text="Status"/>
                <ComboBox 
                    Grid.Row="4" Grid.ColumnSpan="3"
                    ItemsSource="{Binding AvailableStatuses}"
                    SelectedItem="{Binding Status}">
                    
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={convx:EnumValueToDisplayNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                
                <TextBlock 
                    Grid.Row="5" Grid.ColumnSpan="3"
                    Text="{Binding ErrorMessage}" 
                    Foreground="Crimson" 
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextAlignment="Center" 
                    Margin="12,0" 
                    FontSize="15"/>
                
                <Button
                    Grid.Row="7" Grid.ColumnSpan="3" 
                    HorizontalAlignment="Right" 
                    Height="40" Width="125"
                    IsDefault="True"
                    Command="{Binding SignInAndSaveCommand}">
                    
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="{StaticResource SaveToDiskIcon}"
                            Style="{StaticResource ButtonPathStyle}"
                            Height="21"
                            Width="21"
                            Margin="0,0,5,0"/>

                        <Label Content="Save" Style="{StaticResource ButtonLabelStyle}" Padding="0" />
                    </StackPanel>
                </Button>
            </Grid>

        </DockPanel>
    </Border>
</ContentControl>
