<ContentControl 
    x:Class="Heracles.Application.UI.Views.DetailedTelemetryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:viewModels="clr-namespace:Xcc.Application.ViewModels;assembly=Xcc.Application"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels1="clr-namespace:Heracles.Application.UI.ViewModels"

    prism:ViewModelLocator.AutoWireViewModel="True"
    
    mc:Ignorable="d"
    d:FontFamily="{StaticResource BaseFont}"
    d:FontSize="{StaticResource BaseFontSize}"
    d:DesignWidth="1600" d:DesignHeight="1000"
    d:DataContext="{d:DesignInstance {x:Type viewModels1:DetailedTelemetryViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockLegendStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ListViewStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ListViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BlockHeaderTextBoxStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource HugeFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>

            </Style>

            <Style x:Key="TelemetryTextBlockLegendStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
            </Style>
            
            <Style x:Key="ValueTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                <Setter Property="Foreground" Value="{StaticResource ForegroundAccentBrush}"></Setter>
            </Style>
            
            <system:String x:Key="NotAvailableText">Not available</system:String>
            <GridLength x:Key="SystemSignalsBlockMarginLength">24</GridLength>
        </ResourceDictionary>
    </ContentControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource ViewMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="{StaticResource SystemSignalsBlockMarginLength}" />
                <ColumnDefinition/>
                <ColumnDefinition Width="{StaticResource SystemSignalsBlockMarginLength}" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource SystemSignalsBlockMarginLength}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Active faults-->
            <Border Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource BorderBlockStyle}">
                <Grid Margin="{StaticResource BlockContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource BlockHeaderTextBoxStyle}" Text="Active Faults"/>

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="ServiceFaultList"
                            Style="{StaticResource TableListView}"
                            ItemsSource="{Binding Faults}"
                            Tag="{StaticResource SystemFaultListHeaderTemplate}"
                            ItemTemplate="{StaticResource SystemFaultListItemTemplate}"/>

                        <TextBlock
                            Text="No active faults."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ForegroundPaleBrush}"
                            IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ServiceFaultList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="{StaticResource SystemSignalsBlockMarginLength}"/>
                    <RowDefinition Height="3.5*" />
                    <RowDefinition Height="{StaticResource SystemSignalsBlockMarginLength}"/>
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!--System-->
                <Border Grid.Row="0" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource BlockHeaderTextBoxStyle}" Text="System"/>

                    
                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="System State:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.ControlBoardState, FallbackValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="System Runtime [ms]:"/>

                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.SystemRuntime, FallbackValue={StaticResource NotAvailableText}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="System Fault Flags:"/>                    
                    

                        <TextBlock 
                            Grid.Row="6" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Faults.RawFlags, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>
                        

                        <TextBlock 
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Interlock Flags:"/>  
                        
                        <TextBlock 
                            Grid.Row="8" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Interlocks.RawFlags, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>

                        <TextBlock
                            Grid.Row="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}"
                            Text="Required Interlock Flags:"/>

                        <TextBlock
                            Grid.Row="10" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}"
                            Text="{Binding GCBDataStore.SystemTelemetry.Interlocks.RawRequiredFlags, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>
                    </Grid>
                </Border>   
                
                
                <!--General-->
                <Border Grid.Row="2" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />                            
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource BlockHeaderTextBoxStyle}" Text="General"/>

                    
                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Ring LED State:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.RingLedState, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Base LED State:"/>

                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.BaseLedState, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Applicator ID (1):"/>                    
                    

                        <TextBlock 
                            Grid.Row="6" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.CollimatorId1, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>
                        

                        <TextBlock 
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Applicator ID (2):"/>  
                        
                        <TextBlock 
                            Grid.Row="8" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.CollimatorId2, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>


                        <TextBlock 
                            Grid.Row="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Buttons:"/>

                        <TextBlock 
                            Grid.Row="10" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.ButtonsState, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>
                    </Grid>
                </Border>             
                
                
                <!--Operational points-->
                <Border Grid.Row="4" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource BlockHeaderTextBoxStyle}" Text="Operational points"/>

                    
                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Current Point:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.CurrentOperationalPoint, FallbackValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Total Points:"/>

                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.TotalOperationalPoints, FallbackValue={StaticResource NotAvailableText}}"/>
                    </Grid>
                </Border>   
                
                  
            </Grid>            
        
            <Grid Grid.Row="2" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="{StaticResource SystemSignalsBlockMarginLength}"/>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="{StaticResource SystemSignalsBlockMarginLength}"/>
                    <RowDefinition Height="7*" />
                </Grid.RowDefinitions>

                <!--Timers-->
                <Border Grid.Row="0" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />                            
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource BlockHeaderTextBoxStyle}" Text="Timers"/>

                    
                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Internal Timer State:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.InternalTimerState, FallbackValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Internal Timer Value [sec]:"/>

                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.PrimaryTimerValue, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Timer 1 State:"/>
                    
                        <TextBlock 
                            Grid.Row="6" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Timer1State, FallbackValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Timer 1 Value [sec]:"/>

                        <TextBlock 
                            Grid.Row="8" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.SecondaryTimer1Value, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                        

                        <TextBlock 
                            Grid.Row="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Timer 2 State:"/>
                    
                        <TextBlock 
                            Grid.Row="10" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Timer2State, FallbackValue={StaticResource NotAvailableText}}"/>
                    

                        <TextBlock 
                            Grid.Row="12"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Timer 2 Value [sec]:"/>

                        <TextBlock 
                            Grid.Row="12" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.SecondaryTimer2Value, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                    </Grid>
                </Border>    
                
                <!--Coils-->
                <Border Grid.Row="2" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource BlockHeaderTextBoxStyle}" Text="Coils"/>

                    
                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="X coil current [mA]:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.XCoilCurrent, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F2}}"/>
                    

                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Y coil current [mA]:"/>

                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.YCoilCurrent, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F2}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Focus current [mA]:"/>                    
                    

                        <TextBlock 
                            Grid.Row="6" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.FocusCurrent, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F2}}"/>
                    </Grid>
                </Border>  

                <!--HVPS-->
                <Border Grid.Row="4" Style="{StaticResource BorderBlockStyle}">
                    <Grid Margin="{StaticResource BlockContentMargin}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="{StaticResource  BlockContentSmallMarginLength}" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>                            
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource BlockContentSmallMarginLength}"/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock 
                            Grid.ColumnSpan="3" 
                            Style="{StaticResource BlockHeaderTextBoxStyle}" 
                            Text="HVPS"/>

                        <TextBlock 
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="HVPS Runtime [ms]:"/>
                    
                        <TextBlock 
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.RuntimeCounterHVPS, FallbackValue={StaticResource NotAvailableText}}"/>

                    
                        <TextBlock 
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="HVPS IO:"/>
                    
                        <TextBlock 
                            Grid.Row="4" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Hvps.RawIoFlags, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="HVPS Status Flags:"/>


                        <TextBlock 
                            Grid.Row="6" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.Hvps.RawStatusFlags, FallbackValue={StaticResource NotAvailableText}, StringFormat={}0x{0:X}}"/>

                        <TextBlock 
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="kV Setpoint [kV]:"/>

                        <TextBlock 
                            Grid.Row="8" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.KvSetpoint, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>

                        <TextBlock 
                            Grid.Row="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="kV Feedback [kV]:"/>

                        <TextBlock 
                            Grid.Row="10" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.KvFeedback, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="12"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="mA Feedback [mA]:"/>
                    
                        <TextBlock 
                            Grid.Row="12" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.EmissionCurrent, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="14"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Filament setpoint [mA]:"/>
                    
                        <TextBlock 
                            Grid.Row="14" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.HeaterCurrentSetpoint, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>
                    
                    
                        <TextBlock 
                            Grid.Row="16"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Filament feedback [mA]:"/>
                    
                        <TextBlock 
                            Grid.Row="16" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.HeaterCurrentFeedback, FallbackValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>

                        <TextBlock 
                            Grid.Row="18"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Emission Current Limit [A]:"/>

                        <TextBlock 
                            Grid.Row="18" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.EmissionCurrentLimit, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>

                        <TextBlock 
                            Grid.Row="20"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="HVPS Power Setpoint [W]:"/>

                        <TextBlock 
                            Grid.Row="20" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ValueTextBlockStyle}" 
                            Text="{Binding GCBDataStore.SystemTelemetry.HvpsPowerSetpoint, FallbackValue={StaticResource NotAvailableText}, TargetNullValue={StaticResource NotAvailableText}, StringFormat={}{0:F}}"/>

                        <TextBlock 
                            Grid.Row="22"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TelemetryTextBlockLegendStyle}" 
                            Text="Grid setpoint [V]:"/>

