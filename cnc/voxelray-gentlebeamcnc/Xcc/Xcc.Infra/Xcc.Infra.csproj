<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <VersionPrefix>1.1.0</VersionPrefix><!--Used as version of nuget package-->
    <InformationalVersion>$(AssemblyVersion) build $(BuildNumber) </InformationalVersion>
    <Title>Command &amp; Control desktop apps services library.</Title>
    <PackageProjectUrl>https://bitbucket.org/empyrean-medical-devices/xcc/src/master/</PackageProjectUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Settings\**" />
    <EmbeddedResource Remove="Settings\**" />
    <None Remove="Settings\**" />
    <Page Remove="Settings\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CaseConverter" Version="2.0.1" />
    <PackageReference Include="fo-dicom" Version="5.1.3" />
    <PackageReference Include="Google.Protobuf" Version="3.30.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Empyrean\Empyrean.Common\Empyrean.Common.csproj" />
    <ProjectReference Include="..\Xcc.Core\Xcc.Core.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo dotnet nuget push $(AssemblyName).$(VersionPrefix).nupkg --source OrimtechAzureComponents -k az &gt; $(TargetDir)..\PushNugetPackage.bat" />
  </Target>

</Project>
