<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ButtonPathStyleBase" TargetType="Path">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{StaticResource ButtonStrokeColor}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonPathStyle" BasedOn="{StaticResource ButtonPathStyleBase}" TargetType="Path">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{StaticResource ButtonStrokeColor}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ButtonPathStyleFilled" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource ButtonStrokeColor}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Fill" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonPathStyleThickness2" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource ButtonStrokeColor}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stretch" Value="Uniform"/>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>







    <Style x:Key="ButtonLabelStyle" TargetType="Label">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ButtonStrokeColor}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ButtonTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Padding" Value="4,2,0,2" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ButtonStrokeDisabledColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Stretch" Value="None"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>