<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml"/>
        
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockValidationErrorStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--This style is copy of style called XccDefaultTextBoxStyle-->
    <!-- and supposed to be used with editable DataGrid column (DataGridTextColumn)-->
    <Style x:Key="DataGridTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource FieldBackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource FieldForegroundColor}"/>
        <Setter Property="CaretBrush" Value="{StaticResource FieldCaretBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="MinWidth" Value="32"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                            
                        <TextBlock 
                            Text="{TemplateBinding Tag}" 
                            Style="{StaticResource TextBlockLegendStylePale}"
                            Margin="{StaticResource FieldSmallBottomMargin}" 
                            Visibility="{TemplateBinding Tag, Converter={convx:ObjectToVisibilityConverter}}"/>

                        <Border 
                            Name="Border"
                            Grid.Row="1"
                            CornerRadius="5" 
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>

                        <Popup 
                            Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            x:Name="ErrorMessage"
                            Placement="Bottom"
                            VerticalOffset="3"
                            AllowsTransparency="True">

                            <Grid>
                                <Border
                                    Background="{StaticResource FieldValidationErrorBrush}"
                                    CornerRadius="5"
                                    Margin="0,3,0,0">

                                    <TextBlock 
                                        Margin="6"
                                        Style="{StaticResource TextBlockValidationErrorStyle}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(Validation.Errors)/ErrorContent}"/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>

                            <Setter Property="IsOpen" TargetName="ErrorMessage" Value="True"/>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource FieldActiveBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource SelectedForegroundBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="true">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource FieldValidationErrorBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource FieldDisabledForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FieldDisabledBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>