<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/KeyboardIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>
        
    <CornerRadius x:Key="KeyboardButtonCornerRadius" TopLeft="5" BottomRight="0"/>

    <Style x:Key="KeyboardToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Tag" Value="{StaticResource KeyboardButtonCornerRadius}"/>
        <Setter Property="Background" Value="{StaticResource BlockBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlockBorderColor}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="{TemplateBinding Tag}"
                        Background="{TemplateBinding Background}" 
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        
                        <Image x:Name="PART_Icon" Source="{StaticResource KeyboardIcon}" Margin="12,12" Style="{StaticResource ButtonImageStyle}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Opacity"  TargetName="PART_Icon"  Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>  
</ResourceDictionary>