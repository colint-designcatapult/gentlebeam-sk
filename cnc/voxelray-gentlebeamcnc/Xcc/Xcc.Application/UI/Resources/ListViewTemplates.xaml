<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:Xcc.Core.Enums;assembly=Xcc.Core"
    xmlns:converters="clr-namespace:Xcc.Application.UI.Converters"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
        
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/SortableColumnHeaderStyle.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ItemsControl/ColumnItemsControlStyleBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="HighlightedTextStyle" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
    </Style>

    <!--Log templates-->
    <Style x:Key="LogColumns" TargetType="ItemsControl" BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="0.25*"/>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.20*"/>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="LogHeaderTemplate">
        <ItemsControl Style="{StaticResource LogColumns}" IsTabStop="False">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Time"/>
            <TextBlock Grid.Column="2" Text="Status"/>
            <TextBlock Grid.Column="3" Text="Type"/>
            <TextBlock Grid.Column="4" Text="Record" HorizontalAlignment="Left"/>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="LogItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource LogColumns}" Foreground="{StaticResource PatientFieldForegroundColor}" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
            <ItemsControl.Resources>
                <Style TargetType="ucx:SelectableTextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}">
                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                </Style>
            </ItemsControl.Resources>

            <ucx:SelectableTextBlock Grid.Column="1" Text="{Binding TimeStamp}"/>
            <ucx:SelectableTextBlock Grid.Column="2" Text="{Binding Severity}"/>
            <ucx:SelectableTextBlock Grid.Column="3" Text="{Binding Type}"/>
            <ucx:SelectableTextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
            <!--<ucx:SelectableTextBlock 
                Grid.Column="4" 
                TextWrapping="Wrap"
                behaviors:HighlightTermBehavior.Text="{Binding Message}" 
                behaviors:HighlightTermBehavior.TermToBeHighlighted="{Binding Text, ElementName=SearchPhraseTextBox}" 
                behaviors:HighlightTermBehavior.HighlightStyle="{StaticResource HighlightedTextStyle}">
            </ucx:SelectableTextBlock>-->
        </ItemsControl>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static enums:LogRecordSeverity.Error}">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="Indianred"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True" />
                    <Condition Binding="{Binding Severity}" Value="{x:Static enums:LogRecordSeverity.Error}" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ItemsHost" Property="Foreground" Value="OrangeRed"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    
    
    
    <!--User list templates-->
    <Style x:Key="UserColumns" TargetType="ItemsControl"  BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="UserHeaderTemplate" >
        <ItemsControl Style="{StaticResource UserColumns}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Username"/>
            <TextBlock Grid.Column="2" Text="Role"/>
            <TextBlock Grid.Column="3" Text="First Name"/>
            <TextBlock Grid.Column="4" Text="Last Name"/>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="UserItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource UserColumns}" Foreground="{StaticResource PatientFieldForegroundColor}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="{Binding Username}"/>
            <TextBlock Grid.Column="2" Text="{Binding Role.Name}"/>
            <TextBlock Grid.Column="3" Text="{Binding FirstName}"/>
            <TextBlock Grid.Column="4" Text="{Binding LastName}"/>
        </ItemsControl>
        
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    
    
    
    <!--Target Points list-->
    <Style x:Key="TargetPointsListColumns" TargetType="ItemsControl"  BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="4" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TargetPointsListHeaderTemplate" >
        <ItemsControl IsTabStop="False" Style="{StaticResource TargetPointsListColumns}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="2">
                <Run Text="X Coil"/>
                <Run Text="[mA]" Foreground="{StaticResource ForegroundPaleBrush}"/>
            </TextBlock>

            <TextBlock Grid.Column="3">
                <Run Text="Y Coil"/>
                <Run Text="[mA]" Foreground="{StaticResource ForegroundPaleBrush}"/>
            </TextBlock>

            <TextBlock Grid.Column="4">
                <Run Text="Focus"/>
                <Run Text="[mA]" Foreground="{StaticResource ForegroundPaleBrush}"/>
            </TextBlock>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="TargetPointsListItemTemplate">
        <Border x:Name="SelectionBorder" BorderThickness="1" CornerRadius="4" Padding="4,8,0,8">
            <ItemsControl x:Name="ItemsHost" IsTabStop="False" Style="{StaticResource TargetPointsListColumns}" Foreground="{StaticResource PatientFieldForegroundColor}">
                <ItemsControl.Resources>
                    <Style TargetType="{x:Type controls:XccTextBox}" BasedOn="{StaticResource XccTextBoxDefaultStyle}">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Margin" Value="10,0,4,0"/>
                    </Style>
                </ItemsControl.Resources>

                <Border
                    x:Name="DisplayName"
                    Grid.Column="1"
                    Background="{StaticResource BlockBorderColor}"
                    CornerRadius="3"
                    VerticalAlignment="Center"
                    Height="24">
                
                    <TextBlock 
                        Text="{Binding DisplayName}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"/>
                </Border>

                <controls:XccTextBox Grid.Column="2" Text="{Binding XDeflectionCurrent, StringFormat={}{0:F2}}"/>
                <controls:XccTextBox Grid.Column="3" Text="{Binding YDeflectionCurrent, StringFormat={}{0:F2}}"/>
                <controls:XccTextBox Grid.Column="4" Text="{Binding FocusCurrent, StringFormat={}{0:F2}}"/>
            </ItemsControl>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource PatientFieldOddBackgroundColor}"/>
                <Setter TargetName="DisplayName" Property="Background" Value="Orange"/>
                <Setter TargetName="DisplayName" Property="TextElement.Foreground" Value="Black"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>




    <!--Daily warmup list-->
    <Style x:Key="DailyWarmupListColumns" TargetType="ItemsControl"  BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DailyWarmupListHeaderTemplate" >
        <ItemsControl Style="{StaticResource DailyWarmupListColumns}" IsTabStop="False">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Performed"/>
            <TextBlock Grid.Column="2" Text="Type"/>
            <TextBlock Grid.Column="3">
                <Run Text="Heater Current"/>
                <Run Text="[mA]" Foreground="{StaticResource ForegroundPaleBrush}"/>
            </TextBlock>
            <TextBlock Grid.Column="4">
                <!--<Run Text="Duration"/>
                <Run Text="[sec]" Foreground="{StaticResource ForegroundPaleBrush}"/>-->
            </TextBlock>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="DailyWarmupListItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource DailyWarmupListColumns}" Foreground="{StaticResource PatientFieldForegroundColor}" IsTabStop="False">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="{Binding CreationDate}"/>
            <TextBlock Grid.Column="2" Text="{Binding Type}"/>
            <TextBlock Grid.Column="3" Text="{Binding HeaterCurrent}"/>
            <!--<TextBlock Grid.Column="4" Text="{Binding Duration}"/>-->
        </ItemsControl>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>



    <!--Safety Check Reports list-->
    <Style x:Key="SafetyCheckReportListColumns" TargetType="ItemsControl"  BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SafetyCheckReportListHeaderTemplate" >
        <ItemsControl Style="{StaticResource SafetyCheckReportListColumns}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Performed"/>
            <TextBlock Grid.Column="2" Text="X-Ray Light"/>
            <TextBlock Grid.Column="3" Text="X-Ray Sound"/>
            <TextBlock Grid.Column="4" Text="Door Interlock"/>
            <TextBlock Grid.Column="5" Text="E-Stop"/>
            <TextBlock Grid.Column="6" Text="Stop Emission"/>
            <TextBlock Grid.Column="7" Text="Live Video"/>
            <TextBlock Grid.Column="8" Text="Live Audio"/>
            <TextBlock Grid.Column="9" Text="Performed By"/>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="SafetyCheckReportListItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource SafetyCheckReportListColumns}" Foreground="{StaticResource PatientFieldForegroundColor}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxDefaultStyle}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="{Binding CreationDate, Converter={converters:DateTimeToDateStringConverter}}"/>
            <CheckBox Grid.Column="2" IsChecked="{Binding XRayLight}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="3" IsChecked="{Binding XRaySound}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="4" IsChecked="{Binding DoorInterlock}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="5" IsChecked="{Binding EStop}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="6" IsChecked="{Binding SStop}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="7" IsChecked="{Binding LiveVideo}" IsHitTestVisible="False"/>
            <CheckBox Grid.Column="8" IsChecked="{Binding LiveAudio}" IsHitTestVisible="False"/>
            <TextBlock Grid.Column="9" Text="{Binding PerformedBy}"/>
        </ItemsControl>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>



    <!--System Fault list-->
    <Style x:Key="SystemFaultListColumns" TargetType="ItemsControl"  BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SystemFaultListHeaderTemplate" >
        <ItemsControl Style="{StaticResource SystemFaultListColumns}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Type"/>
            <TextBlock Grid.Column="2" Text="State"/>
            <TextBlock Grid.Column="3" Text="Expected"/>
            <TextBlock Grid.Column="4" Text="Measured"/>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="SystemFaultListItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource SystemFaultListColumns}" Foreground="{StaticResource PatientFieldForegroundColor}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="{Binding FaultType, Converter={converters:EnumValueToDisplayNameConverter}}"/>
            <TextBlock Grid.Column="2" Text="{Binding FaultEntryStateString}"/>
            <TextBlock Grid.Column="3" Text="{Binding ExpectedParameter}"/>
            <TextBlock Grid.Column="4" Text="{Binding MeasuredParameter}"/>
        </ItemsControl>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>