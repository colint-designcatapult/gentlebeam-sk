<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        
        
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml"/>
        
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/SortableColumnHeaderStyle.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ItemsControl/ColumnItemsControlStyleBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!--User list templates-->
    <Style x:Key="UserColumns" TargetType="ItemsControl" BasedOn="{StaticResource ColumnsItemsControlStyleBase}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" SharedSizeGroup="LeftMargin"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4" SharedSizeGroup="RightMargin"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="UserHeaderTemplate" >
        <ItemsControl Style="{StaticResource UserColumns}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListHeaderTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="Username"/>
            <TextBlock Grid.Column="2" Text="Role"/>
            <TextBlock Grid.Column="3" Text="First Name"/>
            <TextBlock Grid.Column="4" Text="Last Name"/>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="UserItemTemplate">
        <ItemsControl x:Name="ItemsHost" Style="{StaticResource UserColumns}" Foreground="{StaticResource PatientFieldForegroundColor}">
            <ItemsControl.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ListItemTextBlockStyle}"/>
            </ItemsControl.Resources>

            <TextBlock Grid.Column="1" Text="{Binding Username}"/>
            <TextBlock Grid.Column="2" Text="{Binding Role.Name}"/>
            <TextBlock Grid.Column="3" Text="{Binding FirstName}"/>
            <TextBlock Grid.Column="4" Text="{Binding LastName}"/>
        </ItemsControl>
        
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                <Setter TargetName="ItemsHost" Property="Foreground" Value="{StaticResource SelectedForegroundBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>