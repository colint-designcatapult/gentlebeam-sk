    <Style x:Key="XRayButtonsIconStyle" TargetType="Path">
        <Setter Property="Height" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Stretch" Value="Uniform"></Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{StaticResource ButtonStrokeColor}" />
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonPathStyleThickness2" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource ButtonStrokeBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stretch" Value="Uniform"/>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" Value="{StaticResource ButtonDisabledStrokeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

