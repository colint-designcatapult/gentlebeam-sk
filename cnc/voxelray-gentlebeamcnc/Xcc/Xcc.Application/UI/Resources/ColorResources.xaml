<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Brush x:Key="AppBackgroundColor">#242424</Brush>
    <Brush x:Key="AppBorderActiveColor">#a0a0a0</Brush>
    <Brush x:Key="AppBorderInActiveColor">#bfbfbf</Brush>
    <Brush x:Key="DialogBoxBackgroundColor">#181818</Brush>
    
    <Brush x:Key="TabHeaderUnselectedColor">Gray</Brush>
    <Brush x:Key="ViewTabHeaderUnselectedColor">LightGray</Brush>
    
    <Brush x:Key="BaseForegroundColor">#c0c0c0</Brush>
    <Brush x:Key="AccentForegroundColor">#f0f0f0</Brush>
    <Brush x:Key="SelectedForegroundBrush">Orange</Brush>
    
    <SolidColorBrush x:Key="LegendForegroundColor">#e0e0e0</SolidColorBrush>
    <SolidColorBrush x:Key="ShadowForegroundColor" Color="Black"/>
    
    <Color x:Key="FieldForegroundPaleColor_">#b0b0b0</Color>
    <SolidColorBrush x:Key="FieldForegroundPaleColor">#b0b0b0</SolidColorBrush>
    <!--<SolidColorBrush x:Key="FieldBackgroundColor">#1c1c1c</SolidColorBrush>-->
    <Color x:Key="FieldForegroundColor_">#e0e0e0</Color>
    <SolidColorBrush x:Key="FieldForegroundColor">#e0e0e0</SolidColorBrush>
    <SolidColorBrush x:Key="FieldDisabledForegroundBrush" Color="#888" />
    
    <SolidColorBrush x:Key="FieldWatermarkColor">#505050</SolidColorBrush>
    
    <SolidColorBrush x:Key="FieldBackgroundColor" >#282828</SolidColorBrush>
    <SolidColorBrush x:Key="FieldDisabledBackgroundBrush" Color="#353535" />
    
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#68686c" />
    <SolidColorBrush x:Key="FieldActiveBrush" Color="#88888c" />
    <SolidColorBrush x:Key="FieldDisabledBorderBrush" Color="#545458" />
    
    <SolidColorBrush x:Key="FieldBackgroundAccentColor">#282830</SolidColorBrush>
    <SolidColorBrush x:Key="FieldDisabledBackgroundAccentColor">#35353D</SolidColorBrush>
    
    <SolidColorBrush x:Key="FieldCaretBrush" Color="White" />
    <SolidColorBrush x:Key="FieldValidationErrorBrush" Color="#ab0000"/>

    <SolidColorBrush x:Key="BlockBorderColor">#6a6a6a</SolidColorBrush>
    <SolidColorBrush x:Key="BlockBorderColor1">#9898a0</SolidColorBrush>
    <SolidColorBrush x:Key="BlockBackgroundColor">#3a3a3a</SolidColorBrush>
    <SolidColorBrush x:Key="BlockBackgroundColorTr">#aa3a3a3a</SolidColorBrush>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#525252" />

    <SolidColorBrush x:Key="StartButtonBackgroundBrush">#297d4e</SolidColorBrush>
    <SolidColorBrush x:Key="StopButtonBackgroundBrush">#cc0000</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonStrokeColor">#d0d0d0</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonStrokeDisabledColor">#8c8c8c</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundColor">#505050</SolidColorBrush>
    
    <SolidColorBrush x:Key="TransparentButtonIsPressedBackground">#383838</SolidColorBrush>
    <SolidColorBrush x:Key="TransparentButtonIsMouseOverBackground">#505050</SolidColorBrush>
    <SolidColorBrush x:Key="TransparentButtonIsCheckedBackground">#80000000</SolidColorBrush>

    <SolidColorBrush x:Key="GridSplitterColor">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ActionButtonStrokeColor">#c0c0c0</SolidColorBrush>

    <SolidColorBrush x:Key="IsMouseOverBackground">#30FFFFFF</SolidColorBrush>

    <sys:Double x:Key="ButtonStrokeDisabledOpacity">0.55</sys:Double>
    <sys:Double x:Key="ButtonStrokeEnabledOpacity">1.0</sys:Double>

    <!--ScrollBar brushes-->
    <Brush x:Key="ScrollBarButtonsBackgroundBrush">#585858</Brush>
    <Brush x:Key="ScrollBarButtonsMouseOverBackgroundBrush">#686868</Brush>
    <Brush x:Key="ScrollBarButtonsMousePressedBackgroundBrush">#8a8a8a</Brush>
    <Brush x:Key="ScrollBarBackgroundBrush" >Transparent</Brush>

    <SolidColorBrush x:Key="PatientsListHeaderBackgroundColor">#101010</SolidColorBrush>
    <SolidColorBrush x:Key="PatientsListBackgroundColor">#282828</SolidColorBrush>
    <SolidColorBrush x:Key="PatientFieldEvenBackgroundColor">#434343</SolidColorBrush>
    <SolidColorBrush x:Key="PatientFieldEvenBackgroundColor1">#404040</SolidColorBrush>

    <SolidColorBrush x:Key="PatientFieldOddBackgroundColor">#4a4a4a</SolidColorBrush>
    <SolidColorBrush x:Key="PatientFieldOddBackgroundColor1">#333333</SolidColorBrush>
    
    <SolidColorBrush x:Key="PatientFieldForegroundColor">#c0c0c0</SolidColorBrush>
    <SolidColorBrush x:Key="ForegroundPaleBrush">#808080</SolidColorBrush>

    <SolidColorBrush x:Key="DisableControlBrush1">#80000000</SolidColorBrush>
    
    <DrawingBrush
        x:Key="DisabledControlBrush"
        Stretch="None"
        TileMode="Tile"
        Viewport="0,0,2,2"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H32 V32 H0Z" Brush="#C0000000"/>
                <GeometryDrawing Geometry="M0,0 H16 V16 H32 V32 H16 V16 H0Z" Brush="#C0606060"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush
        x:Key="DisabledControlBrush2"
        Stretch="None"
        TileMode="Tile"
        Viewport="0,0,2,2"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H32 V32 H0Z" Brush="#505050"/>
                <GeometryDrawing Geometry="M0,0 H16 V16 H32 V32 H16 V16 H0Z" Brush="#3A3A3A"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>    
    
    <DrawingBrush
        x:Key="DisabledControlOpacityMaskBrush"
        Stretch="None"
        TileMode="Tile"
        Viewport="0,0,2,2"
        ViewportUnits="Absolute">

        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H16 V16 H32 V32 H16 V16 H0Z" Brush="#D0000000"/>
                <GeometryDrawing Geometry="M 32 0 V 16 H 16 V 32 H 0 V 16 H 16 V 0 Z" Brush="#30DDDDDD"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="BatteryNotInUse">#808080</SolidColorBrush>
    <SolidColorBrush x:Key="BatteryFull">#759e21</SolidColorBrush>
    <SolidColorBrush x:Key="BatteryHigh">#a3bf34</SolidColorBrush>
    <SolidColorBrush x:Key="BatteryMedium">#fe8f12</SolidColorBrush>
    <SolidColorBrush x:Key="BatteryLow">#ff5713</SolidColorBrush>
    <SolidColorBrush x:Key="BatteryCritical">#f13713</SolidColorBrush>
</ResourceDictionary>
    