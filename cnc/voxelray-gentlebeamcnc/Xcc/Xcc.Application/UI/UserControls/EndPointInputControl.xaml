<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockLegendStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/TextBox/BaseTextBoxStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="InputFieldStyle" TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
        <Setter Property="MaxLength" Value="3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,4,4,2"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border 
                        Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <Decorator 
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                            x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FieldActiveBrush}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FieldValidationErrorBrush}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource FieldDisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="PortInputStyle" TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
        <Setter Property="MaxLength" Value="5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border 
                        Name="Border"
                        CornerRadius="{StaticResource FieldCornerRadius}" 
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <Decorator 
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FieldActiveBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="0"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SelectedForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="0"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="BorderBrush" Value="{StaticResource FieldValidationErrorBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="0"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource FieldDisabledForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FieldDisabledBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style TargetType="ucx:EndPointInputControl">
        <Setter Property="Background" Value="{StaticResource FieldBackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource FieldForegroundColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ucx:EndPointInputControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Legend" />
                            <ColumnDefinition Width="{StaticResource FieldMarginGridLength}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="2" Text="{TemplateBinding Tag}" Style="{StaticResource TextBlockLegendStyle}" />

                        <!-- Headers -->
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="IP Address" Style="{StaticResource TextBlockLegendStyle}" />
                        <TextBlock Grid.Column="4" Grid.Row="0" Text="Port"  Style="{StaticResource TextBlockLegendStyle}" />

                        <!-- IP-address fields -->
                        <Border x:Name="AddressBorder"
                            HorizontalAlignment="Left"
                            Margin="{TemplateBinding Padding}"
                            Grid.Column="2" Grid.Row="2" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{StaticResource FieldCornerRadius}"
                            IsEnabled="{TemplateBinding IsAddressInputEnabled}">
                            
                            <Grid Margin="4">
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}"/>

                                    <!--<Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Margin" Value="4"/>
                                    </Style>-->
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>

                                <TextBox 
                                    Grid.Column="0"
                                    x:Name="IpPart1TextBox"
                                    Text="{Binding EndPoint.IPAddressPart1, 
                                        RelativeSource={RelativeSource TemplatedParent}, 
                                        Mode=TwoWay, 
                                        ValidatesOnDataErrors=True, 
                                        UpdateSourceTrigger=PropertyChanged, 
                                        NotifyOnValidationError=True,
                                        Converter={convx:IntToStringConverter}}" />

                                <TextBlock Grid.Column="1" Text="." VerticalAlignment="Center"/>

                                <TextBox 
                                    Grid.Column="2"
                                    x:Name="IpPart2TextBox"
                                    Text="{Binding EndPoint.IPAddressPart2, 
                                        RelativeSource={RelativeSource TemplatedParent}, 
                                        Mode=TwoWay, 
                                        ValidatesOnDataErrors=True, 
                                        UpdateSourceTrigger=PropertyChanged, 
                                        NotifyOnValidationError=True,
                                        Converter={convx:IntToStringConverter}}" />

                                <TextBlock Grid.Column="3" Text="."  VerticalAlignment="Center"/>

                                <TextBox 
                                    Grid.Column="4"
                                    x:Name="IpPart3TextBox"
                                    Text="{Binding EndPoint.IPAddressPart3, 
                                        RelativeSource={RelativeSource TemplatedParent}, 
                                        Mode=TwoWay, 
                                        ValidatesOnDataErrors=True, 
                                        UpdateSourceTrigger=PropertyChanged, 
                                        NotifyOnValidationError=True,
                                        Converter={convx:IntToStringConverter}}"/>

                                <TextBlock Grid.Column="5" Text="."  VerticalAlignment="Center"/>

                                <TextBox 
                                    Grid.Column="6"
                                    x:Name="IpPart4TextBox"
                                    Text="{Binding EndPoint.IPAddressPart4, 
                                        RelativeSource={RelativeSource TemplatedParent}, 
                                        Mode=TwoWay, 
                                        ValidatesOnDataErrors=True, 
                                        UpdateSourceTrigger=PropertyChanged, 
                                        NotifyOnValidationError=True,
                                        Converter={convx:IntToStringConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Port input field -->
                        <TextBox 
                            x:Name="PortTextBox"
                            HorizontalAlignment="Left"
                            Grid.Column="4" Grid.Row="2" Width="80"
                            Style="{StaticResource PortInputStyle}"
                            IsEnabled="{TemplateBinding IsPortInputEnabled}"
                            Text="{Binding EndPoint.Port, 
                                RelativeSource={RelativeSource TemplatedParent}, 
                                Mode=TwoWay, 
                                ValidatesOnDataErrors=True, 
                                UpdateSourceTrigger=PropertyChanged, 
                                NotifyOnValidationError=True,
                                Converter={convx:IntToStringConverter}}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FieldActiveBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource SelectedForegroundBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>

                        <Trigger Property="IsFocused" SourceName="PortTextBox" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" SourceName="AddressBorder" Value="False">
                            <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource FieldDisabledBorderBrush}"/>
                        </Trigger>

                        <Trigger Property="HasErrors" Value="true">
                            <Setter Property="BorderBrush" Value="{StaticResource FieldValidationErrorBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
