<UserControl x:Class="Xcc.Application.UI.UserControls.VideoLiveFeedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:userControls="clr-namespace:Xcc.Application.UI.UserControls"
             xmlns:converters="clr-namespace:Xcc.Application.UI.Converters"
             xmlns:local="clr-namespace:Xcc.Application.UI.UserControls"
             mc:Ignorable="d"
             d:DesignWidth="720"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter: bool to mute status text -->
            <local:BoolToMuteStatusConverter x:Key="BoolToMuteStatusConverter"/>
            
            <!-- Converter: camera type to visibility -->
            <local:CameraTypeToVisibilityConverter x:Key="CameraTypeToVisibilityConverter"/>
            
            <!-- Converter: bool to speaker symbol -->
            <local:BoolToSpeakerSymbolConverter x:Key="BoolToSpeakerSymbolConverter"/>
            
            <!-- Converter: bool to microphone symbol -->
            <local:BoolToMicSymbolConverter x:Key="BoolToMicSymbolConverter"/>
            
            <!-- Converter: negate boolean -->
            <local:NegateConverter x:Key="NegateConverter"/>

            <Border 
                x:Key="OpacityMaskBorder" 
                Width="{Binding ActualWidth, ElementName=Root}" 
                Height="{Binding ActualHeight, ElementName=Root}" 
                CornerRadius="{StaticResource BlockCornerRadius}"
                Background="Red"/>

            <!-- Camera button style - disabled state shows blue border -->
            <Style x:Key="CameraButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Style.Triggers>
                    <!-- When disabled (active camera), show blue border -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="#00D9FF"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video feed area -->
        <DockPanel Grid.Row="0">
            <Grid Visibility="{Binding ControlPanelVisibility, ElementName=Root}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <FrameworkElement Grid.Row="1" Width="32" Height="32"/>
                
                <Button 
                    x:Name="ScreenshotButton" 
                    Grid.Row="3" 
                    Width="64" Height="64" 
                    Content="{StaticResource CameraIcon}" 
                    Click="ScreenshotButton_Click"/>
            </Grid>
            
            <!-- Video feed container (WebView2 + error panel only) -->
            <Grid Background="Black">
                <!-- Room Camera WebView2 (always loaded, visibility toggled) -->
                <wv2:WebView2 x:Name="WebViewRoomCamera" Visibility="Collapsed"/>
                
                <!-- Head Camera WebView2 (always loaded, visibility toggled) -->
                <wv2:WebView2 x:Name="WebViewHeadCamera" Visibility="Collapsed"/>
                
                <!-- Error panel (hidden by default) -->
                <Border x:Name="ErrorPanel" Background="#F5F5F5" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Camera Unavailable" FontSize="18" Foreground="#808080" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Camera and audio control buttons -->
        <Grid Grid.Row="1" Height="60" Background="#1E1E1E" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Audio/Speaker Mute Button -->
            <Button 
                Grid.Column="0"
                x:Name="ToggleAudioButton"
                Click="ToggleAudioButton_Click"
                Visibility="{Binding RoomCameraButtonVisibility, ElementName=Root}"
                Margin="8,0,4,0"
                ToolTip="{Binding IsAudioMuted, ElementName=Root, StringFormat='Audio: {0}', Converter={StaticResource BoolToMuteStatusConverter}}">
                <TextBlock 
                    Text="{Binding IsAudioMuted, ElementName=Root, Converter={StaticResource BoolToSpeakerSymbolConverter}}" 
                    FontSize="20" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"/>
            </Button>

            <!-- Microphone Mute Button -->
            <Button 
                Grid.Column="1"
                x:Name="ToggleMicrophoneButton"
                Click="ToggleMicrophoneButton_Click"
                Visibility="{Binding RoomCameraButtonVisibility, ElementName=Root}"
                Margin="4,0,4,0"
                ToolTip="{Binding IsMicrophoneMuted, ElementName=Root, StringFormat='Microphone: {0}', Converter={StaticResource BoolToMuteStatusConverter}}">
                <TextBlock 
                    Text="{Binding IsMicrophoneMuted, ElementName=Root, Converter={StaticResource BoolToMicSymbolConverter}}" 
                    FontSize="20" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"/>
            </Button>

            <!-- Room Camera Button -->
            <Button 
                x:Name="RoomCameraButton"
                Grid.Column="2" 
                Content="Room Camera" 
                Click="RoomCameraButton_Click"
                IsEnabled="{Binding IsRoomCameraButtonEnabled, ElementName=Root}"
                Visibility="{Binding RoomCameraButtonVisibility, ElementName=Root}"
                Margin="4,0,4,0"
                Style="{StaticResource CameraButtonStyle}"/>

            <!-- Head Camera Button -->
            <Button 
                x:Name="HeadCameraButton"
                Grid.Column="3" 
                Content="Head Camera" 
                Click="HeadCameraButton_Click"
                IsEnabled="{Binding IsHeadCameraButtonEnabled, ElementName=Root}"
                Visibility="{Binding HeadCameraButtonVisibility, ElementName=Root}"
                Margin="4,0,8,0"
                Style="{StaticResource CameraButtonStyle}"/>
        </Grid>

        <userControls:TaskOverlay 
            Grid.Row="0"
            Visibility="{Binding CurrentTask.IsSuccessfullyCompleted, ElementName=Root, Converter={converters:BooleanToInvisibilityConverter}, FallbackValue=Collapsed}"
            ObservedTask="{Binding CurrentTask, ElementName=Root}"
            Description="{Binding CurrentTask.ErrorMessage, ElementName=Root}"
            CornerRadius="{StaticResource BlockInnerCornerRadius}"/>
    </Grid>
</UserControl>
