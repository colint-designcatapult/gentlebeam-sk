<UserControl 
    x:Class="Xcc.Application.UI.UserControls.ProfileImageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Xcc.Application.UI.UserControls"
    xmlns:converters="clr-namespace:Xcc.Application.UI.Converters"

    mc:Ignorable="d" 
    d:DesignHeight="320" d:DesignWidth="320">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DrawingImage x:Key="GenericUserIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource ButtonStrokeColor}">
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M34.5 12C27.2 12 21.2 17.8 21.2 25 21.2 32.2 27.2 38 34.5 38 41.8 38 47.8 32.2 47.8 25 47.8 17.8 41.8 12 34.5 12ZM34.5 16C39.7 16 43.8 20 43.8 25 43.8 30 39.7 34 34.5 34 29.3 34 25.2 30 25.2 25 25.2 20 29.3 16 34.5 16ZM30 38.1C20.5 38.1 12.6 45.6 12.6 55 12.6 57.8 14.9 60 17.7 60H51.2C53.9 60 56.3 57.8 56.3 55V55C56.3 45.7 48.5 38.1 39 38.1ZM30 42.1H39C46.4 42.1 52.4 47.9 52.3 55V55C52.3 55.5 51.9 56 51.2 56H17.7C17.1 56 16.6 55.5 16.6 55 16.6 47.9 22.5 42.1 30 42.1Z"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2.5*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Ellipse
            Grid.ColumnSpan="3" Grid.RowSpan="3"
            RenderOptions.BitmapScalingMode="Linear" Fill="#808080"/>

        <Image 
            Grid.Row="1" Grid.Column="1"
            Source="{StaticResource GenericUserIcon}"/>

        <!--Patient photo-->
        <Ellipse 
            Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="3"
            RenderOptions.BitmapScalingMode="HighQuality"
            Margin="2">

            <Ellipse.Fill>
                <ImageBrush 
                    Stretch="UniformToFill" 
                    ImageSource="{Binding PathToImage, RelativeSource={RelativeSource AncestorType=local:ProfileImageControl}, Converter={converters:PathToImageSourceConverter}}"/>
            </Ellipse.Fill>
        </Ellipse>            
    </Grid>
</UserControl>
