<UserControl x:Class="Xcc.Application.UI.UserControls.RadiationHazardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Xcc.Application.UI.UserControls"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:svg="https://github.com/dotnetprojects/SVGImage" 
             xmlns:conv="clr-namespace:Xcc.Application.UI.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:system="clr-namespace:System;assembly=netstandard">

    <UserControl.Resources>
        <ResourceDictionary>
            <system:Double x:Key="IconRadius">256</system:Double>
            <system:Double x:Key="IconSize">512</system:Double>
            
            <PathGeometry 
                x:Key="RadiationHazardIcon"
                Figures="
                M 256 302.3 c 25.6 0 46.3 -20.7 46.3 -46.3 s -20.7 -46.3 -46.3 -46.3 s -46.3 21.6 -46.3 46.3 C 209.7 280.7 230.4 302.3 256 302.3 z 
                M 217.9 195.1 L 154.2 93.2 c -9.2 -14.7 -29.5 -18.3 -42.6 -7.2 C 71.1 120.3 43 168.6 35 223.4 C 32.4 240.6 46.3 256 63.7 256 h 120.3 C 183.9 230.3 197.6 207.9 217.9 195.1 z 
                M 400.5 86.1 c -13.2 -11.2 -33.4 -7.5 -42.6 7.2 l -63.8 101.8 c 20.3 12.9 34 35.2 34 60.9 h 120.3 c 17.4 0 31.2 -15.4 28.7 -32.6 C 468.9 168.6 440.9 120.3 400.5 86.1 z 
                M 294.1 316.8 C 283.1 323.8 270 328 256 328 c -14 0 -27.1 -4.2 -38.1 -11.1 l -63.7 101.9 c -9.1 14.6 -3.7 34.3 12 41.3 c 27.5 12.2 57.9 19 89.9 19 s 62.4 -6.8 89.9 -19 c 15.7 -7 21.1 -26.7 12 -41.3 L 294.1 316.8 z" 
                FillRule="Nonzero"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Viewbox 
            Stretch="Uniform"
            Visibility="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type local:RadiationHazardControl}}, Converter={conv:BooleanToInvisibilityConverter}}">
            
            <Canvas UseLayoutRounding="False" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Ellipse Canvas.Left="0" Canvas.Top="0" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" Fill="#ff454545"/>
                <Path Fill="#ff282828" Data="{StaticResource RadiationHazardIcon}"/>
            </Canvas>
        </Viewbox>

        <Viewbox 
            Stretch="Uniform"
            Visibility="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type local:RadiationHazardControl}}, Converter={conv:BooleanToVisibilityConverter}}">
            
            <Canvas UseLayoutRounding="False" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Canvas.Clip>
                    <EllipseGeometry RadiusX="{StaticResource IconRadius}" RadiusY="{StaticResource IconRadius}" Center="256,256"/>
                </Canvas.Clip>

                <Canvas.OpacityMask>
                    <SolidColorBrush Color="Black"/> 
                </Canvas.OpacityMask>

                <Ellipse x:Name="RadiationHazardBackground" Canvas.Left="0" Canvas.Top="0" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" Fill="Orange"/>

                <Ellipse 
                    Visibility="Visible" 
                    RenderTransformOrigin="0.5,0.5" 
                    Canvas.Left="0" Canvas.Top="0" 
                    Width="{StaticResource IconSize}" Height="{StaticResource IconSize}"
                    Opacity="0.5">

                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00ffa21a" Offset="0.05"></GradientStop>
                            <GradientStop Color="#ffe90000" Offset="0.4"></GradientStop>
                            <GradientStop Color="#ffe90000" Offset="0.6"></GradientStop>
                            <GradientStop Color="#00ffa21a" Offset="0.95"></GradientStop>
                        </RadialGradientBrush>
                    </Ellipse.Fill>

                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ScaleAnimation" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>

                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation 
                                        Storyboard.TargetName="ScaleAnimation"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                        From="0" To="4" 
                                        BeginTime="0:0:0"
                                        Duration="00:00:02.000" />
                                    <DoubleAnimation 
                                        Storyboard.TargetName="ScaleAnimation"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                        From="4" To="8" 
                                        BeginTime="0:0:2"
                                        Duration="00:00:00.800" />

                                    <DoubleAnimation 
                                        Storyboard.TargetName="ScaleAnimation"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                        From="0" To="4" 
                                        BeginTime="0:0:0"
                                        Duration="00:00:02.000" />
                                    <DoubleAnimation 
                                        Storyboard.TargetName="ScaleAnimation"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                        From="4" To="8" 
                                        BeginTime="0:0:2"
                                        Duration="00:00:00.800" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Path Fill="Black" Data="{StaticResource RadiationHazardIcon}"/>
            </Canvas>
        </Viewbox>

        <Ellipse 
            x:Name="ProgressCircle" 
            RenderTransformOrigin="0.5, 0.5"
            StrokeThickness="0" 
            Fill="Transparent">
            
            <Ellipse.LayoutTransform>
                <RotateTransform Angle="-90" />
            </Ellipse.LayoutTransform>
        </Ellipse>
    </Grid>
</UserControl>
