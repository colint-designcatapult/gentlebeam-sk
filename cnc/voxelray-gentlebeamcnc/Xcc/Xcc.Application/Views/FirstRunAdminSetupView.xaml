<ContentControl
    x:Class="Xcc.Application.Views.FirstRunAdminSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    
    xmlns:prism="http://prismlibrary.com/"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    xmlns:viewModels="clr-namespace:Xcc.Application.ViewModels"
    
    prism:ViewModelLocator.AutoWireViewModel="True"
    UseLayoutRounding="True"
    FontSize="{StaticResource BaseFontSize}"
    IsTabStop="False"
    mc:Ignorable="d" 
    d:DesignWidth="500" d:DesignHeight="600"
    d:DataContext="{d:DesignInstance {x:Type viewModels:FirstRunAdminSetupViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockErrorStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/KeyboardToggleButtonStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/RevealToggleButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBox/XccTextBoxDefaultStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Background="{StaticResource BlockBackgroundColor}"
        CornerRadius="8"
        BorderBrush="{StaticResource BlockBorderColor}"
        BorderThickness="1"
        MinWidth="500"
        MaxWidth="600">

        <DockPanel Margin="{StaticResource BlockContentMargin}">
            <!-- Title -->
            <TextBlock
                DockPanel.Dock="Top"
                Style="{StaticResource TextBlockLegendStyle}"
                FontSize="{StaticResource LargeFontSize}"
                HorizontalAlignment="Center"
                Text="Create Administrator Account"
                Margin="0,0,0,20" />

            <!-- Description -->
            <TextBlock
                DockPanel.Dock="Top"
                Style="{StaticResource TextBlockLegendStyle}"
                Text="No administrator account exists. Please create one to continue."
                TextWrapping="Wrap"
                Margin="0,0,0,20" />

            <!-- Loading/Error indicator -->
            <ContentPresenter
                DockPanel.Dock="Top"
                Content="{Binding SetupTask}"
                Margin="0,0,0,20"
                Visibility="{Binding SetupTask, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Converter={convx:ObjectToVisibilityConverter}}" />

            <!-- Form content -->
            <ScrollViewer
                DockPanel.Dock="Top"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,20">

                <StackPanel>

                    <!-- First Name -->
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource TextBlockLegendStyle}"
                            Text="First Name *" />
                        <controls:XccTextBox
                            Text="{Binding UserToEdit.FirstName, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />
                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[FirstName], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Last Name -->
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource TextBlockLegendStyle}"
                            Text="Last Name *" />
                        <controls:XccTextBox
                            Text="{Binding UserToEdit.LastName, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />
                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[LastName], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource TextBlockLegendStyle}"
                            Text="Email *" />
                        <controls:XccTextBox
                            Text="{Binding UserToEdit.EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />
                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[EmailAddress], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource TextBlockLegendStyle}"
                            Text="Username *" />
                        <controls:XccTextBox
                            Text="{Binding UserToEdit.Username, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />
                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[Username], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource TextBlockLegendStyle}"
                                Text="Password *" />

                            <ToggleButton
                                Grid.Column="1"
                                Style="{StaticResource RevealToggleButton}"
                                IsChecked="{Binding RevealPassword, Mode=TwoWay}" />
                        </Grid>

                        <controls:XccTextBox
                            FontFamily="{Binding RevealPassword, Converter={convx:PasswordFontConverter}}"
                            IsClipboardDisabled="True"
                            Text="{Binding UserToEdit.Password, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />

                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[Password], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Confirm Password -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource TextBlockLegendStyle}"
                                Text="Confirm Password *" />

                            <ToggleButton
                                Grid.Column="1"
                                Style="{StaticResource RevealToggleButton}"
                                IsChecked="{Binding RevealConfirmPassword, Mode=TwoWay}" />
                        </Grid>

                        <controls:XccTextBox
                            FontFamily="{Binding RevealConfirmPassword, Converter={convx:PasswordFontConverter}}"
                            IsClipboardDisabled="True"
                            Text="{Binding UserToEdit.PasswordConfirm, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}" />

                        <TextBlock
                            Style="{StaticResource TextBlockErrorStyle}"
                            Text="This field is required."
                            Visibility="{Binding UserToEdit[PasswordConfirm], Converter={convx:BooleanToVisibilityConverter}}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel
                DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    Height="{StaticResource ButtonHeight}"
                    Width="{StaticResource ButtonWidth}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding SetupTask, Converter={convx:ObjectIsNullConverter}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <ContentControl Content="{StaticResource CancelIcon}" Width="16" Height="16" />
                        <TextBlock Text="Cancel" Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}"/>
                    </Grid>
                </Button>

                <Button
                    Height="{StaticResource ButtonHeight}"
                    Width="{StaticResource ButtonWidth}"
                    Command="{Binding SaveCommand}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource SaveIcon}" Style="{StaticResource ButtonImageStyle}"/>
                        <TextBlock Text="Create" Grid.Column="2" Style="{StaticResource ButtonTextBlockStyle}"/>
                    </Grid>
                </Button>
            </StackPanel>

        </DockPanel>
    </Border>
</ContentControl>
