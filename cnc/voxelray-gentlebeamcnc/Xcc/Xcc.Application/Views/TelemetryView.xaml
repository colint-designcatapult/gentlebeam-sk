<ContentControl 
    x:Class="Xcc.Application.Views.TelemetryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"

    xmlns:viewModels="clr-namespace:Xcc.Application.ViewModels"
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters"    
    
    

    mc:Ignorable="d"
    d:DesignHeight="80"
    d:FontSize="{StaticResource HugeFontSize}"
    d:DataContext="{d:DesignInstance {x:Type viewModels:TelemetryViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
                
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Label/TelemetryLabelStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <GridLength x:Key="TelemetryFieldMargin">48</GridLength>

            <Style x:Key="TextBlockTelemetryLegendStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockLegendStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="{StaticResource TelemetryFieldMargin}" />
            <ColumnDefinition/>
            <ColumnDefinition Width="{StaticResource TelemetryFieldMargin}" />
            <ColumnDefinition/>
            <ColumnDefinition Width="{StaticResource TelemetryFieldMargin}" />
            <ColumnDefinition/>
            <ColumnDefinition Width="{StaticResource TelemetryFieldMargin}" />
            <ColumnDefinition/>
            <ColumnDefinition Width="{StaticResource TelemetryFieldMargin}" />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0" 
                Style="{StaticResource TextBlockTelemetryLegendStyle}"
                Text="System status"/>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}"
                Foreground="{Binding TelemetryForeground}"
                Padding="0,0,0,2"
                FontSize="26"
                FontFamily="{StaticResource BaseFont}" 
                Content="{Binding ControlBoardState, Converter={convx:TelemetryControlBoardStateNewToValueConverter}}" />
        </Grid>



        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockTelemetryLegendStyle}">
                <Run Text="Timer"/>
                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[s]"/><Run Text=":"/>
            </TextBlock>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground, FallbackValue={StaticResource TelemetryLCDForegroundDisabled}}"
                Content="{Binding SystemTelemetry.PrimaryTimerValue, FallbackValue=0.00}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockTelemetryLegendStyle}">
                <Run Text="Backup Timer"/>
                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[s]"/><Run Text=":"/>
            </TextBlock>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground, FallbackValue={StaticResource TelemetryLCDForegroundDisabled}}"
                Content="{Binding SystemTelemetry.SecondaryTimer1Value, FallbackValue=0.00}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <Grid Grid.Column="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockTelemetryLegendStyle}">
                <Run Text="Backup Timer 2"/>
                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[s]"/><Run Text=":"/>
            </TextBlock>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground, FallbackValue={StaticResource TelemetryLCDForegroundDisabled}}"
                Content="{Binding SystemTelemetry.SecondaryTimer2Value, FallbackValue=0.00}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <Grid Grid.Column="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockTelemetryLegendStyle}">
                <Run Text="Energy"/>
                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[kV]"/><Run Text=":"/>
            </TextBlock>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground, FallbackValue={StaticResource TelemetryLCDForegroundDisabled}}"
                Content="{Binding MappedKvFeedback, FallbackValue=0.00}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>

        <Grid Grid.Column="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource FieldSmallMarginGridLength}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TextBlockTelemetryLegendStyle}">
                <Run Text="Emission"/>
                <Run Foreground="{StaticResource ForegroundPaleBrush}" Text="[mA]"/><Run Text=":"/>
            </TextBlock>

            <Label 
                Grid.Row="2" 
                Style="{StaticResource TelemetryValueStyle}" 
                Foreground="{Binding TelemetryForeground, FallbackValue={StaticResource TelemetryLCDForegroundDisabled}}"
                Content="{Binding SystemTelemetry.EmissionCurrent, FallbackValue=0.00}"
                ContentStringFormat="{}{0:N2}"/>
        </Grid>
    </Grid>
</ContentControl>
