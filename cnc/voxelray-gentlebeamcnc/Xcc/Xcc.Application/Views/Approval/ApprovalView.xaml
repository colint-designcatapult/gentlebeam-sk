<ContentControl 
    x:Class="Xcc.Application.Views.Approval.ApprovalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
    xmlns:viewModels="clr-namespace:Xcc.Application.ViewModels.Approval"
                
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    
    xmlns:convx="clr-namespace:Xcc.Application.UI.Converters"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
    xmlns:ucx="clr-namespace:Xcc.Application.UI.UserControls"

    UseLayoutRounding="True"
    IsTabStop="False"
    FontSize="{StaticResource BaseFontSize}"
    
    mc:Ignorable="d" 
    d:DesignWidth="320"
    d:DesignHeight="360"
    d:DataContext="{d:DesignInstance {x:Type viewModels:ApprovalViewModel}}">

    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/DefaultStylesDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Styles/ToggleButton/RevealToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="360"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border BorderThickness="1" BorderBrush="{StaticResource BlockBorderColor}" Style="{StaticResource BorderBlockStyle}">
        <DockPanel Margin="{StaticResource BlockContentMargin}">
            <Grid DockPanel.Dock="Top">
                <TextBlock 
                    Text="{Binding Title}" 
                    Style="{StaticResource TextBlockLegendStyle}"
                    FontSize="{StaticResource HugeFontSize}"/>

                <Button 
                    HorizontalAlignment="Right"
                    Command="{Binding CloseDialogCommand}"
                    Style="{StaticResource ButtonCloseStyle}"/>
            </Grid>

            <Grid d:ShowGridLines="False" Margin="{StaticResource BlockContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                    <RowDefinition Height="{StaticResource BlockContentMarginGridLength}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource FieldHeightGridLength}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource TextBlockLegendStyle}" Text="Username"/>
                <controls:XccTextBox Grid.Row="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Style="{StaticResource TextBlockLegendStyle}" Text="Password"/>
                <!-- Password -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="{StaticResource FieldSmallMarginGridLength}"/>
                    </Grid.ColumnDefinitions>

                    <controls:XccTextBox
                        UseLayoutRounding="True"
                        Grid.ColumnSpan="3"
                        FontFamily="{Binding RevealPassword, Converter={convx:PasswordFontConverter}}"
                        IsClipboardDisabled="True"
                        Padding="4,0,20,0"
                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                    <ToggleButton 
                        Grid.Column="1" 
                        Style="{StaticResource RevealToggleButton}"
                        IsChecked="{Binding RevealPassword}"
                        Margin="0,2"/>
                </Grid>

                <TextBlock 
                    Grid.Row="5" Grid.Column="0"
                    Text="{Binding ErrorMessage}" 
                    Foreground="Crimson" 
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextAlignment="Center" 
                    Margin="12,0" 
                    FontSize="15"/>

                <Button
                    Grid.Row="7" Grid.Column="0"
                    HorizontalAlignment="Center" 
                    Height="{StaticResource ButtonHeight}" Width="{StaticResource ButtonWidth}"
                    Command="{Binding ApproveCommand}"
                    IsDefault="True">

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Approve" Style="{StaticResource ButtonLabelStyle}"/>
                    </StackPanel>
                </Button>
            </Grid>

        </DockPanel>
    </Border>
</ContentControl>
