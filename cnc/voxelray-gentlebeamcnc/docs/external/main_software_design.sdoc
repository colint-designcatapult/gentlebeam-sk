[DESIGN_ITEM]
UID: SW-H10TG-72
TITLE: Radiation Emission Control - Beam On process Sequence
STATEMENT: >>>
.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
       autonumber
       actor User
       participant ExtCC as Ext C&amp;C
       participant Boards
       participant HVPS

       User->>ExtCC: Beam On
       activate ExtCC
       Note over ExtCC: Check if the state is Ready
       
       ExtCC->>Boards: Release Point
       activate Boards

       loop foreach operational point
           ExtCC->>HVPS: Filament set point
           activate HVPS
           Note over ExtCC: "Button shows Launching progress"
           Boards->>HVPS: Start Emission
           HVPS-->>ExtCC: Operational point emission finished
           deactivate HVPS
           Note over ExtCC: "Button shows Beaming on progress"
           Note over ExtCC: "Button shows Launching progress"
       end
       deactivate Boards

       Note over ExtCC: "Button shows Clear Timers"
       deactivate ExtCC

       User->>ExtCC: Clear Timers
       activate ExtCC
       ExtCC->>Boards: Clear Timers
       activate Boards
       deactivate Boards
       deactivate ExtCC

       User->>ExtCC: Unload Plan
       activate ExtCC
       ExtCC->>Boards: Unload Plan
       activate Boards
       deactivate Boards
       deactivate ExtCC
   </pre>

.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
       autonumber
       actor User

       box Application
           participant PlanViewModel
           participant PlanModel
       end

       box Server
           participant Storage
       end

       User->>PlanViewModel: refresh treatment fields
       activate PlanViewModel
       PlanViewModel->>PlanModel: fetch fields
       activate PlanModel
       
       Note over PlanModel: clear displayed fields
       PlanModel->>Storage: query stored fields
       activate Storage
       Note over Storage: handle request
       Storage-->>PlanModel: treatment fields
       deactivate Storage
       
       Note over PlanModel: update displayed fields
       PlanModel-->>PlanViewModel: 
       PlanViewModel-->>User: display fields

       PlanViewModel->>PlanModel: validate field doses
       Note over PlanModel: verify dose calculations
       PlanModel-->>PlanViewModel: validity status
       deactivate PlanModel

       alt "validation fails"
           Note over PlanViewModel: disable treatment
           PlanViewModel-->>User: show warning
       end
       deactivate PlanViewModel
   </pre>
<<<
RELATIONS:
- TYPE: Parent
  VALUE: RQ-H10TG-9
  ROLE: Refines

[DESIGN_ITEM]
UID: SW-H10TG-74
TITLE: Radiation Emission Control - Resume Beam-On process after error is cleared - Sequence
STATEMENT: >>>
.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
       autonumber
       actor User
       participant ExtCC as Ext C&amp;C
       participant Boards
       participant HVPS

       HVPS->>Boards: Error
       activate HVPS
       activate Boards
       Boards->>ExtCC: Error
       deactivate Boards
       deactivate HVPS
       
       activate ExtCC
       Note over ExtCC: Show error indication to the user
       Note over ExtCC: "Button shows Clear Error"
       deactivate ExtCC

       User->>ExtCC: Clear Errors
       activate ExtCC
       ExtCC->>Boards: Clear Errors
       activate Boards
       deactivate Boards
       deactivate ExtCC

       User->>ExtCC: Reset timers
       activate ExtCC
       ExtCC->>Boards: Reset timers
       activate Boards
       deactivate Boards
       deactivate ExtCC

       Note over ExtCC: "Button shows Continue"
       User->>ExtCC: Continue
       activate ExtCC
       Note over ExtCC: Check if status is STAGED
       
       rect rgb(235, 247, 235)
           Note left of ExtCC: Reconfirm plan before resume emission
           loop foreach operational point
               ExtCC->>Boards: "Re-Send operational point info with new duration (confirmation)"
               activate Boards
               deactivate Boards
           end
           ExtCC->>Boards: Release Plan Command
           activate Boards
           Boards->>HVPS: Ramp HV
           activate HVPS
           HVPS-->>Boards: "HV ramp feedback. Setpoint reached"
           deactivate HVPS
           Boards-->>ExtCC: In ready State
           deactivate Boards
       end

       rect rgb(253, 238, 238)
           Note left of ExtCC: Resume emission
           ExtCC->>Boards: Release point command
           activate Boards
           loop Foreach operational point
               Boards->>Boards: Run emission
           end
           deactivate Boards
       end
       deactivate ExtCC
   </pre>
<<<
