       E -- No --> ShowError
       
       Alert --> F{"Proceed treatment?"}
       
       F -- Yes --> ProceedPrepare
       F -- No ----> EndNode([end])
       
       ProceedPrepare --> EndNode
       ShowError --> EndNode
   </pre>
