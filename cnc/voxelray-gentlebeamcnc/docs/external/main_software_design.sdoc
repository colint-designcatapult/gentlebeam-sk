[DESIGN_ITEM]
UID: SW-H10TG-257
TITLE: Record Delivered Dose
STATEMENT: >>>

.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
       autonumber
       
       box Application
           participant OperatePlanViewModelBase
           participant TreatmentModel
           participant ActualTreatmentFieldModel
           participant MainBoardModel
           participant TelemetryService
       end
       box ControlBoard
           participant Firmware
       end
       box Database
           participant TreatmentService
           participant ActualTreatmentFieldService
       end

       Note over OperatePlanViewModelBase, ActualTreatmentFieldService: User initiates emission delivery
       
       OperatePlanViewModelBase->>TreatmentModel: create new treatment
       activate OperatePlanViewModelBase
       activate TreatmentModel
       TreatmentModel->>TreatmentService: "grpc: CreateTreatment"
       activate TreatmentService
       Note over TreatmentService: create DB record
       TreatmentService-->>TreatmentModel: stored record
       deactivate TreatmentService
       deactivate TreatmentModel

       loop "[Unsolicited semantic telemetry]"
           Firmware-->>TelemetryService: "[UDP] telemetry packet"
           activate TelemetryService
           TelemetryService-->>OperatePlanViewModelBase: immutable telemetry snapshot
           deactivate TelemetryService
           
           alt "[Emission state: update the application-selected field from telemetry]"
               Note over OperatePlanViewModelBase: use application-owned ActiveEmissionIndex
               OperatePlanViewModelBase->>OperatePlanViewModelBase:
               Note over OperatePlanViewModelBase: get scalar telemetry timer values
               OperatePlanViewModelBase->>OperatePlanViewModelBase:
               OperatePlanViewModelBase->>ActualTreatmentFieldModel: "SaveActualTreatmentField(treatment, ActiveEmissionIndex, timer)"
           end
       end

       alt "[Leaving Emission state: update the application-selected field from the board]"
           OperatePlanViewModelBase->>MainBoardModel: query scalar emission data
           activate MainBoardModel
           MainBoardModel->>Firmware: indexless query emission data
           activate Firmware
           Firmware-->>MainBoardModel: scalar data response
           deactivate Firmware
           MainBoardModel-->>OperatePlanViewModelBase: scalar emission data
           deactivate MainBoardModel

           Note over OperatePlanViewModelBase: get timer value from scalar data
           OperatePlanViewModelBase->>OperatePlanViewModelBase:
           OperatePlanViewModelBase->>ActualTreatmentFieldModel: "SaveActualTreatmentField(treatment, ActiveEmissionIndex, timer)"
           activate ActualTreatmentFieldModel
           
           alt "[new actual treatment field data]"
               ActualTreatmentFieldModel->>ActualTreatmentFieldService: "grpc: CreateActualTreatmentField"
               activate ActualTreatmentFieldService
               Note over ActualTreatmentFieldService: create DB record
               ActualTreatmentFieldService-->>ActualTreatmentFieldModel: stored record
               deactivate ActualTreatmentFieldService
           end
           
           alt "[existing actual treatment field data]"
               ActualTreatmentFieldModel->>ActualTreatmentFieldService: "grpc: UpdateActualTreatmentField"
               activate ActualTreatmentFieldService
               Note over ActualTreatmentFieldService: update DB record
               ActualTreatmentFieldService-->>ActualTreatmentFieldModel: stored record
               deactivate ActualTreatmentFieldService
           end
           deactivate ActualTreatmentFieldModel
       end
       deactivate OperatePlanViewModelBase
   </pre>
<<<
