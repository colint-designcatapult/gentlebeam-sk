[DESIGN_ITEM]
UID: SW-H10TG-254
TITLE: Treatment Fields Emission Progress indicators
STATEMENT: >>>

.. raw:: html

    <pre class="mermaid">
    sequenceDiagram
        autonumber
        box Application
            participant VM as OperatePlanViewModelBase
            participant CC as CollimatorControl
            participant TFL as TreatmentFieldList
            participant EP as EmissionProgress
            participant TS as TelemetryService
        end
        box ControlBoard
            participant F as Firmware
        end

        Note over VM, F: User initiates the emission delivery

        loop Telemetry polling
            TS->>F: [UDP] request telemetry
            activate F
            F-->>TS: [UDP] telemetry response
            deactivate F
            TS-->>VM: telemetry data
            
            activate VM
            VM->>VM: get telemetry CurrentOperationalPoint index
            VM->>CC: update selection
            VM->>TFL: update selection
            
            alt Emission state
                VM->>VM: calculate emission progress
                VM->>EP: set emission progress value
            end
            
            alt Launching state
                VM->>VM: get telemetry HeaterCurrentSetpoint
                VM->>VM: calculate launching progress
                VM->>EP: set launching progress value
            end
            deactivate VM
        end
    </pre>

