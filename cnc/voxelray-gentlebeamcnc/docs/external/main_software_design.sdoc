[DESIGN_ITEM]
UID: SW-H10TG-251
TITLE: prompt the user when an interlock triggered during emission
STATEMENT: >>>
.. raw:: html

    <pre class="mermaid">
    sequenceDiagram
        actor User
        box Application
            participant VM as OperatePlanViewModelBase
            participant M as MainBoardModel
            participant D as DialogService
            participant T as TelemetryService
        end
        box ControlBoard
            participant F as Firmware
        end

        User->>VM: BeamOn
        activate VM
        VM->>M: BeamOn
        activate M
        
        M->>F: [UDP] ReleasePoint command
        activate F
        F-->>M: [UDP] status response
        deactivate F
        
        M->>M: wait for emission termination
        
        activate T
        T->>F: query telemetry
        activate F
        F-->>T: [UDP] telemetry response
        deactivate F
        T->>VM: telemetry changed
        deactivate T

        VM->>VM: check board state
        
        alt Board is in Fault state
            VM->>M: cancel current task
            M-->>VM: BeamOn task cancellation exception
            deactivate M
            VM->>D: show emission error dialog
            activate D
            D-->>User: error dialog
            deactivate D
        end
        
        deactivate VM
    </pre>

<<<

[[/SECTION]]
