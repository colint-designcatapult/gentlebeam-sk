        InterlocksViewModel->>GCBDataStore: getGcbDataStore
        GCBDataStore-->>InterlocksViewModel: return gcbDataStore
        deactivate GCBDataStore
        
        InterlocksViewModel-->>InterlocksView: return gcbInterlocks
        deactivate InterlocksViewModel
        deactivate InterlocksView
    </pre>
<<<
