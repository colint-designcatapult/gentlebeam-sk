[DESIGN_ITEM]
UID: SW-H10SG-696
TITLE: Configure Correction Matrix for Magnetometer
STATEMENT: >>>
.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
    box rgb(245, 245, 245) Application
        participant ConfigurationViewModel
        participant MagnetometerViewMode
        participant MagnetometerCorrections
        participant IReferenceFieldCommands
        participant ICorrectionMatrixCommands
    end
    
    box rgb(245, 245, 245) Server
        participant ReferenceFieldService
        participant CorrectionMatrixService
    end

    Note over ConfigurationViewModel: User selects a collimator configuration
    
    activate ConfigurationViewModel
    ConfigurationViewModel->>MagnetometerCorrections: fetch configuration data
    activate MagnetometerCorrections
    
    MagnetometerCorrections->>IReferenceFieldCommands: read reference fields by preset id
    activate IReferenceFieldCommands
    
    IReferenceFieldCommands->>ReferenceFieldService: grpc:ListReferneceFieldsRequest
    activate ReferenceFieldService
    
    ReferenceFieldService->>ReferenceFieldService: handle request
    ReferenceFieldService-->>IReferenceFieldCommands: grpc:ListReferneceFieldsResponse
    deactivate ReferenceFieldService
    
    IReferenceFieldCommands-->>MagnetometerCorrections: list of reference field records
    deactivate IReferenceFieldCommands
    
    MagnetometerCorrections->>ICorrectionMatrixCommands: read correction matrices by preset id
    activate ICorrectionMatrixCommands
    
    ICorrectionMatrixCommands->>CorrectionMatrixService: grpc:ListCorrectionMatricesRequest
    activate CorrectionMatrixService
    
    CorrectionMatrixService->>CorrectionMatrixService: handle request
    CorrectionMatrixService-->>ICorrectionMatrixCommands: grpc:ListCorrectionMatricesResponse
    deactivate CorrectionMatrixService
    
    ICorrectionMatrixCommands-->>MagnetometerCorrections: list of correction matrix records
    deactivate ICorrectionMatrixCommands
    
    MagnetometerCorrections->>MagnetometerCorrections: update configuration
    
    MagnetometerCorrections-->>MagnetometerViewMode: configuration changed
    deactivate MagnetometerCorrections
    deactivate ConfigurationViewModel
   </pre>
<<<
