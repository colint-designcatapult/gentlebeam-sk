[DESIGN_ITEM]
UID: SW-H10SG-703
TITLE: Actual Treatment Delivered
STATEMENT: >>>
.. raw:: html

   <pre class="mermaid">
   sequenceDiagram
    box rgb(245, 245, 245) Application
        participant TreatmentViewModel
        participant TreatmentHistoryModel
        participant IEmrTreatmentCommands
        participant IEmrActualTreatmentFieldCommands
    end
    
    box rgb(245, 245, 245) Server
        participant TreatmentService
        participant TreatmentFieldService
    end

    Note over TreatmentViewModel,IEmrActualTreatmentFieldCommands: current plan changed or current treatment process finished
    
    TreatmentViewModel-->>TreatmentHistoryModel: fetch/update treatment data
    activate TreatmentHistoryModel
    
    TreatmentHistoryModel->>IEmrTreatmentCommands: fetch plan treatments
    activate IEmrTreatmentCommands
    
    IEmrTreatmentCommands->>TreatmentService: grpc: ListTreatmentsRequest
    activate TreatmentService
    
    TreatmentService->>TreatmentService: handle request
    TreatmentService-->>IEmrTreatmentCommands: grpc: ListTreatmentsResponse
    deactivate TreatmentService
    
    IEmrTreatmentCommands-->>TreatmentHistoryModel: list of treatments
    deactivate IEmrTreatmentCommands
    
    loop [for each treatment record]
        TreatmentHistoryModel->>IEmrActualTreatmentFieldCommands: fetch treatment fields
        activate IEmrActualTreatmentFieldCommands
        
        IEmrActualTreatmentFieldCommands->>TreatmentFieldService: grpc:ListActualTreatmentFieldsRequest
        activate TreatmentFieldService
        
        TreatmentFieldService->>TreatmentFieldService: handle request
        TreatmentFieldService-->>IEmrActualTreatmentFieldCommands: grpc:ListActualTreatmentFieldsResponse
        deactivate TreatmentFieldService
        
        IEmrActualTreatmentFieldCommands-->>TreatmentHistoryModel: list of actual fields
        deactivate IEmrActualTreatmentFieldCommands
        
        TreatmentHistoryModel->>TreatmentHistoryModel: sort fields and set to treatment
        TreatmentHistoryModel->>TreatmentHistoryModel: build treatment summary
        
        TreatmentHistoryModel-->>TreatmentViewModel: 
    end
    deactivate TreatmentHistoryModel
   </pre>
<<<

