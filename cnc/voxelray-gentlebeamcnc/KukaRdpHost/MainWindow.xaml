<Window x:Class="KukaRdpHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="KUKA RDP"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Close Button -->
        <Grid Grid.Row="0">
            <Button x:Name="CloseSmartpad"
                    Content="✕"
                    FontSize="28"
                    FontWeight="Bold"
                    Background="#4A4A4A"
                    Foreground="White"
                    BorderBrush="#3A3A3A"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
                    Click="CloseButton_Click" />
        </Grid>
        <!-- Spinner + RDP -->
        <Grid Grid.Row="1">
            <!-- 8-dot Spinner with Centered Text -->
            <Canvas x:Name="DotSpinner"
                    Width="100"
                    Height="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <!-- 8 dots arranged in a circle -->
                <Ellipse x:Name="Dot0"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="44"
                         Canvas.Top="0" />
                <Ellipse x:Name="Dot1"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="65"
                         Canvas.Top="10" />
                <Ellipse x:Name="Dot2"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="76"
                         Canvas.Top="31" />
                <Ellipse x:Name="Dot3"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="65"
                         Canvas.Top="52" />
                <Ellipse x:Name="Dot4"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="44"
                         Canvas.Top="62" />
                <Ellipse x:Name="Dot5"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="23"
                         Canvas.Top="52" />
                <Ellipse x:Name="Dot6"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="12"
                         Canvas.Top="31" />
                <Ellipse x:Name="Dot7"
                         Width="18"
                         Height="18"
                         Fill="Gray"
                         Canvas.Left="23"
                         Canvas.Top="10" />
                <!-- Centered Connecting Text -->
                <TextBlock Text="Connecting"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           Canvas.Left="10"
                           Canvas.Top="85"
                           Width="auto"
                           TextAlignment="Center" />
            </Canvas>
            <!-- RDP Host -->
            <wfi:WindowsFormsHost x:Name="RdpHost"
                                  Visibility="Collapsed"
                                  Opacity="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
