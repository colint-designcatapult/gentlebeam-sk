<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:Xcc.Styles.InternalControls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="FolderTabItem" TargetType="TabItem" >
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="#202020" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <!--  Setting FontSize value here also will override for entire tab content  -->
        <!--<Setter Property="FontSize" Value="{StaticResource LargeFontSize}"/>-->
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="-8,0,0,0">
                        <ic:XccTrapezoidBorder
                            x:Name="Border"
                            UseLayoutRounding="False"
                            Stroke="#4a4a4a"
                            Background="{TemplateBinding Background}"
                            IsClosed="False"
                            IsTabStop="False">
                            
                            <ContentPresenter 
                                UseLayoutRounding="True"
                                Margin="32,6"
                                ContentSource="Header"/>    
                        </ic:XccTrapezoidBorder>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Stroke" Value="{StaticResource BlockBorderBrush}"/>
                            <Setter TargetName="Border" Property="Margin" Value="0,0,0,-1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ForegroundSelectedBrush}" />
                <Setter Property="Background" Value="{StaticResource ApplicationBackgroundColor}" />
                <Setter Property="Panel.ZIndex" Value="1000" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource FieldDisabledForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FolderTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderTabItem}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid Margin="{TemplateBinding Padding}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border 
                            x:Name="ContentHost"
                            Grid.Row="1"
                            KeyboardNavigation.TabNavigation="Local"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            KeyboardNavigation.TabIndex="2"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BlockBorderBrush}"
                            CornerRadius="1,8,8,8">

                            <!--<Grid x:Name="PART_ItemsHolder" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />-->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>

                        <TabPanel 
                            x:Name="HeaderPanel"
                            Grid.Row="0"
                            IsItemsHost="True"
                            KeyboardNavigation.TabIndex="1"
                            Background="Transparent"
                            Margin="8,0,8,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>