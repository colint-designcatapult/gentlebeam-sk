<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Xcc.Styles.Converters">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml"/>

        <ResourceDictionary>
            <Brush x:Key="BatterySegment">#759e21</Brush>
            <Brush x:Key="BatteryOutline">LightGray</Brush>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ProgressBarBatteryStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="IsIndeterminate" Value="False" />
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="Foreground" Value="LightGray"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar" >
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border 
                                Grid.RowSpan="3" Grid.Column="1"
                                BorderThickness="2"
                                BorderBrush="{StaticResource BatteryOutline}"
                                x:Name="PART_Track" 
                                CornerRadius="3">

                                <Grid Margin="1,2,1,2" x:Name="PART_Segments">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/> 
                                    </Grid.ColumnDefinitions>

                                    <Border 
                                        Margin="1,0,1,0"
                                        Grid.Column="0"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">

                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>

                                    <Border 
                                        Margin="1,0"
                                        Grid.Column="1"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">
                                        
                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>

                                    <Border 
                                        Margin="1,0"
                                        Grid.Column="2"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">
                                        
                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>

                                    <Border 
                                        Margin="1,0"
                                        Grid.Column="3"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">

                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>

                                    <Border 
                                        Margin="1,0"
                                        Grid.Column="4"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">
                                        
                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>

                                    <Border 
                                        Margin="1,0,1,0"
                                        Grid.Column="5"
                                        CornerRadius="1"
                                        Background="{TemplateBinding Background}">

                                        <Border.Visibility>
                                            <MultiBinding Converter="{converters:ProgressBarSegmentsVisibilityConverter}" >
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="(Grid.Column)" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="ColumnDefinitions.Count" ElementName="PART_Segments"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Left"
                                BorderThickness="2"
                                BorderBrush="{TemplateBinding Foreground}"
                                CornerRadius="0.5,0,0,0.5"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>