<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>
        
    <Style x:Key="ToggleButtonSwitchStyle" TargetType="ToggleButton">
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundDefaultBrush}"/>
        <Setter Property="IsChecked" Value="{x:Null}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter 
                            x:Name="PART_Tag"
                            Margin="{StaticResource BlockContentSmallMarginRight}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Tag}"/>

                        <Border
                            x:Name="PART_Outline"
                            Grid.Column="1"
                            Width="{StaticResource ToggleButtonTrackOutlineWidth}" Height="{StaticResource ToggleButtonTrackOutlineHeight}"
                            CornerRadius="10"
                            Visibility="Hidden"
                            Background="{StaticResource ForegroundFocusedBrush}"/>

                        <!--Checkbox mark-->
                        <Border 
                            x:Name="Track"
                            Grid.Column="1"
                            Width="{StaticResource ToggleButtonTrackWidth}"
                            Height="{StaticResource ToggleButtonTrackHeight}"
                            Background="{StaticResource ButtonBackgroundBrush}"
                            CornerRadius="8">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border 
                                    Grid.Column="0"
                                    x:Name="PART_SwitchLeft"
                                    Background="{StaticResource CheckedBackgroundColor}"
                                    CornerRadius="8,7,7,8"
                                    Visibility="Collapsed"/>
                                
                                <Border 
                                    Grid.Column="1"
                                    x:Name="PART_SwitchRight"
                                    Background="{StaticResource CheckedBackgroundColor}"
                                    CornerRadius="7,8,8,7"
                                    Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        
                        <ContentPresenter 
                            x:Name="PART_Content"
                            Margin="{StaticResource BlockContentSmallMarginLeft}"
                            VerticalAlignment="Center"
                            Grid.Column="2"
                            Content="{TemplateBinding Content}"/>
                    </Grid>
                        
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_SwitchLeft" Property="Background" Value="{StaticResource ForegroundPaleBrush}"/>
                            <Setter TargetName="PART_SwitchRight" Property="Background" Value="{StaticResource ForegroundPaleBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundPaleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_SwitchLeft" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_SwitchRight" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="PART_Content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="PART_Tag" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_Outline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>    
</ResourceDictionary>