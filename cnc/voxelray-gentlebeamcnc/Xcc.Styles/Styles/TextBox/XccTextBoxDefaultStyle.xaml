<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBox/TextBoxBaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockValidationErrorStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="XccTextBoxDefaultStyle" TargetType="{x:Type controls:XccTextBox}" BasedOn="{StaticResource TextBoxBaseStyle}">
        <Setter Property="Padding" Value="2,1"/>
    
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XccTextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TagWidth"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ContentControl 
                            Name="PART_Tag"
                            Grid.Row="0" Grid.Column="1"
                            Content="{TemplateBinding Tag}" 
                            FontFamily="{StaticResource BaseFont}"
                            Foreground="{StaticResource ForegroundDefaultBrush}"
                            FontWeight="SemiBold"
                            IsTabStop="False"
                            Margin="{StaticResource FieldLegendMargin}"
                            Visibility="Visible"/>

                        <Border 
                            Name="Border"
                            Grid.Row="1" Grid.Column="1"
                            CornerRadius="{StaticResource FieldCornerRadius}" 
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ContentControl 
                                    Name="PART_Icon"
                                    IsTabStop="False"
                                    Content="{TemplateBinding Icon}"/>

                                <ScrollViewer Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid>
                                        <TextBlock 
                                            x:Name="PART_Watermark"
                                            Text="{TemplateBinding Watermark}"
                                            FontFamily="{StaticResource BaseFont}"
                                            Foreground="{StaticResource FieldWatermarkColor}" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            Visibility="Collapsed"/>
                                        
                                        <Decorator x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Popup 
                            Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                            x:Name="ErrorMessage"
                            Placement="Bottom"
                            VerticalOffset="3"
                            AllowsTransparency="True">

                            <Border
                                Background="{StaticResource FieldValidationErrorBrush}"
                                CornerRadius="{StaticResource FieldCornerRadius}"
                                Margin="0,3,0,0">

                                <TextBlock 
                                    Margin="6"
                                    Style="{StaticResource TextBlockValidationErrorStyle}"
                                    Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(Validation.Errors)/ErrorContent}"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>

                            <Setter Property="IsOpen" TargetName="ErrorMessage" Value="True"/>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource FieldIsMouseOverBorderBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource ForegroundFocusedBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="true">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource FieldValidationErrorBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="2"/>
                            <Setter Property="Margin" TargetName="Border" Value="-1"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_Watermark" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Static system:String.Empty}">
                            <Setter Property="Visibility" TargetName="PART_Watermark" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_Tag" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_Icon" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="TagPosition" Value="Left">
                            <Setter Property="Grid.Column" TargetName="PART_Tag" Value="0"/>
                            <Setter Property="Grid.Row" TargetName="PART_Tag" Value="1"/>
                            <Setter Property="HorizontalAlignment" TargetName="PART_Tag" Value="Right"/>
                            <Setter Property="VerticalAlignment" TargetName="PART_Tag" Value="Center"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldDisabledBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource FieldDisabledForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FieldDisabledBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--This style will be applied automatically to all XccTextBoxes without explicit style-->
    <Style TargetType="{x:Type controls:XccTextBox}" BasedOn="{StaticResource XccTextBoxDefaultStyle}"/>
</ResourceDictionary>