<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="RadioButtonDefaultStyle" TargetType="RadioButton" >
        <Style.Setters>
            <Setter Property="Foreground" Value="{StaticResource ForegroundDefaultBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <DockPanel Background="Transparent">
                            <Grid Width="24" Height="24">
                                <Ellipse 
                                    x:Name="PART_Border" 
                                    Fill="Transparent" 
                                    StrokeThickness="2"
                                    Stroke="{StaticResource ButtonStrokeBrush}"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                
                                <Ellipse 
                                    x:Name="PART_Ellipse" 
                                    Fill="Transparent" 
                                    Margin="5"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                            </Grid>

                            <ContentPresenter 
                                x:Name="PART_Content"
                                Margin="{StaticResource BlockContentSmallMarginLeft}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>                            
                        </DockPanel>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Ellipse" Property="Fill" Value="{StaticResource ButtonStrokeBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="PART_Ellipse" Property="Fill" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="PART_Border" Property="Fill" Value="{StaticResource ControlIsMouseOverBackground}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PART_Border" Property="Stroke" Value="{StaticResource ForegroundFocusedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Border" Property="Stroke" Value="{StaticResource ButtonDisabledStrokeBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ForegroundPaleBrush}"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <!--This style will be applied automatically to all RadioButtons without explicit style-->
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButtonDefaultStyle}"/>
</ResourceDictionary>