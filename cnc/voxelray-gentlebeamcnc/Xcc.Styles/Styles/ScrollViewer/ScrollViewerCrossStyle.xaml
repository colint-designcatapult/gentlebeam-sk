<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border 
                        x:Name="Border"
                        CornerRadius="4"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="Transparent">

                        <Path 
                            x:Name="Arrow"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                            Fill="{DynamicResource ButtonStrokeColor}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrollBarButtonsMouseOverBackgroundBrush }"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrollBarButtonsMousePressedBackgroundBrush }"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--ScrollBar line up button-->
            <RepeatButton 
                Grid.Row="0"
                BorderThickness="0"
                BorderBrush="{StaticResource BlockBorderBrush}"
                Style="{StaticResource ScrollBarLineButton}"
                Height="{StaticResource ScrollBarButtonSize}"
                Command="ScrollBar.LineUpCommand"
                Content="M1 7H2V6H3V5H4V4H5V3H6V4H7V5H8V6H9V7H10V6H11V5H10V4H9V3H8V2H7V1H6V0H5V1H4V2H3V3H2V4H1V5H0V6H1Z"/>

            <!--ScrollBar line down button-->
            <RepeatButton 
                Grid.Row="2"
                BorderThickness="0"
                BorderBrush="{StaticResource BlockBorderBrush}"
                Style="{StaticResource ScrollBarLineButton}"
                Height="{StaticResource ScrollBarButtonSize}"
                Command="ScrollBar.LineDownCommand"
                Content="M1 0H2V1H3V2H4V3H5V4H6V3H7V2H8V1H9V0H10V1H11V2H10V3H9V4H8V5H7V6H6V7H5V6H4V5H3V4H2V3H1V2H0V1H1Z"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--ScrollBar line left button-->
            <RepeatButton 
                Grid.Column="0"
                BorderThickness="0"
                BorderBrush="{StaticResource BlockBorderBrush}"
                Style="{StaticResource ScrollBarLineButton}"
                Width="{StaticResource ScrollBarButtonSize}"
                Command="ScrollBar.LineLeftCommand"
                Content="M7 1V2H6V3H5V4H4V5H3V6H4V7H5V8H6V9H7V10H6V11H5V10H4V9H3V8H2V7H1V6H0V5H1V4H2V3H3V2H4V1H5V0H6V1Z"/>

            <!--ScrollBar line right button-->
            <RepeatButton 
                Grid.Column="2"
                BorderThickness="0"
                BorderBrush="{StaticResource BlockBorderBrush}"
                Style="{StaticResource ScrollBarLineButton}"
                Width="{StaticResource ScrollBarButtonSize}"
                Command="ScrollBar.LineRightCommand"
                Content="M0 1V2H1V3H2V4H3V5H4V6H3V7H2V8H1V9H0V10H1V11H2V10H3V9H4V8H5V7H6V6H7V5H6V4H5V3H4V2H3V1H2V0H1V1Z"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="ScrollBarCrossStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Orientation"  Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
            </Trigger>

            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="OpacityMask">
                    <Setter.Value>
                        <StaticResource ResourceKey="DisabledControlOpacityMaskBrush" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
    ScrollViewer style in which the scrollable content is located in the center,
    and the ScrollBar buttons are around the perimeter in the form of a cross 
    -->
    <Style x:Key="ScrollViewerCrossStyle"  TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ScrollContentPresenter Grid.Row="1" Grid.Column="1" CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <!--'Up' ScrollBar button placeholder-->
                        <FrameworkElement 
                            Height="{StaticResource ScrollBarButtonSize}" 
                            Grid.Row="0" 
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        
                        <!--'Down' ScrollBar button placeholder-->
                        <FrameworkElement 
                            Height="{StaticResource ScrollBarButtonSize}" 
                            Grid.Row="2"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        
                        <!--'Left' ScrollBar button placeholder-->
                        <FrameworkElement 
                            Width="{StaticResource ScrollBarButtonSize}"
                            Grid.Column="0" 
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        
                        <!--'Right' ScrollBar button placeholder-->
                        <FrameworkElement 
                            Width="{StaticResource ScrollBarButtonSize}" 
                            Grid.Column="2"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        
                        <ScrollBar 
                            x:Name="PART_VerticalScrollBar"
                            Grid.RowSpan="3" Grid.ColumnSpan="3"
                            Style="{StaticResource ScrollBarCrossStyle}"
                            Value="{TemplateBinding VerticalOffset}"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        <ScrollBar 
                            x:Name="PART_HorizontalScrollBar"
                            Grid.RowSpan="3" Grid.ColumnSpan="3"
                            Style="{StaticResource ScrollBarCrossStyle}"
                            Orientation="Horizontal"
                            Value="{TemplateBinding HorizontalOffset}"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>