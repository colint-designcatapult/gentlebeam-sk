<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Icons/CommonIcons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/Constants.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Xcc.Application;Component/UI/Resources/ColorResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="PlayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#8f8f8f" />
        <Setter Property="Foreground" Value="{StaticResource ButtonStrokeColor}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Width="{TemplateBinding Height}" Height="{TemplateBinding Width}">
                        <Ellipse x:Name="PART_Border" Fill="{TemplateBinding Background}"/>
                        <Path
                            Width="20" Height="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stretch="Uniform"
                            Margin="3,0,0,0"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="3"
                            Data="{StaticResource PlayMediaIcon}">
                        </Path>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Stroke" TargetName="PART_Border" Value="{StaticResource SelectedForegroundBrush}"/>
                            <Setter Property="StrokeThickness" TargetName="PART_Border" Value="2"/>
                            <Setter Property="Margin" TargetName="PART_Border" Value="-1"/>
                        </Trigger>                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>