<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:Xcc.Styles.InternalControls">

    <Style TargetType="{x:Type ic:XccTrapezoidBorder}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ic:XccTrapezoidBorder}">
                    <Grid>
                        <Path 
                            x:Name="PART_BorderPath"
                            Stroke="{TemplateBinding Stroke}"
                            Fill="{TemplateBinding Background}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"/>
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>