<Window x:Class="GcbTelemetryPresenter.Views.PresenterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:GcbTelemetryPresenter"

        xmlns:prism="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:GcbTelemetryPresenter.UI.Converters"
        xmlns:behaviors="clr-namespace:GcbTelemetryPresenter.UI.Behaviors"
        prism:ViewModelLocator.AutoWireViewModel="True"  

        Title="MainWindow" Height="900" Width="1050" FontSize="16">

    <Window.Resources>
        <converters:TelemetryWithDateTimeConverter x:Key="MessageConverter" />

        <Style x:Key="ListViewStyle" TargetType="ListView">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Orange" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Files: " Margin="3"/>

            <ListView Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                      ItemsSource="{Binding Filenames}"
                      SelectedItem="{Binding SelectedFilename}"
                      behaviors:ScrollIntoViewBehavior.EnableScrollIntoView="True"
                      Style="{StaticResource ListViewStyle}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding>
                                    <Binding.Converter>
                                        <converters:FullPathToFilenameConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Column="0" Grid.Row="2"
                    Command="{Binding PrevFileCommand}"
                    Content="&lt;" 
                    Margin="3"
                    Height="40"
                    Width="120"/>

            <Button Grid.Column="1" Grid.Row="2" 
                    Command="{Binding NextFileCommand}"
                    Content=">"
                    Margin="3"
                    Height="40"
                    Width="120"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Messages: " Margin="3" HorizontalAlignment="Center"/>

            <ListView Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4"
                      ItemsSource="{Binding TelemetryMessages}"
                      SelectedItem="{Binding SelectedTelemetryMessage}"
                      behaviors:ScrollIntoViewBehavior.EnableScrollIntoView="True"
                      Style="{StaticResource ListViewStyle}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="DateTime" StringFormat="{}{0:dd.MM.yyyy HH:mm:ss:ffff}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Column="0" Grid.Row="2"
                    Command="{Binding JumpPrevMessageCommand}"
                    Content="&lt;&lt;" 
                    Margin="3"
                    Height="40"
                    Width="60"/>

            <Button Grid.Column="1" Grid.Row="2"
                    Command="{Binding PrevMessageCommand}"
                    Content="&lt;" 
                    Margin="3"
                    Height="40"
                    Width="60"/>

            <Button Grid.Column="2" Grid.Row="2" 
                    Command="{Binding NextMessageCommand}"
                    Content=">"
                    Margin="3"
                    Height="40"
                    Width="60"/>


            <Button Grid.Column="3" Grid.Row="2" 
                    Command="{Binding JumpNextMessageCommand}"
                    Content=">>"
                    Margin="3"
                    Height="40"
                    Width="60"/>
        </Grid>

        <TextBox Grid.Column="2" 
                 IsReadOnly="True"
                 FontFamily="Courier New"
                 Text="{Binding SelectedTelemetryMessage, Converter={StaticResource MessageConverter}, Mode=OneWay}"/>
    </Grid>
</Window>
