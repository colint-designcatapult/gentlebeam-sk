<Window 
    x:Class="Xcc.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Xcc.Controls;assembly=Xcc.Controls"
        mc:Ignorable="d"

        Style="{StaticResource WindowDefaultStyle}"

        Title="MainWindow" Height="940" Width="1200">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Border/BorderBlockStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Border/BorderOutlineStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonCloseStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Button/ButtonDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/CheckBox/CheckBoxDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/CheckBox/CheckBoxSliderStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/CheckBox/CheckBoxThumbStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/ComboBox/ComboBoxDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/GroupBox/GroupBoxDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/ProgressBar/ProgressBarDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/RadioButton/RadioButtonDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/Slider/SliderDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBlock/TextBlockLegendStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/TextBox/XccTextBoxDefaultStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Xcc.Styles;Component/Styles/ToggleButton/ToggleButtonSwitchStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <PathGeometry x:Key="SaveIcon" Figures="M5 1V4.8C5 7 5 7 7 7h7c2 0 2 0 2-2.2V1h1.2c.7 0 1.3.3 1.8.8l3.3 3.4c.4.5.7 1.1.7 1.8V20.4c0 1.4-1.2 2.6-2.6 2.6H3.5C2.1 23 .9 21.8.9 20.4V3.6C.9 2.2 2.1 1 3.5 1ZM16 1H5M16 15a4 4 0 00-4-4A4 4 0 008 15a4 4 0 004 4 4 4 0 004-4Z"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ApplicationBackgroundColor}">
        <Border Style="{StaticResource BorderOutlineStyle}" Margin="{StaticResource  ViewMargin}">
            <Border Style="{StaticResource BorderBlockStyle}" Margin="{StaticResource BlockContentMargin}">
                <Grid Margin="{StaticResource BlockContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource BlockContentMarginGridLength}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Style="{StaticResource ButtonCloseStyle}" HorizontalAlignment="Right"/>
                    
                    <GroupBox Grid.Row="2" Header="Controls">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--TextBox and ComboBox-->
                            <Grid Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="{StaticResource FieldHeightGridLength}" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>


                                <!--TextBox-->
                                <TextBlock Grid.Column="0" Style="{StaticResource TextBlockLegendStyle}">
                                    <Run Text="TextBox" ></Run>
                                    <Run Text="[Units]: " Foreground="{StaticResource ForegroundPaleBrush}"></Run>
                                </TextBlock>
                                
                                <controls:XccTextBox Grid.Row="2" Grid.Column="0" Watermark="Please input something"/>


                                <!--ComboBox-->
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TextBlockLegendStyle}" Text="ComboBox:"/>

                                <ComboBox Grid.Row="2" Grid.Column="2">
                                    <ComboBoxItem>One</ComboBoxItem>
                                    <ComboBoxItem>Two</ComboBoxItem>
                                    <ComboBoxItem>Three</ComboBoxItem>
                                </ComboBox>
                            </Grid>


                            <!--Tagged TextBox-->
                            <Grid Grid.Row="1" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="{StaticResource TaggedFieldGridLength}" />
                                </Grid.RowDefinitions>

                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--Tagged TextBox-->
                                <controls:XccTextBox Grid.Row="2" Watermark="Please input something" Tag="TextBox with a legend integrated to the template"/>


                                <!--Tagged ComboBox-->
                                <ComboBox Grid.Row="2" Grid.Column="2" Tag="ComboBox with a legend integrated to the template:">
                                    <ComboBoxItem>One</ComboBoxItem>
                                    <ComboBoxItem>Two</ComboBoxItem>
                                    <ComboBoxItem>Three</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            
                            <!--Button-->
                            <Grid Grid.Row="3" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="2.3*" />
                                </Grid.ColumnDefinitions>


                                <TextBlock Style="{StaticResource TextBlockLegendStyle}" Text="Buttons:"/>

                                <Button 
                                    Grid.Column="0" Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    Height="{StaticResource ButtonHeight}" Width="{StaticResource ButtonWidth}">
                                
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Path Data="{StaticResource SaveIcon}" Style="{StaticResource PathButtonStyle}"/>
                                        <TextBlock Text="Press me" Grid.Column="2" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </Grid>
                                </Button>

                                <Button 
                                    Grid.Column="2" Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Height="{StaticResource ButtonHeight}" Width="{StaticResource ButtonWidth}">
                                
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Path Data="{StaticResource SaveIcon}" Style="{StaticResource PathButtonStyle}"/>
                                        <TextBlock Text="You can't press me" Grid.Column="2" Style="{StaticResource TextBlockButtonStyle}"/>
                                    </Grid>
                                </Button>

                                <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TextBlockLegendStyle}" Text="ToggleButton:"/>

                                <ToggleButton
                                    Grid.Row="2" Grid.Column="4"
                                    Style="{StaticResource  ToggleButtonSwitchStyle}"
                                    IsChecked="True"
                                    Tag="Left option"
                                    Content="Right option"/>


                                <TextBlock Grid.Row="0" Grid.Column="6" Style="{StaticResource TextBlockLegendStyle}" Text="CheckBox:"/>

                                <CheckBox
                                    Grid.Row="2" Grid.Column="6"
                                    Style="{StaticResource  CheckBoxSliderStyle}"
                                    IsChecked="True"
                                    Content="Three state styled slider checkbox"/>
                            </Grid>


                            <!--RadioButton-->
                            <Grid Grid.Row="4" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Style="{StaticResource TextBlockLegendStyle}" Text="RadioButton:"/>

                                <RadioButton Grid.Column="0" Grid.Row="2" Content="Option 1"/>
                                <RadioButton Grid.Column="2" Grid.Row="2" Content="Option 2"/>
                                <RadioButton IsEnabled="False" Grid.Column="4" Grid.Row="2" Content="Option 3"/>
                            </Grid>


                            <!--CheckBox-->
                            <Grid Grid.Row="5" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Style="{StaticResource TextBlockLegendStyle}" Text="CheckBox:"/>

                                <CheckBox IsChecked="True" Grid.Column="0" Grid.Row="2" Content="Option 1"/>
                                <CheckBox Grid.Column="2" Grid.Row="2" Content="Option 1"/>
                                <CheckBox IsEnabled="False" IsChecked="True"  Grid.Column="4" Grid.Row="2" Content="Option 1"/>
                            </Grid>


                            <!--Three state read-only check box used only to display some state-->
                            <Grid Grid.Row="6" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource FieldLegendMarginGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="5" Style="{StaticResource TextBlockLegendStyle}">
                                    <Run  Text="Three state read-only"/>
                                    <Run  Text="CheckBox" FontWeight="SemiBold"/>
                                    <Run  Text="used only to display state of some flag:"/>
                                </TextBlock>

                                <CheckBox 
                                    Grid.Column="0" Grid.Row="2"
                                    Content="Interlock"
                                    IsChecked="True"
                                    Style="{StaticResource CheckBoxThumbStyle}"/>

                                <CheckBox 
                                    Grid.Column="2" Grid.Row="2"
                                    Content="Is ready"
                                    Style="{StaticResource CheckBoxThumbStyle}"/>
                            </Grid>

                            <!--Slider-->
                            <Grid Grid.Row="7" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource TextBlockLegendStyle}" Text="Slider:"/>

                                <Slider Grid.Row="2" Style="{StaticResource SliderDefaultStyle}"/>
                            </Grid>

                            <!--ProgressBar-->
                            <Grid Grid.Row="8" Margin="{StaticResource BlockContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{StaticResource FieldLegendMarginGridLength}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource TextBlockLegendStyle}" Text="ProgressBar:"/>

                                <ProgressBar Grid.Row="2" Style="{StaticResource ProgressBarDefaultStyle}" Minimum="0" Maximum="100" Value="40"/>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
