<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Xcc.Controls">

    <Style TargetType="{x:Type local:XccGallery}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:XccGallery}">
                    <Grid UseLayoutRounding="True" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая граница -->
                        <Grid Grid.Column="1" x:Name="PART_LeftBorder" Width="2" Background="Black" HorizontalAlignment="Left"/>
                        <Grid Grid.Column="1" x:Name="PART_LeftGlow" Width="2" Background="Orange" HorizontalAlignment="Left" Opacity="0"/>

                        <!-- Правая граница -->
                        <Grid Grid.Column="3" x:Name="PART_RightBorder" Width="2" Background="Black" HorizontalAlignment="Right"/>
                        <Grid Grid.Column="3" x:Name="PART_RightGlow" Width="2" Background="Orange" HorizontalAlignment="Right" Opacity="0"/>

                        <!-- Левая кнопка -->
                        <Button 
                            x:Name="PART_ScrollLeftButton"
                            Grid.Column="0"
                            Width="40" Height="100" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="0,0,8,0"
                            Style="{TemplateBinding ButtonStyle}">

                            <Path 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Data="M7 2V3H6V4H5V5H4V6H3V7H4V8H5V9H6v1H7v1H8v1H7v1H6V12H5V11H4V10H3V9H2V8H1V7H0V6H1V5H2V4H3V3H4V2H5V1H6V0H7V1H8V2Z" 
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Правая кнопка -->
                        <Button 
                            x:Name="PART_ScrollRightButton"
                            Grid.Column="4"
                            Width="40" Height="100" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="8,0,0,0"
                            Style="{TemplateBinding ButtonStyle}" >

                            <Path 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Data="M1 2V3H2V4H3V5H4V6H5V7H4V8H3V9H2v1H1v1H0v1H1v1H2V12H3V11H4V10H5V9H6V8H7V7H8V6H7V5H6V4H5V3H4V2H3V1H2V0H1V1H0V2Z" 
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Галерея -->
                        <ScrollViewer 
                            Grid.Column="2"
                            x:Name="PART_GalleryScrollViewer" 
                            CanContentScroll="True"
                            IsTabStop="False"
                            HorizontalScrollBarVisibility="Hidden" 
                            VerticalScrollBarVisibility="Disabled"
                            Cursor="Hand">

                            <ItemsControl 
                                IsTabStop="False"
                                Background="Transparent"
                                x:Name="PART_GalleryItems"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                ItemTemplate="{TemplateBinding ItemTemplate}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
