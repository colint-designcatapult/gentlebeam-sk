[TEXT]
STATEMENT: >>>
.. raw:: html

    <pre class="mermaid">
    graph TD

      %% Top states
      Startup(["Startup"])
      Crash(["Crash<br/>disable HV<br/>disable emission<br/>set outputs to 0<br/>stop cooler/pumps<br/>stop indicators"])

      %% Core states
      Cold(["Cold<br/>disable HV<br/>disable emission<br/>outputs to 0<br/>stop cooling"])
      Conditioning(["Conditioning<br/>verify estops<br/>set heater<br/>start cooling<br/>hold stable target 15 min"])
      Warmup(["Warmup<br/>enable fast warmup<br/>set heater<br/>start cooling"])
      WarmupFault(["Warmup Fault<br/>heater = 0<br/>stop cooling"])

      Fault(["Fault<br/>disable HV<br/>disable emission<br/>shutdown outputs"])
      ColdFault(["Cold Fault<br/>disable HV<br/>outputs to 0"])

      %% Plan pipeline
      Primed[[Primed]]
      Staging[[Staging]]
      Staged[[Staged]]

      %% Execution pipeline
      HVPSCheck(["HVPS Check<br/>disable HV<br/>disable emission"])
      Setup(["Setup<br/>enable HV<br/>set KV / grid / coils"])
      Ready(["Ready<br/>emission disabled"])
      Launching(["Launching<br/>emission disabled"])
      Emission(["Emission<br/>emission enabled"])
      Termination(["Termination<br/>shutdown safely"])

      %% Discharge
      Discharge(["Discharge<br/>HV off<br/>outputs = 0"])

      %% Startup transitions
      Startup --> Cold
      Crash --> Cold

      %% Cold transitions
      Cold -->|PC CONDITION| Conditioning
      Cold -->|PC WARMUP| Warmup
      Cold -->|FAULT| ColdFault
      Cold -->|PC WIPE PLAN| Cold
      Cold -->|PC STOP| Cold

      %% Conditioning
      Conditioning -->|TARGET STABLE 15 MIN| Primed
      Conditioning -->|FAULT| WarmupFault

      %% Warmup
      Warmup -->|HVPS SP REACHED| Primed
      Warmup -->|FAULT| WarmupFault

      WarmupFault --> Cold

      %% Fault handling
      Fault --> Cold
      ColdFault --> Cold

      %% Plan handling
      Primed -->|PC NEW SESSION| Staging
      Staging -->|PC FINISH STAGE| Staged
      Staging -->|PC WIPE PLAN| Cold

      Staged -->|PC RELEASE PLAN| HVPSCheck

      %% HVPS / Setup
      HVPSCheck -->|Check done| Setup
      Setup -->|HVPS SP REACHED| Ready

      %% Ready → emission flow
      Ready -->|PC RELEASE POINT| Launching
      Launching -->|HVPS SP REACHED; non-QC or QC Active acknowledged| Emission

      %% Emission loop
      Emission -->|OP COMPLETE| Ready

      %% Stop / termination
      Ready -->|PC STOP| Termination
      Emission -->|PC STOP| Termination
      Launching -->|PC STOP| Termination

      Termination --> Cold

      %% Discharge path
      Ready -->|PC STANDBY| Discharge
      Discharge --> Cold

    </pre>
<<<

