[GRAMMAR]
ELEMENTS:
- TAG: SECTION
  PROPERTIES:
    IS_COMPOSITE: True
    PREFIX: None
    VIEW_STYLE: Narrative
  FIELDS:
  - TITLE: MID
    TYPE: String
    REQUIRED: False
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: PREFIX
    TYPE: String
    REQUIRED: False
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: False
- TAG: REQUIREMENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TYPE
    TYPE: MultipleChoice(Functional, Non-Functional, Safety, Interface, Performance, Usability, Cybersecurity, Regulatory, Data, Environment)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  RELATIONS:
  - TYPE: Parent
    ROLE: Refines
- TAG: DESIGN_ITEM
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  RELATIONS:
  - TYPE: Parent
    ROLE: Refines
- TAG: TEST_CASE
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: PREREQUISITES
    TYPE: String
    REQUIRED: False
  - TITLE: STEPS
    TYPE: String
    REQUIRED: True
  - TITLE: EXPECTED_BEHAVIOR
    TYPE: String
    REQUIRED: True
  RELATIONS:
  - TYPE: Parent
    ROLE: Verifies
- TAG: SFMEA
  PROPERTIES:
    VIEW_STYLE: Narrative
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: INITIAL_P
    TYPE: SingleChoice(1 - Improbable, 2 - Rarely, 3 - Probable, 4 - Very Likely, 5 - Highly Likely)
    REQUIRED: True
  - TITLE: INITIAL_S
    TYPE: SingleChoice(1 - Negligible, 2 - Minor, 3 - Major, 4 - Critical, 5 - Catastrophic)
    REQUIRED: True
  - TITLE: INITIAL_RI
    TYPE: String
    REQUIRED: True
  - TITLE: RESIDUAL_P
    TYPE: SingleChoice(1 - Improbable, 2 - Rarely, 3 - Probable, 4 - Very Likely, 5 - Highly Likely)
    REQUIRED: True
  - TITLE: RESIDUAL_S
    TYPE: SingleChoice(1 - Negligible, 2 - Minor, 3 - Major, 4 - Critical, 5 - Catastrophic)
    REQUIRED: True
  - TITLE: RESIDUAL_RI
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: FAILURE_MODE
    TYPE: String
    REQUIRED: True
  - TITLE: FORESEEABLE_SEQUENCE_OF_EVENTS
    TYPE: String
    REQUIRED: True
  - TITLE: EFFECT
    TYPE: String
    REQUIRED: True
  - TITLE: CAUSES
    TYPE: String
    REQUIRED: True
  - TITLE: RISK_CONTROLS
    TYPE: String
    REQUIRED: True
  RELATIONS:
  - TYPE: Parent
    ROLE: Refines
